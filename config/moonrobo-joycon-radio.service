[Unit]
Description=ELF Joy-Con Bluetooth compatibility settings
Wants=bluetooth.service
PartOf=bluetooth.service
Requires=sys-subsystem-bluetooth-devices-hci0.device
After=bluetooth.service sys-subsystem-bluetooth-devices-hci0.device

[Service]
Type=oneshot
ExecCondition=/usr/bin/grep -xqi 8087 /sys/bus/usb/devices/1-1.1/idVendor
ExecCondition=/usr/bin/grep -xqi 0029 /sys/bus/usb/devices/1-1.1/idProduct
ExecStart=/usr/bin/bluetoothctl power on
ExecStart=/usr/bin/bluetoothctl system-alias Nintendo-ELF-Neck
ExecStart=/usr/bin/hciconfig hci0 lp RSWITCH
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
