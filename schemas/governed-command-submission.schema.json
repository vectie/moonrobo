{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectie.github.io/schemas/moonrobo/governed-command-submission.v1.json",
  "title": "MoonRobo governed command submission",
  "type": "object",
  "required": [
    "contract_id",
    "adapter_id",
    "operation_id",
    "request_id",
    "attempt_id",
    "status",
    "physical_execution_performed",
    "output"
  ],
  "properties": {
    "contract_id": {"const": "moonrobo.governed-command-submission.v1"},
    "adapter_id": {"const": "moonrobo-local-v1"},
    "operation_id": {"const": "robot.command.submit-governed"},
    "request_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["succeeded", "failed"]},
    "physical_execution_performed": {"const": false},
    "output": {"type": "object"}
  }
}
