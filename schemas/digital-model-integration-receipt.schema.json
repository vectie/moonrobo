{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectie.github.io/schemas/moonrobo/digital-model-integration-receipt.v1.json",
  "title": "MoonRobo digital model integration receipt",
  "$ref": "#/$defs/receipt",
  "$defs": {
    "receipt": {
      "type": "object",
      "required": [
        "contract_id",
        "adapter_id",
        "operation_id",
        "request_id",
        "attempt_id",
        "idempotency_key",
        "status",
        "physical_execution_performed",
        "evidence_refs",
        "output"
      ],
      "properties": {
        "contract_id": {
          "const": "moonrobo.digital-model-integration-receipt.v1"
        },
        "adapter_id": {"const": "moonrobo-local-v1"},
        "operation_id": {"const": "robot.integrate-digital-model"},
        "request_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "idempotency_key": {"type": "string", "minLength": 1},
        "status": {"enum": ["succeeded", "failed"]},
        "physical_execution_performed": {"const": false},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "output": {"type": "object"}
      }
    }
  }
}
