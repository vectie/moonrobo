{
  "profile": "native-tensor-cpu-stream-checkpoint-gate",
  "scope": "storage-save-restore-correctness-only-small-network",
  "backend": "mujoco",
  "device": "cpu",
  "precision": "float32",
  "amp": "none",
  "reference_storage": "mmap",
  "observation_mode": "paper",
  "wm_hidden": [32, 32],
  "pi_hidden": [32, 16],
  "critic_hidden": [16, 8],
  "num_envs": 1,
  "wm_batch": 2,
  "pi_batch": 2,
  "buffer_steps": 64,
  "hist": 10,
  "goal_frames": 10,
  "horizon": 4,
  "wm_window": 2,
  "warmup_steps": 16,
  "wm_batches": 1,
  "wm_only_iters": 0,
  "critic_epochs": 1,
  "critic_minibatches": 4,
  "iterations": 1,
  "checkpoint_every": 1,
  "utd": 0.4,
  "lr": 0.0002,
  "gamma": 0.99,
  "lam": 0.95,
  "lr_decay_iters": 1000,
  "action_noise": 0.0,
  "observation_noise": false,
  "randomization": false,
  "physics_dt": 0.005,
  "self_collisions": false,
  "reset_noise": false,
  "context_resampling": "episode",
  "max_episode_steps": 500,
  "seed": 1
}
