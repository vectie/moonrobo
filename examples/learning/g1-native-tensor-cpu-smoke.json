{
  "profile": "native-tensor-linux-cpu-runtime-smoke",
  "backend": "mujoco",
  "device": "cpu",
  "precision": "float32",
  "amp": "none",
  "reference_storage": "mmap",
  "observation_mode": "paper",
  "wm_hidden": [4],
  "pi_hidden": [4],
  "critic_hidden": [4],
  "num_envs": 1,
  "wm_batch": 2,
  "pi_batch": 2,
  "buffer_steps": 8,
  "hist": 2,
  "goal_frames": 2,
  "horizon": 2,
  "wm_window": 2,
  "warmup_steps": 4,
  "wm_batches": 1,
  "wm_only_iters": 0,
  "critic_epochs": 1,
  "critic_minibatches": 1,
  "iterations": 1,
  "checkpoint_every": 1,
  "utd": 1.0,
  "lr": 0.0002,
  "gamma": 0.99,
  "lam": 0.95,
  "lr_decay_iters": 1000,
  "action_noise": 0.0,
  "observation_noise": false,
  "randomization": false,
  "physics_dt": 0.005,
  "self_collisions": true,
  "reset_noise": false,
  "context_resampling": "episode",
  "max_episode_steps": 500,
  "seed": 1
}
