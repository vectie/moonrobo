///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args() is [_, mode, rev] && ["prepare", "run"].contains(mode) && ["a", "b", "c", "d"].contains(rev) else { fail("prepare/run revision") }
  let out = "output/spark-runtime-20261024/actor-backward-boundaries-20261029-a"
  let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host = "wlc004s@192.168.2.179"
  let runner = "run_actor_gemm_"+rev+".mbtx"
  let adapter = "actor_gemm_"+rev+".py"
  if mode == "prepare" {
    let code = @fs.read_file(out+"/run_actor_loaded_a.mbtx").text()
      .replace_all(old="run_actor_loaded_a.mbtx",new=runner)
      .replace_all(old="actor_loaded_a.py",new=adapter)
    for (name, content) in [(runner,code),(adapter,@fs.read_file("providers/motion_learning/actor_backward_gemm_probe.py").text())] {
      @fs.write_file(out+"/"+name,content,create_mode=CreateNew)
      if name==runner { assert_eq(@process.run("moon",["check","--target","native",out+"/"+name]),0) }
      assert_eq(@process.run("scp",["-q","-o","ControlPath=/tmp/moonrobo-operator-179.sock",out+"/"+name,host+":"+base+"/"+name]),0)
    }
    return
  }
  let folder=out+"/gemm-"+rev
  @fs.mkdir(folder)
  let code=@process.run("ssh",["-S","/tmp/moonrobo-operator-179.sock",host,"env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native "+base+"/"+runner+" -- actor smc off 1 actor-gemm-"+rev+" bf16-full"],stdout=@process.redirect_to_file(folder+"/controller.stdout.log",create_mode=CreateNew),stderr=@process.redirect_to_file(folder+"/controller.stderr.log",create_mode=CreateNew))
  for name in ["result.json","progress.json","protocol.json","completion.json","compilation-audit.json","training-guard.json","training-docker-final.json","training.stdout.log","training.stderr.log"] {
    ignore(@process.run("scp",["-q","-o","ControlPath=/tmp/moonrobo-operator-179.sock",host+":/home/wlc004s/moonrobo/runs/hotspot-shared-actor-gemm-"+rev+"/"+name,folder+"/"+name]))
  }
  assert_eq(code,0)
}
