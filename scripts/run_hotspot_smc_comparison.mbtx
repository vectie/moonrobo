///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args() is [_, label] &&
    label.all(c => c is ('a'..<='z' | '0'..<='9' | '-')) else {
    fail("fresh label required")
  }
  let base = "/home/wlc004s/moonrobo/private/hotspot-smc4096-20261026-a"
  let tools = "/home/wlc004s/moonrobo/private/operator-diagnostic-20261025-a"
  let root = "/home/wlc004s/moonrobo/runs/native-hotspot-vs-smc512-" + label
  async fn run(name : String, script : String, args : Array[String]) -> Unit {
    println("Starting " + name)
    let status = @process.run(
      "/home/wlc004s/moonrobo/toolchain/bin/moon",
      ["run", "--target", "native", script, "--", ..args],
      stdout=@process.redirect_to_file(
        base + "/" + label + "-" + name + ".stdout.log",
        create_mode=CreateNew,
      ),
      stderr=@process.redirect_to_file(
        base + "/" + label + "-" + name + ".stderr.log",
        create_mode=CreateNew,
      ),
    )
    guard status == 0 else {
      fail(name + " failed; no implicit retry or threshold change")
    }
    println("Completed " + name)
  }
  let runner = tools + "/run_smc_microbatch_pairs.mbtx"
  run("prepare", runner, ["--prepare", base + "/spec.json", root])
  for i in 0..<4 {
    let index = i.to_string()
    run("run-" + index, runner, ["--run", root, index])
    for mode in ["advise", "advise-caches"] {
      run(mode + "-" + index, tools + "/advise_hotspot_run_cache.mbtx", [
        "--" + mode,
        base + "/" + label + "-" + mode + "-" + index + ".json",
        root + "/run-" + index,
      ])
    }
    run(
      "image-pages-" + index,
      tools + "/advise_closed_smc_image_pages_f.mbtx",
      ["--advise", "cache-combo-" + label + "-" + index + ".json"],
    )
  }
  run("summary", tools + "/summarize_smc_microbatch_pairs.mbtx", [
    root,
    root + "/summary.json",
  ])
  println("Complete accepted ABBA: " + root)
}
