import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/fs", "moonbitlang/async@0.20.2/process", "moonbitlang/core/env", "moonbitlang/core/json" }
let base="/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
let runs="/home/wlc004s/moonrobo/runs/hotspot-shared-"
let moon="/home/wlc004s/moonrobo/toolchain/bin/moon"
fn field(j : Json,k : String) -> Json raise {guard j is Object(m) && m.get(k) is Some(v) else {fail(k)};v}
async fn read(p : String) -> Json {@json.parse(@fs.read_file(p).text())}
fn label(phase : String,variant : String,kind : String) -> String {"primitives-struct-"+variant+"-"+phase+"-"+kind+(if (phase=="world"&&variant=="baseline"&&kind=="gate")||(phase=="actor"&&variant=="smc"&&kind=="off") {"-b"}else{"-a"})}
async fn release(name : String,suffix : String) -> Unit {
  guard @process.run(moon,["run","--target","native",base+"/advise_primitives_compiler.mbtx","--",name+"-"+suffix,name],stdout=@process.redirect_to_file(base+"/"+name+"-"+suffix+".cache.stdout.log",create_mode=CreateNew),stderr=@process.redirect_to_file(base+"/"+name+"-"+suffix+".cache.stderr.log",create_mode=CreateNew))==0 else {fail("closed output cache advice")}
  if name.contains("-smc-") {
    guard @process.run(moon,["run","--target","native","/home/wlc004s/moonrobo/private/operator-diagnostic-20261025-a/advise_structural_smc_large.mbtx","--","--advise",name+"-image.json"],stdout=@process.redirect_to_file(base+"/"+name+".image.stdout.log",create_mode=CreateNew),stderr=@process.redirect_to_file(base+"/"+name+".image.stderr.log",create_mode=CreateNew))==0 else{fail("closed SMC image page advice")}
  }
}
fn near(a : Json,b : Json) -> Bool {
  match (a,b) {
    (Number(x,..),Number(y,..)) => x==x && y==y && (x-y).abs()<=2.0e-6+2.0e-4*x.abs()
    (Array(a),Array(b)) => {if a.length()!=b.length(){return false};for i in 0..<a.length(){if !near(a[i],b[i]){return false}};true}
    _ => a==b
  }
}
async fn invoke(phase : String,variant : String,reps : String,name : String,observer~ : String="off",implementation~ : String="native") -> Unit {
  let driver=if variant.contains("fk") || name.contains("final") {"invoke_structural_b.mbtx"}else{"invoke_structural_a.mbtx"}
  guard @process.run(moon,["run","--target","native",base+"/"+driver,"--",phase,implementation,observer,reps,name,variant])==0 else {fail(name)}
  let code=field(read(base+"/"+name+".exit.json"),"exit_code")
  if implementation=="smc" && code==Json(1) {
    guard @fs.exists(runs+name+"/result.json")else{fail("SMC did not finish timing; startup failure preserved: "+name)}
    let r=read(runs+name+"/result.json");let g=read(runs+name+"/training-guard.json")
    guard field(r,"rows") is Array(rows) && rows.length()==13 && field(field(r,"numerical_comparison"),"passed")==Json(false) && field(g,"reason")==Json("completed") && field(g,"exit_code")==Json(1) && field(g,"error")==Json::null() else {fail("incomplete reference")}
    guard read(runs+name+"/training-docker-final.json") is [{"State":{"OOMKilled":False,"Running":False,"ExitCode":Number(1,..),..},..}] && @fs.read_file(runs+name+"/training.stderr.log").text().contains("AssertionError: fixed cross-language numerical limits failed; evidence retained") else {fail("unknown failed reference")}
    @fs.write_file(base+"/"+name+".timing-only.json",({"numeric_gate_passed":false,"timing_samples_completed":13,"training_exit_code":1,"usable_for_promotion":false}:Json).stringify(indent=2),create_mode=CreateNew)
    println("SMC numerical rejection retained; timing only "+name);return
  }
  guard code==Json(0) && field(read(runs+name+"/completion.json"),"passed")==Json(true) else {fail(name+" failed")}
}
async fn gate(phase : String,variant : String) -> Unit {
  let name=label(phase,variant,"gate");invoke(phase,variant,"1",name)
  if variant!="baseline" {
    let report=base+"/"+name+".numeric.json"
    let code=@process.run(moon,["run","--target","native",base+"/compare_top3_snapshots.mbtx","--",runs+label(phase,"baseline","gate"),runs+name,report],stdout=@process.redirect_to_file(base+"/"+name+".compare.stdout.log",create_mode=CreateNew),stderr=@process.redirect_to_file(base+"/"+name+".compare.stderr.log",create_mode=CreateNew))
    guard @fs.exists(report) else {fail("comparator failed "+code.to_string())}
    let r=read(report);println("GATE "+phase+" "+variant+" passed="+field(r,"passed").stringify()+" mismatches="+field(r,"mismatches").stringify())
    release(label(phase,"baseline","gate"),"after-"+variant)
  }
  release(name,"after-gate")
}
async fn main {
  guard @env.args() is [_,mode] else {fail("cpu|gates|pairs|events|smc")}
  if mode=="finish" {
    for stage in ["smc","final-events"] {guard @process.run(moon,["run","--target","native",base+"/structural_rotation_suite.mbtx","--",stage])==0 else{fail(stage)}}
    return
  }
  if mode=="finish-resume" {
    let name=label("actor","smc","off");invoke("actor","baseline","13",name,implementation="smc");release(name,"after-smc")
    guard @process.run(moon,["run","--target","native",base+"/structural_rotation_suite.mbtx","--","final-events"])==0 else{fail("final events")}
    return
  }
  if mode=="cpu" {
    let results=[]
    for (suite,n) in [("primitive",1),("geometry",2),("pivot",1),("constants",1),("config",8),("resume",1),("inference",1)] {
      let name="smc-primitives-"+suite+"-structural-cpu-a"
      guard field(read(base+"/"+name+".receipt.json"),"exit_code")==Json(0) else {fail("cpu exit")}
      let log=@fs.read_file(base+"/"+name+".stdout.log").text();guard !log.contains("SKIP") else {fail("CPU gate skipped")}
      let mut found=0
      for line in log.split("\n") {if line.has_prefix("{"){let j=@json.parse(line);if field(j,"type")==Json("result"){guard field(j,"message")==Json("") else{fail("CPU test failed: "+line.to_owned())};found+=1}}}
      guard found==n else {fail(name+" count "+found.to_string())};results.push({"suite":Json(suite),"passed_count":Json(n)})
    }
    @fs.write_file(base+"/structural-cpu-gates.json",Json(results).stringify(indent=2),create_mode=CreateNew);println(Json(results).stringify());return
  }
  guard @fs.exists(base+"/structural-cpu-gates.json") else {fail("CPU gate required")}
  if mode=="fk-gate" {guard @fs.exists(base+"/structural-cpu-gates-b.json")else{fail("B CPU gate required")};gate("actor","fk");return}
  if mode=="gates" {
    for (phase,variants) in [("world",["baseline","skew","structural"]),("actor",["baseline","axis","static","skew","structural"])] {for variant in variants {gate(phase,variant)}}
    return
  }
  if mode=="pairs" || mode=="fk-pair" {
    let factors=if mode=="fk-pair" {[("actor","fk")]}else{[("actor","axis"),("actor","static"),("world","skew"),("actor","skew"),("actor","structural"),("world","structural")]}
    for (phase,variant) in factors {
      if field(read(base+"/"+label(phase,variant,"gate")+".numeric.json"),"passed")!=Json(true) {println("NOT BENCHMARKED failed numerical gate: "+phase+" "+variant);continue}
      let name=label(phase,variant,"abba");invoke(phase,"abba-"+variant,"13",name)
      let r=read(runs+name+"/result.json")
      guard field(r,"observer")==Json("off") && field(r,"rows") is Array(rows) && rows.length()==52 else {fail("ABBA incomplete")}
      guard field(read(runs+label(phase,"baseline","gate")+"/result.json"),"rows") is Array([a]) && field(read(runs+label(phase,variant,"gate")+"/result.json"),"rows") is Array([b]) else {fail("gate metrics")}
      for i,row in rows {
        let block=i/13;let active=block==1 || block==2;let e=field(row,"execution")
        assert_eq(field(row,"abba_block"),Json(block));assert_eq(field(row,"abba_candidate"),Json(active));assert_eq(field(row,"steady"),Json(i%13>=3))
        guard near(field(if active{b}else{a},"metrics"),field(row,"metrics")) else {fail("restored metrics differ")}
        assert_eq(field(e,"native_cross_preserve_forward"),Json(true));assert_eq(field(e,"world_norm_snapshot"),Json(true));assert_eq(field(e,"detached_rotation_constants"),Json(true))
        for (key,factor) in [("compact_axis_rotation","axis"),("compact_skew","skew"),("static_fk_pruning","static")] {assert_eq(field(e,key),Json(active&&(variant==factor||variant=="structural"||(variant=="fk"&&factor!="skew"))))}
      }
      @fs.write_file(base+"/"+name+".block-validation.json",({"passed":true,"rows":52,"warmups_per_block":3,"measured_per_block":10,"restored_metrics_checked":true,"execution_flags_checked":true}:Json).stringify(),create_mode=CreateNew)
      release(name,"after-benchmark")
    }
    return
  }
  if mode=="final-events" {
    guard field(read(base+"/"+label("actor","fk","gate")+".numeric.json"),"passed")==Json(true)else{fail("FK numeric gate")}
    for variant in ["baseline","fk"] {let name=label("actor",variant,"final-events");invoke("actor",variant,"13",name,observer="events");release(name,"after-events")}
    for phase in ["world","actor"] {let name=label(phase,"smc","events");invoke(phase,"baseline","13",name,observer="events",implementation="smc");release(name,"after-events")}
    for variant in ["baseline","structural"] {let name=label("world",variant,"events");invoke("world",variant,"13",name,observer="events");release(name,"after-events")}
    return
  }
  if mode=="events" {
    for phase in ["world","actor"] {
      guard field(read(base+"/"+label(phase,"structural","gate")+".numeric.json"),"passed")==Json(true) else {fail("combined numeric gate")}
      for variant in ["baseline","structural"] {let name=label(phase,variant,"events");invoke(phase,variant,"13",name,observer="events");release(name,"after-events")}
      let name=label(phase,"smc","events");invoke(phase,"baseline","13",name,observer="events",implementation="smc");release(name,"after-events")
    }
    return
  }
  if mode=="smc" {
    for phase in ["world","actor"] {let name=label(phase,"smc","off");invoke(phase,"baseline","13",name,implementation="smc");release(name,"after-smc")}
    return
  }
  fail("unknown mode")
}
