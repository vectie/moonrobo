import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/fs", "moonbitlang/async@0.20.2/process" }
async fn main {
  let dir="output/spark-runtime-20261024/coefficient-full-20261028"
  let b="wlc004s@192.168.2.179:/home/wlc004s/moonrobo/private/shared-compute-20261026-a/"
  let prefix=["-o","ControlPath=/tmp/moonrobo-operator-179.sock"]
  let tests=@fs.read_file("src/learning_aligned_gpu/geometry/coefficient_full_wbtest.mbt").text()
  let helper=tests[:tests.find("///|\ntest ").unwrap()].to_owned()
  let p=dir+"/coefficient_full_fixture_a.mbt"
  if !@fs.read_file(p).text().contains("fn coefficient_full_edges") {
    let f=@fs.read_file(p).text().replace_all(old="  coefficient_edges(backend, 0)",new="  coefficient_edges(backend, 0)\n  coefficient_full_edges(backend, 0)")
    @fs.write_file(p,helper+"\n"+f)
  }
  let pkg="src/learning_aligned_gpu/geometry/moon.pkg"
  let s=@fs.read_file(pkg).text();guard s.contains("\"coefficient_assembly_wbtest.mbt\": [ \"native\" ],")else{fail("target")}
  if !s.contains("coefficient_full_wbtest.mbt") {
    @fs.write_file(pkg,s.replace_all(old="\"coefficient_assembly_wbtest.mbt\": [ \"native\" ],",new="\"coefficient_assembly_wbtest.mbt\": [ \"native\" ],\n    \"coefficient_full_wbtest.mbt\": [ \"native\" ],"))
  }
  for (from,to) in [(p,"coefficient_full_fixture_a.mbt"),(p,"workspace/moonrobo-coefficient-full-a/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt"),(pkg,"workspace/moonrobo-coefficient-full-a/"+pkg),("src/learning_aligned_gpu/geometry/coefficient_full_wbtest.mbt","workspace/moonrobo-coefficient-full-a/src/learning_aligned_gpu/geometry/coefficient_full_wbtest.mbt")] {guard @process.run("scp",[..prefix,from,b+to])==0else{fail(from)}}
}
