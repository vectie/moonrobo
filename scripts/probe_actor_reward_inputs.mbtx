///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args() is [_, mode, kind] &&
    ["prepare", "run"].contains(mode) &&
    ["reward", "normalizer", "gae", "optimizer"].contains(kind) else {
    fail("prepare/run reward/normalizer")
  }
  let out = "output/spark-runtime-20261024/actor-backward-boundaries-20261029-a"
  let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host = "wlc004s@192.168.2.179"
  let label = if kind == "reward" {
    "reward-inputs-a"
  } else if kind == "optimizer" {
    "critic-optimizer-ablation-a"
  } else if kind == "gae" {
    "gae-ablation-a"
  } else {
    "normalizer-ablation-a"
  }
  let adapter = if kind == "reward" {
    "actor_reward_input_ablation"
  } else if kind == "optimizer" {
    "actor_critic_optimizer_ablation"
  } else if kind == "gae" {
    "actor_gae_ablation"
  } else {
    "actor_normalizer_ablation"
  }
  let runner = "run_actor_" + label.replace_all(old="-", new="_") + ".mbtx"
  if mode == "prepare" {
    if kind == "optimizer" {
      let name = "actor_gae_ablation_b.py"
      @fs.write_file(
        out + "/" + name,
        @fs.read_file("providers/motion_learning/actor_gae_ablation.py"),
        create_mode=CreateNew,
      )
      assert_eq(
        @process.run("scp", [
          "-q",
          "-o",
          "ControlPath=/tmp/moonrobo-operator-179.sock",
          out + "/" + name,
          host + ":" + base + "/" + name,
        ]),
        0,
      )
    }
    let code = @fs.read_file(out + "/run_actor_reference_inputs_compare_a.mbtx")
      .text()
      .replace_all(old="run_actor_reference_inputs_compare_a.mbtx", new=runner)
      .replace_all(
        old="actor_reference_inputs_compare_a.py",
        new=adapter + "_a.py",
      )
      // No torch.compile is invoked: avoid copying unrelated compilation caches.
      .replace_all(
        old="if implementation==\"smc\" {for name in [\"inductor-cache\",\"triton-cache\"]",
        new="if false {for name in [\"inductor-cache\",\"triton-cache\"]",
      )
    for
      (name, content) in [
        (runner, code),
        (
          adapter + "_a.py",
          @fs.read_file("providers/motion_learning/" + adapter + ".py").text(),
        ),
      ] {
      @fs.write_file(out + "/" + name, content, create_mode=CreateNew)
      if name == runner {
        assert_eq(
          @process.run("moon", ["check", "--target", "native", out + "/" + name]),
          0,
        )
      }
      assert_eq(
        @process.run("scp", [
          "-q",
          "-o",
          "ControlPath=/tmp/moonrobo-operator-179.sock",
          out + "/" + name,
          host + ":" + base + "/" + name,
        ]),
        0,
      )
    }
    return
  }
  let folder = out + "/" + label
  @fs.mkdir(folder)
  let code = @process.run(
    "ssh",
    [
      "-S",
      "/tmp/moonrobo-operator-179.sock",
      host,
      "env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native " +
      base +
      "/" +
      runner +
      " -- actor smc off 1 actor-" +
      label +
      " bf16-full",
    ],
    stdout=@process.redirect_to_file(
      folder + "/controller.stdout.log",
      create_mode=CreateNew,
    ),
    stderr=@process.redirect_to_file(
      folder + "/controller.stderr.log",
      create_mode=CreateNew,
    ),
  )
  for
    name in [
      "result.json", "progress.json", "completion.json", "training-guard.json", "training-docker-final.json",
      "training.stdout.log", "training.stderr.log", "protocol.json",
    ] {
    ignore(
      @process.run("scp", [
        "-q",
        "-o",
        "ControlPath=/tmp/moonrobo-operator-179.sock",
        host +
        ":/home/wlc004s/moonrobo/runs/hotspot-shared-actor-" +
        label +
        "/" +
        name,
        folder + "/" + name,
      ]),
    )
  }
  assert_eq(code, 0)
}
