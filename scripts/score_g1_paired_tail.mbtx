///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/async@0.20.2/io",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn field(value : Json, key : String) -> Json raise {
  guard value is Object(fields) && fields.get(key) is Some(value) else {
    fail("missing field: " + key)
  }
  value
}

///|
fn array(value : Json) -> Array[Json] raise {
  guard value is Array(values) else { fail("expected array") }
  values
}

///|
async fn read(path : String) -> Json {
  @json.parse(@fs.read_file(path).text())
}

///|
async fn run(exe : String, args : Array[String]) -> String {
  let (code, out, err) = native_collect_output(exe, args)
  assert_eq(code, 0, msg=err.text() + out.text())
  out.text()
}

///|
async fn main {
  let args = @env.args()
  assert_eq(
    args.length(),
    6,
    msg="usage: score_g1_paired_tail.mbtx REPO STUDY INCOMING_RUN MOONDATA_ROOT SUMMARY_JSON",
  )
  let root = args[1]
  let study = args[2]
  let incoming : Array[Json] = []
  for seed in 0..<3 {
    let path = study + "/incoming-evaluation-seed-\{seed}"
    ignore(
      run(root + "/scripts/run_native_learning.mbtx", [
        study + "/provider-sources/policy.py",
        "evaluate",
        "--checkpoint",
        args[3] + "/policy/actor-seed-\{seed}.moon.json",
        "--scene",
        root + "/target/mujoco_menagerie/unitree_g1/scene_mjx.xml",
        "--config",
        study + "/paired-tail-on/config.json",
        "--experiment",
        root + "/examples/learning/g1-long-experiment.json",
        "--output",
        path,
      ]),
    )
    incoming.push(read(path + "/physics.json"))
  }
  let cells : Array[Json] = []
  for id in ["paired-tail-on", "paired-tail-off"] {
    let source = study + "/" + id
    let policy = read(source + "/policy/report.json")
    // Preserve all weights referenced by the inherited incoming fit report.
    for seed in 0..<3 {
      ignore(
        run("/bin/cp", [
          args[3] + "/fit/latest-dynamics-seed-\{seed}.moon.json",
          source + "/fit/latest-dynamics-seed-\{seed}.moon.json",
        ]),
      )
    }
    let imported = @json.parse(
      run(
        root +
        "/_build/native/debug/build/cmd/learning_experiment/learning_experiment.exe",
        [
          "import",
          args[4],
          source,
          id,
          @env.now().reinterpret_as_int64().to_string(),
        ],
      ),
    )
    assert_eq(field(imported, "physical_execution_allowed"), false)
    let payloads = array(field(imported, "payloads"))
    let rows : Array[Json] = []
    for result in array(field(policy, "runs")) {
      guard field(result, "seed") is Number(n, ..) else { fail("missing seed") }
      let seed = n.to_int()
      assert_eq(field(result, "critic_unchanged"), true)
      assert_eq(field(result, "dynamics_unchanged"), true)
      assert_eq(field(result, "reload_matches"), true)
      let history = array(field(result, "history"))
      assert_eq(
        history.map(h => field(h, "update")),
        ([0, 1, 5, 10, 20, 50, 100, 150, 200] : Array[Json]),
      )
      guard field(field(policy, "initial_dynamics_by_seed"), seed.to_string())
        is String(sha) else {
        fail("missing model digest")
      }
      let models = payloads.filter(p => {
        field(p, "relative_path") == Json("fit/dynamics-seed-\{seed}.moon.json")
      })
      assert_eq(models.length(), 1)
      assert_eq(
        field(field(models[0], "data_ref"), "checksum"),
        Json("sha256:" + sha),
      )
      let before = field(incoming[seed], "candidate")
      if field(result, "selected_update") == (0 : Json) {
        let current = field(
          read(source + "/policy/physics-seed-\{seed}.json"),
          "candidate",
        )
        let a = array(field(before, "trials"))
        let b = array(field(current, "trials"))
        assert_eq(a.length(), b.length())
        for i in 0..<a.length() {
          for
            key in [
              "case_id", "seed", "replay", "failed", "simulated_seconds", "joint_rmse_rad",
            ] {
            assert_eq(
              field(a[i], key),
              field(b[i], key),
              msg="update-zero actor differs: " + key,
            )
          }
        }
      }
      println(
        id +
        " seed \{seed}: incoming " +
        field(before, "summary").stringify() +
        "; selected " +
        field(result, "selected_update").stringify() +
        "; candidate " +
        field(result, "candidate").stringify(),
      )
      rows.push({
        "seed": Json(seed),
        "selected_update": field(result, "selected_update"),
        "incoming": field(before, "summary"),
        "candidate": field(result, "candidate"),
        "qualifies": field(result, "qualifies"),
        "training_seconds": field(result, "training_seconds"),
        "validation_history": Json(history),
        "critic_unchanged": true,
        "dynamics_unchanged": true,
        "model_payload": models[0],
      })
    }
    cells.push({
      "id": Json(id),
      "config": field(policy, "config"),
      "runs": Json(rows),
    })
  }
  let validation = @json.parse(
    run(root + "/_build/native/debug/build/cmd/moondata/moondata.exe", [
      "validate",
      args[4],
    ]),
  )
  assert_eq(field(validation, "status"), "passed")
  assert_eq(field(validation, "finding_count"), 0)
  @fs.write_file(
    args[5],
    (
      {
        "format": "moonrobo.g1-paired-tail-study.v1",
        "cells": Json(cells),
        "validation": validation,
        "physical_execution_allowed": false,
      } : Json).stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  println(
    "Both paired-tail methods registered; per-seed models, unchanged actors and MoonData integrity verified.",
  )
}

///|
/// Checkpoint copies are validated or converted by the reviewed native loader.
fn native_checkpoint_copy_command(
  exe : String,
  args : Array[String],
) -> (String, Array[String])? raise {
  if exe != "/bin/cp" || args.length() < 2 {
    return None
  }
  if !args[0].has_suffix(".moon.json") &&
    !args[0].has_suffix(".pt") &&
    !args[1].has_suffix(".moon.json") {
    return None
  }
  guard args.length() == 2 && args[1].has_suffix(".moon.json") else {
    fail("checkpoint copies require SOURCE and native .moon.json DESTINATION")
  }
  let name = args[0].split("/").last().unwrap_or("").to_owned()
  let kind = if name.contains("dynamics-seed-") {
    "residual-dynamics"
  } else if name.contains("actor-seed-") {
    "g1-actor"
  } else {
    fail("unreviewed checkpoint copy kind: " + name)
  }
  let root = @env.args()[1]
  Some(
    (
      root,
      [
        "run",
        root + "/scripts/run_native_learning.mbtx",
        root,
        "src/learning_training/launch/cmd",
        "checkpoint-copy",
        args[0],
        args[1],
        kind,
      ],
    ),
  )
}

///|
/// Structured native dispatch. A .py argument is a reviewed provider descriptor, never an executable or an interpreter fallback.
async fn native_collect_output(
  exe : String,
  args : Array[String],
) -> (Int32, &@io.Data, &@io.Data) {
  let suffix = "/scripts/run_native_learning.mbtx"
  if exe.has_suffix(suffix) {
    let root = exe[:exe.length() - suffix.length()].to_owned()
    let command = ["run", exe, root, "src/learning_training/launch/cmd"]
    command.append(args)
    return @process.collect_output("moon", command, cwd=root)
  }
  if native_checkpoint_copy_command(exe, args) is Some((root, command)) {
    return @process.collect_output("moon", command, cwd=root)
  }
  @process.collect_output(exe, args)
}

///|
async fn native_process_run(
  exe : String,
  args : Array[String],
  stdout? : &@process.ProcessOutput,
  stderr? : &@process.ProcessOutput,
) -> Int32 {
  let suffix = "/scripts/run_native_learning.mbtx"
  if exe.has_suffix(suffix) {
    let root = exe[:exe.length() - suffix.length()].to_owned()
    let command = ["run", exe, root, "src/learning_training/launch/cmd"]
    command.append(args)
    return @process.run("moon", command, cwd=root, stdout?, stderr?)
  }
  if native_checkpoint_copy_command(exe, args) is Some((root, command)) {
    return @process.run("moon", command, cwd=root, stdout?, stderr?)
  }
  @process.run(exe, args, stdout?, stderr?)
}
