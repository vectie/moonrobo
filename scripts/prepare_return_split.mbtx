import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/fs" }
async fn edit(p : String, xs : Array[(String,String)]) -> Unit {let mut s=@fs.read_file(p).text();for(a,b)in xs{guard s.contains(a)else{fail(p+": "+a)};s=s.replace_all(old=a,new=b)};@fs.write_file(p,s)}
async fn main {
  let root="src/learning_aligned_gpu/"
  edit(root+"execution_optimizations.mbt",[("  split_so3_coefficients : Bool","  split_so3_coefficients : Bool\n  split_actor_return : Bool"),("    split_so3_coefficients: false,","    split_so3_coefficients: false,\n    split_actor_return: false,")])
  edit(root+"cmd/optimizations.mbt",[("    split_so3_coefficients: setting(config, \"split_so3_coefficients\", false),","    split_so3_coefficients: setting(config, \"split_so3_coefficients\", false),\n    split_actor_return: setting(config, \"split_actor_return\", false),"),("  if s.optimizations.split_world_delta {","  if s.optimizations.split_actor_return { values[\"execution_split_actor_return\"] = 33554432L }\n  if s.optimizations.split_world_delta {")])
  edit(root+"learning.mbt",[("  if optimizations.split_world_delta {","  if optimizations.split_actor_return {\n    guard backend.has_split_sections() && !optimizations.smc_actor_return && config.horizon > 0 && config.horizon <= 64 else { fail(\"return split requires native split, original sequential return, H<=64\") }\n  }\n  if optimizations.split_world_delta {")])
  for f in ["learning.mbt","actor_microbatch.mbt"] {
    edit(root+f,[("  let weighted = []\n  for t in 0..<(if self.optimizations.smc_actor_return", "  let weighted = []\n  // Same chronological recurrence and discount arithmetic. One split per\n  // sequence avoids H independent full-size scatter/add backward paths.\n  let reward_parts = if self.optimizations.split_actor_return { Some(rewards.split_sections(Array::make(c.horizon, 1), axis=0)) } else { None }\n  let failure_parts = if self.optimizations.split_actor_return { Some(failures.split_sections(Array::make(c.horizon, 1), axis=0)) } else { None }\n  for t in 0..<(if self.optimizations.smc_actor_return"),("    let reward = rewards.narrow(0, t, 1).reshape([n])", "    let reward = (match reward_parts { Some(parts) => parts[t]; None => rewards.narrow(0, t, 1) }).reshape([n])"),("      failures.narrow(0, t, 1).reshape([n]).affine(-1.0, bias=1.0),", "      (match failure_parts { Some(parts) => parts[t]; None => failures.narrow(0, t, 1) }).reshape([n]).affine(-1.0, bias=1.0),")])
  }
  edit(root+"cmd/optimizations_wbtest.mbt",[("  assert_false(execution_optimizations({}).split_so3_coefficients)","  assert_false(execution_optimizations({}).split_so3_coefficients)\n  assert_false(execution_optimizations({}).split_actor_return)\n  assert_true(execution_optimizations({\"split_actor_return\":true}).split_actor_return)"),("    { \"split_so3_coefficients\": \"true\" },","    { \"split_so3_coefficients\": \"true\" },\n    { \"split_actor_return\": \"true\" },")])
}
