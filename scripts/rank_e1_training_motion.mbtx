///|
import {
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
}

///|
struct Entry {
  id : String
  file : String
  sha256 : String
  fps : Double
  split : String
} derive(FromJson)

///|
struct Profile {
  id : String
  joints : Array[String]
} derive(FromJson)

///|
struct Dataset {
  format : String
  robot : Profile
  entries : Array[Entry]
} derive(FromJson)

///|
struct Score {
  id : String
  file : String
  split : String
  frames : Int32
  maximum_leg_excursion_deg : Double
  maximum_leg_step_deg : Double
  maximum_joint_excursion_deg : Double
  root_travel_m : Double
  initial_q_rad : Array[Double]
  maximum_leg_from_live_deg : Double
  maximum_initial_leg_transition_deg : Double
} derive(ToJson)

///|
struct Motor {
  motor_id : Int32
  pos : Double
  error : Int32
} derive(FromJson)

///|
struct Live {
  last_motors : Array[Motor]
} derive(FromJson)

///|
async fn main {
  guard @env.args()[1:] is [directory, status, output] else {
    fail("usage: rank DATASET LIVE_STATUS NEW_REPORT")
  }
  let dataset : Dataset = @json.from_json(
    @fs.read_file(directory + "/dataset.json").json(),
  )
  guard dataset.format == "moonrobo.e1-dataset.v1" &&
    dataset.robot.id == "noetix-e1-23-lab-v1" &&
    dataset.robot.joints.length() == 23 else {
    fail("expected selected E1 dataset")
  }
  let live : Live = @json.from_json(@fs.read_file(status).json())
  guard live.last_motors.length() == 24 else { fail("incomplete live status") }
  for i, motor in live.last_motors {
    assert_eq(motor.motor_id, i)
    assert_eq(motor.error, 0)
  }
  let slots = [
    5, 6, 7, 8, 9, 10, 16, 17, 18, 19, 20, 21, 22, 0, 1, 2, 3, 4, 11, 12, 13, 14,
    15,
  ]
  let current = slots.map(i => live.last_motors[i].pos)
  let legs = dataset.robot.joints.map(j => j.contains("_leg_"))
  let scores : Array[Score] = []
  for entry in dataset.entries {
    guard !entry.file.contains("..") &&
      !entry.file.has_prefix("/") &&
      entry.fps == 50.0 else {
      fail("unsafe motion entry")
    }
    let bytes = @fs.read_file(directory + "/" + entry.file).binary()
    let mut sha = ""
    for byte in @crypto.sha256(bytes) {
      sha += byte.to_hex()
    }
    assert_eq(sha, entry.sha256)
    let rows : Array[Array[Double]] = @json.from_json(
      @fs.read_file(directory + "/" + entry.file).json(),
    )
    guard rows.length() > 1 &&
      rows.all(row => {
        row.length() == 36 &&
        row.all(x => x - x == 0.0) &&
        row[30:].iter().all(x => x == 0.0)
      }) else {
      fail("invalid physical embedding")
    }
    let initial = rows[0][7:30].to_owned()
    let minimum = initial.copy()
    let maximum = initial.copy()
    let previous = initial.copy()
    let mut step = 0.0
    let mut travel = 0.0
    let mut from_live = 0.0
    let mut initial_delta = 0.0
    for row in rows {
      let mut squared = 0.0
      for j in 0..<3 {
        let d = row[j] - rows[0][j]
        squared += d * d
      }
      travel = travel.max(squared.sqrt())
      for j in 0..<23 {
        let q = row[7 + j]
        minimum[j] = minimum[j].min(q)
        maximum[j] = maximum[j].max(q)
        if legs[j] {
          step = step.max((q - previous[j]).abs())
        }
        if legs[j] {
          from_live = from_live.max((q - current[j]).abs())
        }
        previous[j] = q
      }
    }
    let mut leg = 0.0
    let mut all = 0.0
    for j in 0..<23 {
      let range = maximum[j] - minimum[j]
      all = all.max(range)
      if legs[j] {
        leg = leg.max(range)
        initial_delta = initial_delta.max((initial[j] - current[j]).abs())
      }
    }
    scores.push({
      id: entry.id,
      file: entry.file,
      split: entry.split,
      frames: rows.length(),
      maximum_leg_excursion_deg: leg * 57.29577951308232,
      maximum_leg_step_deg: step * 57.29577951308232,
      maximum_joint_excursion_deg: all * 57.29577951308232,
      root_travel_m: travel,
      initial_q_rad: initial,
      maximum_leg_from_live_deg: from_live * 57.29577951308232,
      maximum_initial_leg_transition_deg: initial_delta * 57.29577951308232,
    })
  }
  scores.sort_by((a, b) => {
    a.maximum_leg_excursion_deg.compare(b.maximum_leg_excursion_deg)
  })
  let within_clip = scores.copy()
  println("Smallest within-clip leg excursion:")
  println(Json(scores[0]).stringify(indent=2))
  scores.sort_by((a, b) => {
    a.maximum_leg_from_live_deg.compare(b.maximum_leg_from_live_deg)
  })
  let report : Json = {
    "format": "moonrobo.e1-minimum-reference-ranking.v1",
    "scope": "hash-verified training references compared with live status using candidate +1/zero-0 joint calibration; actor behavior and physical execution not inferred",
    "profile": dataset.robot.id,
    "within_clip_criterion": "minimum maximum per-leg-joint peak-to-peak excursion over the full clip",
    "from_live_criterion": "minimum maximum absolute per-leg-joint reference displacement from the captured live pose, including entry",
    "clips_ranked_within_clip": Json(within_clip),
    "clips_ranked_from_live": Json(scores),
  }
  @fs.write_file(output, report.stringify(indent=2), create_mode=CreateNew)
  println("Smallest full-clip leg displacement from the current pose:")
  println(Json(scores[:3].to_owned()).stringify(indent=2))
}
