///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
}

///|
async fn run(cmd : String, args : Array[String]) -> Unit {
  guard @process.run(cmd, args) == 0 else { fail(cmd + " failed") }
}

///|
fn replace(text : String, old : String, next : String) -> String raise {
  guard text.contains(old) else { fail("missing replacement: " + old) }
  text.replace_all(old~, new=next)
}

///|
async fn main {
  let repo = "/Users/kq/Workspace/moonrobo"
  let previous = repo +
    "/output/spark-runtime-20261024/layernorm-full-retest-20261026"
  let output = repo + "/output/spark-runtime-20261024/top3-frequency-20261026"
  guard !@fs.exists(output) else { fail("fresh output required") }
  @fs.mkdir(output)
  let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host = "wlc004s@192.168.2.179"
  let socket = "/tmp/moonrobo-operator-179.sock"
  let mut fixture = @fs.read_file(previous + "/full_ln_fixture_a.mbt").text()
  fixture = replace(
    fixture, "    actor_microbatch=512,", "    actor_microbatch=if @env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"actor1024\") { 1024 } else { 512 },",
  )
  fixture = replace(
    fixture, "      reuse_geometry: true,", "      world_error_batched: @env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"world-batched\"),\n      actor_norm_snapshot: @env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"norm-snapshot\"),\n      reuse_geometry: true,",
  )
  @fs.write_file(output + "/top3_fixture_a.mbt", fixture, create_mode=CreateNew)
  let mut builder = @fs.read_file(previous + "/build_full_ln_a.mbtx").text()
  builder = replace(builder, "moonrobo-full-ln-a", "moonrobo-top3-a")
  builder = replace(builder, "full-ln-gate-a", "top3-gate-a")
  builder = replace(builder, "full-ln-tensor-a", "top3-tensor-a")
  builder = replace(builder, "full-ln-runtime-a", "top3-runtime-a")
  builder = replace(
    builder, "  let ws = base + \"/workspace\"", "  let ws = base + \"/workspace\"\n  if mode == \"top3-tests-a\" {\n    container(\"top3-world-cpu-a\", \"/workspace/moonrobo-top3-a/_build/native/release/test/vectie/moonrobo/src/learning_aligned_gpu/learning_aligned_gpu.whitebox_test.exe\", [\"world_error_batched_wbtest.mbt:0-1\"])\n    container(\"top3-config-cpu-a\", \"/build/top3-gate-a\", [\"optimizations_wbtest.mbt:0-4\"])\n    return\n  }",
  )
  @fs.write_file(output + "/build_top3_a.mbtx", builder, create_mode=CreateNew)
  let mut driver = @fs.read_file(previous + "/run_full_ln_shared_a.mbtx").text()
  driver = replace(
    driver, "repetitions, label]", "repetitions, label, variant]",
  )
  driver = replace(
    driver, "  let collector =", "  guard [\"baseline\", \"actor1024\", \"world-batched\", \"norm-snapshot\"].contains(variant) else { fail(\"unknown top3 variant\") }\n  let collector =",
  )
  driver = replace(
    driver, "  e[\"MOONROBO_SHARED_MODE\"]", "  e[\"MOONROBO_TOP3_VARIANT\"] = Json(variant)\n  e[\"MOONROBO_SHARED_MODE\"]",
  )
  for
    (old, next) in [
      ("full-ln-gate-a", "top3-gate-a"),
      ("run_full_ln_shared_a.mbtx", "run_top3_shared_a.mbtx"),
      ("full_ln_fixture_a.mbt", "top3_fixture_a.mbt"),
      ("build_full_ln_a.mbtx", "build_top3_a.mbtx"),
    ] {
    driver = replace(driver, old, next)
  }
  @fs.write_file(
    output + "/run_top3_shared_a.mbtx",
    driver,
    create_mode=CreateNew,
  )
  for
    name in [
      "top3_fixture_a.mbt", "build_top3_a.mbtx", "run_top3_shared_a.mbtx",
    ] {
    run("scp", [
      "-o",
      "ControlPath=" + socket,
      output + "/" + name,
      host + ":" + base + "/" + name,
    ])
  }
  run("ssh", [
    "-S",
    socket,
    host,
    "test ! -e " + base + "/workspace/moonrobo-top3-a",
  ])
  run("ssh", [
    "-S",
    socket,
    host,
    "cp -a --reflink=auto " +
    base +
    "/workspace/moonrobo-full-ln-a " +
    base +
    "/workspace/moonrobo-top3-a",
  ])
  for
    path in [
      "execution_optimizations.mbt", "learning.mbt", "microbatch.mbt", "world_error_batched.mbt",
      "world_error_batched_wbtest.mbt", "cmd/optimizations.mbt", "cmd/optimizations_wbtest.mbt",
      "cmd/inference.mbt",
    ] {
    run("scp", [
      "-o",
      "ControlPath=" + socket,
      repo + "/src/learning_aligned_gpu/" + path,
      host +
      ":" +
      base +
      "/workspace/moonrobo-top3-a/src/learning_aligned_gpu/" +
      path,
    ])
  }
  run("ssh", [
    "-S",
    socket,
    host,
    "cp " +
    base +
    "/top3_fixture_a.mbt " +
    base +
    "/workspace/moonrobo-top3-a/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt",
  ])
  run("ssh", [
    "-S",
    socket,
    host,
    "env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native " +
    base +
    "/build_top3_a.mbtx -- gate-build-top3-a",
  ])
  run("ssh", [
    "-S",
    socket,
    host,
    "env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native " +
    base +
    "/build_top3_a.mbtx -- top3-tests-a",
  ])
}
