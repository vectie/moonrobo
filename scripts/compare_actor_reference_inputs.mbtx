///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args() is [_, mode, rev] &&
    ["prepare", "run"].contains(mode) &&
    ["a", "b"].contains(rev) else {
    fail("prepare/run")
  }
  let out = "output/spark-runtime-20261024/actor-backward-boundaries-20261029-a"
  let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host = "wlc004s@192.168.2.179"
  let runner = "run_actor_reference_inputs_compare_" + rev + ".mbtx"
  if mode == "prepare" {
    let code = @fs.read_file(out + "/run_actor_head_compare_c.mbtx")
      .text()
      .replace_all(old="run_actor_head_compare_c.mbtx", new=runner)
      .replace_all(
        old="actor_head_compare_c.py",
        new="actor_reference_inputs_compare_a.py",
      )
    for
      (name, content) in [
        (runner, code),
        (
          "actor_reference_inputs_compare_a.py",
          @fs.read_file(
            "providers/motion_learning/actor_reference_inputs_compare.py",
          ).text(),
        ),
      ] {
      let name = name.replace_all(
        old="inputs_compare_a",
        new="inputs_compare_" + rev,
      )
      let content = content
        .replace_all(old="inputs_compare_a", new="inputs_compare_" + rev)
        .replace_all(old="reference-inputs-a", new="reference-inputs-" + rev)
      @fs.write_file(out + "/" + name, content, create_mode=CreateNew)
      if name == runner {
        assert_eq(
          @process.run("moon", ["check", "--target", "native", out + "/" + name]),
          0,
        )
      }
      assert_eq(
        @process.run("scp", [
          "-q",
          "-o",
          "ControlPath=/tmp/moonrobo-operator-179.sock",
          out + "/" + name,
          host + ":" + base + "/" + name,
        ]),
        0,
      )
    }
    return
  }
  let folder = out + "/reference-inputs-compare-" + rev
  @fs.mkdir(folder)
  let code = @process.run(
    "ssh",
    [
      "-S",
      "/tmp/moonrobo-operator-179.sock",
      host,
      "env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native " +
      base +
      "/" +
      runner +
      " -- actor smc off 1 actor-reference-inputs-compare-" +
      rev +
      " bf16-full",
    ],
    stdout=@process.redirect_to_file(
      folder + "/controller.stdout.log",
      create_mode=CreateNew,
    ),
    stderr=@process.redirect_to_file(
      folder + "/controller.stderr.log",
      create_mode=CreateNew,
    ),
  )
  for
    name in [
      "result.json", "completion.json", "training-guard.json", "training-docker-final.json",
      "training.stdout.log", "training.stderr.log", "protocol.json",
    ] {
    ignore(
      @process.run("scp", [
        "-q",
        "-o",
        "ControlPath=/tmp/moonrobo-operator-179.sock",
        host +
        ":/home/wlc004s/moonrobo/runs/hotspot-shared-actor-reference-inputs-compare-" +
        rev +
        "/" +
        name,
        folder + "/" + name,
      ]),
    )
  }
  assert_eq(code, 0)
}
