///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/crypto",
}

///|
/// File-only migration. Does not execute any experiment or exporter.
fn reroute(text : String) -> String raise {
  let token = "root + \"/target/learning-venv/bin/python\","
  let chunks = text.split(token).to_array()
  if chunks.length() == 1 {
    return text
  }
  let mut result = chunks[0].to_owned()
  for chunk in chunks[1:] {
    let part = chunk.to_owned()
    let mut start = 0
    while start < part.length() &&
          (part[start] == '\n' || part[start] == ' ' || part[start] == '\r') {
      start += 1
    }
    let mut end = start
    if part[start] == '[' {
      let mut depth = 0
      let mut quoted = false
      let mut escaped = false
      for i = start; i < part.length(); i = i + 1 {
        let c = part[i]
        if quoted {
          if escaped {
            escaped = false
          } else if c == '\\' {
            escaped = true
          } else if c == '"' {
            quoted = false
          }
        } else if c == '"' {
          quoted = true
        } else if c == '[' {
          depth += 1
        } else if c == ']' {
          depth -= 1
          if depth == 0 {
            end = i + 1
            break
          }
        }
      }
      guard end > start else { fail("unterminated process argument") }
    } else {
      while end < part.length() && part[end] != ',' {
        end += 1
      }
    }
    result += "\"moon\"," +
      part[:start].to_owned() +
      "native_command(root, " +
      part[start:end].to_owned() +
      ")" +
      part[end:].to_owned()
  }
  let helper =
    #|
    #|///|
    #|fn native_command(root : String, original : Array[String]) -> Array[String] {
    #|  let command = ["-C", root, "run", "--quiet", "--warn-list", "-a", "--target", "native", "cmd/reference_scripts", "--", root]
    #|  command.append(original)
    #|  command
    #|}
    #|
  result + helper
}

///|
async fn main {
  if @fs.exists("docs/PYTHON_DEPENDENCIES.json") {
    fail(
      "One-off source migration is already audited; do not rerun its rewrite recipe",
    )
  }
  let folder = "scripts/python_reference"
  if !@fs.exists(folder) {
    @fs.mkdir(folder, recursive=true)
  }
  let entries : Array[Json] = []
  for name in @fs.readdir("scripts", sort=true) {
    if !name.has_suffix(".mbtx") ||
      !(name.contains("reference") || name.contains("aligned")) ||
      name == "migrate_reference_launchers.mbtx" {
      continue
    }
    let path = "scripts/" + name
    let bytes = @fs.read_file(path).binary()
    let destination = folder + "/" + name
    guard !@fs.exists(destination) else {
      fail("refuse to overwrite original " + destination)
    }
    @fs.write_file(destination, bytes, create_mode=CreateOrTruncate)
    let mut digest = ""
    for byte in @crypto.sha256(bytes) {
      digest += byte.to_hex()
    }
    entries.push({
      "script": Json(name),
      "sha256": Json(digest),
      "legacy_entry": Json(destination),
    })
    if name != "run_g1_aligned.mbtx" && name != "register_g1_aligned.mbtx" {
      let original = @fs.read_file(path).text()
      let migrated = reroute(original)
      if migrated != original {
        @fs.write_file(path, migrated, create_mode=CreateOrTruncate)
      }
    }
  }
  @fs.write_file(
    folder + "/reference-aligned-sources.json",
    Json(entries).stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  println(
    "Preserved \{entries.length()} original entrypoints; rewrote native dispatch only; no learning operation executed",
  )
}
