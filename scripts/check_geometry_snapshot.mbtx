///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args() is [_, revision] &&
    ["k", "l", "o", "r", "r2"].contains(revision) else {
    fail("fixed candidate")
  }
  let out = "output/spark-runtime-20261024/geometry-math-20261029-a"
  let root = out + "/geometry-math-snapshot-gate-" + revision
  @fs.mkdir(root)
  let label = "geometry-math-snapshot-gate-" + revision
  let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let status = @process.run(
    "ssh",
    [
      "-S",
      "/tmp/moonrobo-math-179.sock",
      "wlc004s@192.168.2.179",
      "env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native " +
      base +
      "/run_geometry_snapshot_gate_" +
      (if revision == "r2" {
        "r"
      } else if revision == "o" || revision == "r" {
        revision
      } else {
        "k"
      }) +
      ".mbtx -- " +
      label +
      " hotspot-shared-geometry-math-native-gate-" +
      revision,
    ],
    stdout=@process.redirect_to_file(
      root + "/controller.stdout.log",
      create_mode=CreateNew,
    ),
    stderr=@process.redirect_to_file(
      root + "/controller.stderr.log",
      create_mode=CreateNew,
    ),
  )
  for
    name in [
      "result.json", "completion.json", "training.stdout.log", "training.stderr.log",
    ] {
    ignore(
      @process.run("scp", [
        "-q",
        "-o",
        "ControlPath=/tmp/moonrobo-math-179.sock",
        "wlc004s@192.168.2.179:/home/wlc004s/moonrobo/runs/hotspot-shared-" +
        label +
        "/" +
        name,
        root + "/" + name,
      ]),
    )
  }
  assert_eq(status, 0)
}
