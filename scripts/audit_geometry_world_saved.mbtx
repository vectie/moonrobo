///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
}

///|
async fn main {
  let out = "output/spark-runtime-20261024/geometry-math-20261029-a"
  let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host = "wlc004s@192.168.2.179"
  let socket = "/tmp/moonrobo-math-179.sock"
  let extra =
    #|saved=[]
    #|        with torch.autograd.graph.saved_tensors_hooks(lambda t: saved.append(t) or t, lambda t:t):
    #|            control=probe.rollout(batch['s'],batch['actions'],batch['xi'])
    #|        import ast
    #|        def names(path):
    #|            f=next(n for n in ast.walk(ast.parse(path.read_text())) if isinstance(n,ast.FunctionDef) and n.name=='forward')
    #|            return [a.arg for a in f.args.args if a.arg!='self']
    #|        src=Path('/workspace/moonrobo/runs/hotspot-mlp-geometry-world-boundary-capture-a/compile-debug/torchinductor/model__0_backward_7.3')
    #|        control_names=names(src/'fx_graph_readable.py')[:-6]
    #|        native_names=names(root/'rollout/backward.fx.txt')[:-6]
    #|        rename={'primals_6':'primals_8','primals_7':'primals_9','primals_10':'primals_12','primals_11':'primals_13','primals_14':'primals_16','primals_15':'primals_17','primals_19':'primals_5','primals_21':'primals_20'}
    #|        assert len(saved)==len(control_names)==len(native[6:])
    #|        by_name=dict(zip(control_names,saved))
    #|        for name,t in zip(native_names,native[6:]):
    #|            other=by_name[rename.get(name,name)]
    #|            compare('saved-'+name,t,other)
    #|            rows[-1].update(native_stride=list(t.stride()),control_stride=list(other.stride()),native_alignment=t.data_ptr()%256,control_alignment=other.data_ptr()%256)
  let adapter = @fs.read_file(out + "/geometry_world_backward_check_b.py")
    .text()
    .replace_all(
      old="control=probe.rollout(batch['s'],batch['actions'],batch['xi'])",
      new=extra,
    )
  let runner = @fs.read_file(out + "/run_geometry_world_backward_check_b.mbtx")
    .text()
    .replace_all(
      old="geometry_world_backward_check_b.py",
      new="geometry_world_saved_a.py",
    )
    .replace_all(
      old="run_geometry_world_backward_check_b.mbtx",
      new="run_geometry_world_saved_a.mbtx",
    )
  for
    (name, content) in [
      ("geometry_world_saved_a.py", adapter),
      ("run_geometry_world_saved_a.mbtx", runner),
    ] {
    @fs.write_file(out + "/" + name, content, create_mode=CreateNew)
    assert_eq(
      @process.run("scp", [
        "-q",
        "-o",
        "ControlPath=" + socket,
        out + "/" + name,
        host + ":" + base + "/" + name,
      ]),
      0,
    )
  }
  let folder = out + "/world-saved-a"
  @fs.mkdir(folder)
  let status = @process.run(
    "ssh",
    [
      "-S",
      socket,
      host,
      "env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native " +
      base +
      "/run_geometry_world_saved_a.mbtx -- world geometry-world-saved-a",
    ],
    stdout=@process.redirect_to_file(
      folder + "/controller.stdout.log",
      create_mode=CreateNew,
    ),
    stderr=@process.redirect_to_file(
      folder + "/controller.stderr.log",
      create_mode=CreateNew,
    ),
  )
  for
    name in [
      "result.json", "training.stdout.log", "training.stderr.log", "training-guard.json",
      "completion.json",
    ] {
    ignore(
      @process.run("scp", [
        "-q",
        "-o",
        "ControlPath=" + socket,
        host +
        ":/home/wlc004s/moonrobo/runs/hotspot-mlp-geometry-world-saved-a/" +
        name,
        folder + "/" + name,
      ]),
    )
  }
  assert_eq(status, 0)
}
