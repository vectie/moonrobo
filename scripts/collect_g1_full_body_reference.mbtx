///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let args = @env.args()
  assert_eq(
    args.length(),
    5,
    msg="usage: collect_g1_full_body_reference.mbtx REPO COLLECTION_JSON TEACHER_STUDY OUTPUT",
  )
  let root = args[1]
  let output = args[4]
  assert_false(@fs.exists(output))
  @fs.mkdir(output + "/provider-sources", recursive=true)
  for
    name in [
      "full_body_reference.py", "full_body_reference_study.py", "cpu_physics.py",
    ] {
    @fs.write_file(
      output + "/provider-sources/" + name,
      @fs.read_file(root + "/providers/motion_learning/" + name).binary(),
      create_mode=CreateOrTruncate,
    )
  }
  // Optional historical evidence; the native study separately requires and
  // verifies teacher.json against the actual native teacher provider SHA.
  if @fs.exists(args[3] + "/provider-sources/teacher_feedback.py") {
    @fs.write_file(
      output + "/provider-sources/teacher_feedback.py",
      @fs.read_file(args[3] + "/provider-sources/teacher_feedback.py").binary(),
      create_mode=CreateOrTruncate,
    )
  }
  for
    (source, name) in [
      (root + "/examples/learning/g1-full-body-reference.json", "config.json"),
      (args[2], "collection.json"),
    ] {
    @fs.write_file(
      output + "/" + name,
      @fs.read_file(source).binary(),
      create_mode=CreateOrTruncate,
    )
  }
  @fs.write_file(
    output + "/charter.json",
    (
      {
        "format": "moonrobo.g1-full-body-reference-charter.v1",
        "config": @json.parse(@fs.read_file(output + "/config.json").text()),
        "collection_source": Json(args[2]),
        "teacher_study": Json(args[3]),
        "physical_execution_allowed": false,
      } : Json).stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  assert_eq(
    @process.run(
      "moon",
      native_command(root, [
        output + "/provider-sources/full_body_reference_study.py",
        "--config",
        output + "/config.json",
        "--collection",
        output + "/collection.json",
        "--teacher-study",
        args[3],
        "--scene",
        root + "/target/mujoco_menagerie/unitree_g1/scene_mjx.xml",
        "--output",
        output,
      ]),
      stdout=@process.redirect_to_file(
        output + "/run.log",
        create_mode=CreateOrTruncate,
      ),
      stderr=@process.redirect_to_file(
        output + "/stderr.log",
        create_mode=CreateOrTruncate,
      ),
    ),
    0,
  )
  guard @json.parse(@fs.read_file(output + "/report.json").text())
    is {
      "format": "moonrobo.g1-full-body-reference-study.v1",
      "collection_trials": Array(collection),
      "replay_trials": Array(replays),
      "training_updates": 0,
      "physical_execution_allowed": false,
      ..
    } else {
    fail("reference study did not finish")
  }
  assert_eq(collection.length(), 9)
  assert_eq(replays.length(), 54)
  println(
    "Collected nine fresh full-body references and 54 physics replay trials.",
  )
}

///|
fn native_command(root : String, original : Array[String]) -> Array[String] {
  let command = [
    "-C", root, "run", "--quiet", "--warn-list", "-a", "--target", "native", "cmd/reference_scripts",
    "--", root,
  ]
  command.append(original)
  command
}
