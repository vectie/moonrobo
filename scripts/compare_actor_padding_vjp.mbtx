///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args() is [_,mode] && ["prepare","run"].contains(mode) else {fail("prepare/run")}
  let out="output/spark-runtime-20261024/actor-backward-boundaries-20261029-a"
  let base="/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host="wlc004s@192.168.2.179"
  let runner="run_actor_padding_vjp_a.mbtx"
  if mode=="prepare" {
    let code=@fs.read_file(out+"/run_actor_adjoints_d.mbtx").text()
      .replace_all(old="run_actor_adjoints_d.mbtx",new=runner)
      .replace_all(old="actor_step_adjoints_d.py",new="actor_padding_vjp_a.py")
      .replace_all(old="  if implementation==\"smc\" {for name in [\"inductor-cache\",\"triton-cache\"] {if @fs.exists(cache_source+\"/\"+name){clone_compilation_tree(cache_source+\"/\"+name,root+\"/\"+name,records)}}}",new="  // AOTI-only numerical replay; no torch.compile or runtime code generation.")
      .replace_all(old="  write_json(root + \"/protocol.json\"",new="  for branch in [\"initial\",\"recurrent\"] {let dir=\"/home/wlc004s/moonrobo/runs/hotspot-mlp-actor-backward-padding-g/\"+branch;for name in @fs.readdir(dir) {if name.has_suffix(\".so\")||name.has_suffix(\".cubin\")||name==\"manifest.json\"||name==\"native.spec\" {let path=dir+\"/\"+name;pins[path]=Json(hash_file(path))}}}\n  write_json(root + \"/protocol.json\"")
    for (name,content) in [(runner,code),("actor_padding_vjp_a.py",@fs.read_file("providers/motion_learning/actor_padding_vjp_probe.py").text())] {
      @fs.write_file(out+"/"+name,content,create_mode=CreateNew)
      if name==runner {assert_eq(@process.run("moon",["check","--target","native",out+"/"+name]),0)}
      assert_eq(@process.run("scp",["-q","-o","ControlPath=/tmp/moonrobo-operator-179.sock",out+"/"+name,host+":"+base+"/"+name]),0)
    }
    return
  }
  let folder=out+"/padding-vjp-a"
  @fs.mkdir(folder)
  let status=@process.run("ssh",["-S","/tmp/moonrobo-operator-179.sock",host,"env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native "+base+"/"+runner+" -- actor smc off 1 actor-padding-vjp-a bf16-full"],stdout=@process.redirect_to_file(folder+"/controller.stdout.log",create_mode=CreateNew),stderr=@process.redirect_to_file(folder+"/controller.stderr.log",create_mode=CreateNew))
  for name in ["result.json","progress.json","completion.json","training-guard.json","training-docker-final.json","training.stdout.log","training.stderr.log","protocol.json","compilation-audit.json"] {
    ignore(@process.run("scp",["-q","-o","ControlPath=/tmp/moonrobo-operator-179.sock",host+":/home/wlc004s/moonrobo/runs/hotspot-shared-actor-padding-vjp-a/"+name,folder+"/"+name]))
  }
  assert_eq(status,0)
}
