///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
}

///|
async fn run(program : String, args : Array[String]) -> Unit {
  guard @process.run(program, args) == 0 else { fail(program + " failed") }
}

///|
async fn main {
  guard @env.args() is [_, revision, from, next] &&
    ["v3", "v4", "v5"].contains(revision) &&
    ["c", "d", "e"].contains(from) &&
    ["d", "e", "f"].contains(next) &&
    from != next else {
    fail("explicit fresh build revision required")
  }
  let root = "/Users/kq/Workspace/moonrobo/output/spark-runtime-20261024/shared-compute-20261026"
  let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host = "wlc004s@192.168.2.179"
  let socket = "/tmp/moonrobo-operator-179.sock"
  let build = @fs.read_file(root + "/build_shared_v2.mbtx")
    .text()
    .replace_all(old="moonrobo-fixtures-b", new="moonrobo-fixtures-" + next)
    .replace_all(
      old="\"numeric-gate\"",
      new="\"numeric-gate-" + revision + "\"",
    )
    .replace_all(old="\"tensor-gate\"", new="\"tensor-gate-" + revision + "\"")
    .replace_all(
      old="\"runtime-gate\"",
      new="\"runtime-gate-" + revision + "\"",
    )
  let builder = "build_shared_probe_" + revision + ".mbtx"
  @fs.write_file(root + "/" + builder, build, create_mode=CreateNew)
  let source = "shared_fixture_" + revision + "_wbtest.mbt"
  @fs.write_file(
    root + "/" + source,
    @fs.read_file(
      "/Users/kq/Workspace/moonrobo/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt",
    ).text(),
    create_mode=CreateNew,
  )
  for name in [builder, source] {
    run("scp", [
      "-o",
      "ControlPath=" + socket,
      root + "/" + name,
      host + ":" + base + "/" + name,
    ])
  }
  run("ssh", [
    "-S",
    socket,
    host,
    "cp -a --reflink=auto " +
    base +
    "/workspace/moonrobo-fixtures-" +
    from +
    " " +
    base +
    "/workspace/moonrobo-fixtures-" +
    next,
  ])
  run("ssh", [
    "-S",
    socket,
    host,
    "cp " +
    base +
    "/" +
    source +
    " " +
    base +
    "/workspace/moonrobo-fixtures-" +
    next +
    "/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt",
  ])
  run("ssh", [
    "-S",
    socket,
    host,
    "env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native " +
    base +
    "/" +
    builder +
    " -- gate-build-" +
    next,
  ])
}
