      #|    guard field(read_json(dir+"/final.json"),"records") is Array(records) else {fail("timed export")}
      #|    assert_eq(records.length(),baseline.length())
      #|    for row in records {let matched=baseline.filter(b=>field(b,"name")==field(row,"name"));assert_eq(matched.length(),1);assert_eq(field(field(matched[0],"blob"),"sha256"),field(field(row,"blob"),"sha256"))}
      #|    comparisons.push({"block":Json(block),"bitwise_equal_output_records":Json(records.length())})
      #|  }
      #|  assert_eq(docker(["ps","--quiet"]),"")
      #|  assert_eq(checkpoint_command("nvidia-smi",["--query-compute-apps=pid","--format=csv,noheader"]),"")
      #|  write_json("/home/wlc004s/moonrobo/private/shared-compute-20261026-a/world-benchmark-final-audit-a.json",{"exported_artifacts_unchanged":true,"exported_pin_count":Json(pins.length()),"original_forward_error_files_unchanged":Json(unchanged),"native_steady_exports_vs_gate":Json(comparisons),"gpu_and_docker_idle":true,"host_memory_after":Json(@fs.read_file("/proc/meminfo").text())})
      #|}
    )
  @fs.write_file(
