///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/async@0.22.4/fs",
}

///|
async fn reject_before_ssh(j : Json, expected : String) -> Unit {
  let path = "_build/neck-control-elf/invalid-trial-source.json"
  @fs.write_file(path, j.stringify())
  let (code, out, err) = @process.collect_output("moon", [
    "run", "--target", "native", "scripts/prepare_neck_trial.mbtx", "/tmp/no-ssh-connection-permitted-for-this-test",
    path,
  ])
  let message = out.text() + err.text()
  guard code != 0 &&
    message.contains(expected) &&
    !message.contains("ssh exited") else {
    fail("Expected rejection before SSH: " + message)
  }
}

///|
async fn main {
  if !@fs.exists("_build/neck-control-elf") {
    @fs.mkdir("_build/neck-control-elf", recursive=true)
  }
  for
    (action, authorized, version, expected) in [
      (Json([Json("Joystick"), Json(301)]), true, "2", "1..300"),
      (Json([Json("Buttons"), Json(0)]), true, "2", "1..300"),
      (Json([Json("Jog"), Json("Right"), Json(6)]), true, "2", "1..5"),
      (
        Json([Json("Jog"), Json("Other"), Json(1)]),
        true,
        "2",
        "Unknown neck direction",
      ),
      (
        Json([Json("Jog"), Json("Right"), Json(1)]),
        false,
        "2",
        "explicit authorization",
      ),
      (Json([Json("Buttons"), Json(300)]), false, "2", "explicit authorization"),
      (Json([Json("Jog"), Json("Right"), Json(11)]), true, "3", "1..10"),
      (
        Json([Json("Jog"), Json("Right"), Json(10)]),
        false,
        "3",
        "explicit authorization",
      ),
      (
        Json([Json("Jog"), Json("Right"), Json(1)]),
        true,
        "5",
        "Unknown neck profile",
      ),
      (
        Json([Json("Jog"), Json("Left"), Json(10)]),
        false,
        "4",
        "explicit authorization",
      ),
    ] {
    let j : Json = {
      "operator_authorized": Json(authorized),
      "action": action,
      "neck_profile_version": Json(version),
      "servo_speed_limit": "50",
      "neck_travel_limit_degrees": Json(
        if version == "3" || version == "4" {
          "10"
        } else {
          "5"
        },
      ),
      "raw_feedback_velocity_limit": "100",
    }
    reject_before_ssh(j, expected)
  }
  reject_before_ssh(
    {
      "operator_authorized": true,
      "action": ["Jog", "Left", 10],
      "neck_profile_version": "4",
      "neck_travel_limit_degrees": "10",
      "servo_speed_limit": "50",
      "raw_feedback_velocity_limit": "60",
    },
    "velocity limit 100",
  )
  println(
    "Eleven bounded-action, version and authorization cases rejected before SSH",
  )
}
