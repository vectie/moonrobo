///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/async@0.22.4/fs",
}

///|
async fn reject_before_ssh(j : Json, expected : String) -> Unit {
  let path = "_build/neck-control-elf/invalid-trial-source.json"
  @fs.write_file(path, j.stringify())
  let (code, out, err) = @process.collect_output("moon", [
    "run", "--target", "native", "scripts/prepare_neck_trial.mbtx", "/tmp/no-ssh-connection-permitted-for-this-test",
    path,
  ])
  let message = out.text() + err.text()
  guard code != 0 &&
    message.contains(expected) &&
    !message.contains("ssh exited") else {
    fail("Expected rejection before SSH: " + message)
  }
}

///|
async fn main {
  if !@fs.exists("_build/neck-control-elf") {
    @fs.mkdir("_build/neck-control-elf", recursive=true)
  }
  for
    (action, authorized, version, expected) in [
      (Json([Json("Joystick"), Json(301)]), true, "2", "1..300"),
      (Json([Json("Buttons"), Json(0)]), true, "2", "1..300"),
      (Json([Json("Jog"), Json("Right"), Json(6)]), true, "2", "1..5"),
      (
        Json([Json("Jog"), Json("Other"), Json(1)]),
        true,
        "2",
        "Unknown neck direction",
      ),
      (
        Json([Json("Jog"), Json("Right"), Json(1)]),
        false,
        "2",
        "explicit authorization",
      ),
      (Json([Json("Buttons"), Json(300)]), false, "2", "explicit authorization"),
      (Json([Json("Jog"), Json("Right"), Json(11)]), true, "3", "1..10"),
      (
        Json([Json("Jog"), Json("Right"), Json(10)]),
        false,
        "3",
        "explicit authorization",
      ),
      (
        Json([Json("Jog"), Json("Right"), Json(1)]),
        true,
        "7",
        "Unknown neck profile",
      ),
      (
        Json([Json("Jog"), Json("Left"), Json(10)]),
        false,
        "4",
        "explicit authorization",
      ),
      (Json([Json("Jog"), Json("Right"), Json(31)]), true, "5", "1..30"),
      (
        Json([Json("Jog"), Json("Right"), Json(30)]),
        false,
        "5",
        "explicit authorization",
      ),
    ] {
    let j : Json = {
      "operator_authorized": Json(authorized),
      "action": action,
      "neck_profile_version": Json(version),
      "servo_speed_limit": "50",
      "neck_travel_limit_degrees": Json(
        if version == "5" {
          "30"
        } else if version == "3" || version == "4" {
          "10"
        } else {
          "5"
        },
      ),
      "raw_feedback_velocity_limit": "100",
      "completion_policy": "stable-hold-with-accuracy",
      "target_accuracy_ticks": "11",
      "tracking_error_limit_ticks": "16",
    }
    reject_before_ssh(j, expected)
  }
  reject_before_ssh(
    {
      "operator_authorized": true,
      "action": ["Jog", "Left", 10],
      "neck_profile_version": "4",
      "neck_travel_limit_degrees": "10",
      "servo_speed_limit": "50",
      "raw_feedback_velocity_limit": "60",
    },
    "velocity limit 100",
  )
  for
    (key, wrong) in [
      ("neck_travel_limit_degrees", "10"),
      ("raw_feedback_velocity_limit", "101"),
      ("completion_policy", "ignore-accuracy"),
      ("target_accuracy_ticks", "16"),
      ("tracking_error_limit_ticks", "17"),
    ] {
    let fields : Map[String, Json] = {
      "operator_authorized": true,
      "action": ["Jog", "Left", 30],
      "neck_profile_version": "5",
      "neck_travel_limit_degrees": "30",
      "servo_speed_limit": "50",
      "raw_feedback_velocity_limit": "100",
      "completion_policy": "stable-hold-with-accuracy",
      "target_accuracy_ticks": "11",
      "tracking_error_limit_ticks": "16",
    }
    fields[key] = Json(wrong)
    reject_before_ssh(Json(fields), "Profile 5/6 authorization")
  }
  for
    (action, authorized, key, wrong, expected) in [
      (
        Json([Json("Sweep"), Json(30)]),
        true,
        "maximum_step_ticks",
        "3",
        "Profile 6 authorization",
      ),
      (
        Json([Json("Sweep"), Json(30)]),
        true,
        "minimum_step_interval_ms",
        "25",
        "Profile 6 authorization",
      ),
      (
        Json([Json("Sweep"), Json(30)]),
        true,
        "maximum_target_slew_ticks_per_second",
        "80",
        "Profile 6 authorization",
      ),
      (Json([Json("Sweep"), Json(31)]), true, "", "", "Sweep requires"),
      (
        Json([Json("ReturnToStart"), Json(1585), Json(2056)]),
        true,
        "",
        "",
        "Return pose outside",
      ),
      (
        Json([Json("ReturnToStart"), Json(1948), Json(2389)]),
        true,
        "",
        "",
        "Return pose outside",
      ),
      (
        Json([Json("ReturnToStart"), Json(1948), Json(2056)]),
        false,
        "",
        "",
        "explicit authorization",
      ),
      (
        Json([Json("ReturnToStart"), Json(1948), Json(2056)]),
        true,
        "neck_profile_version",
        "5",
        "Need an exact bounded",
      ),
      (Json([Json("Sweep"), Json(0)]), true, "", "", "Sweep requires"),
      (Json([Json("Sweep"), Json(30)]), false, "", "", "explicit authorization"),
      (
        Json([Json("Sweep"), Json(30)]),
        true,
        "neck_profile_version",
        "5",
        "Need an exact bounded",
      ),
    ] {
    let fields : Map[String, Json] = {
      "operator_authorized": Json(authorized),
      "action": action,
      "neck_profile_version": "6",
      "neck_travel_limit_degrees": "30",
      "servo_speed_limit": "50",
      "raw_feedback_velocity_limit": "100",
      "completion_policy": "stable-hold-with-accuracy",
      "target_accuracy_ticks": "11",
      "tracking_error_limit_ticks": "16",
      "maximum_step_ticks": "2",
      "minimum_step_interval_ms": "50",
      "maximum_target_slew_ticks_per_second": "40",
    }
    if key != "" {
      fields[key] = Json(wrong)
    }
    reject_before_ssh(Json(fields), expected)
  }
  println(
    "Twenty-nine bounded-action, version and authorization cases rejected before SSH",
  )
}
