    )
    .replace_all(
      old="trace_root + \"/run/native\",",
      new=(
        #|trace_root + "/run/native",
        #|        "/home/wlc004s/moonrobo/private/apic-authoring-build-20261024-a/sdk",
        #|        "/home/wlc004s/moonrobo/private/apic-authoring-build-20261024-b/sdk",
