///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/process",
}

///|
async fn main {
  let base = "/home/wlc004s/moonrobo/private/hotspot-optimization-20261025-a"
  let old = "/home/wlc004s/moonrobo/private/operator-diagnostic-20261025-a"
  let runs = "/home/wlc004s/moonrobo/runs/"
  async fn run(label : String, script : String, args : Array[String]) -> Unit {
    println("Starting " + label)
    guard @process.run("/home/wlc004s/moonrobo/toolchain/bin/moon", ["run", "--target", "native", script, "--", ..args],
      stdout=@process.redirect_to_file(base + "/start-inspection-20261026-" + label + ".stdout.log", create_mode=CreateNew),
      stderr=@process.redirect_to_file(base + "/start-inspection-20261026-" + label + ".stderr.log", create_mode=CreateNew)) == 0 else {
      fail(label + " failed; stop, preserve evidence")
    }
    println("Completed " + label)
  }
  run("closed-cuda-pages", old + "/advise_hotspot_run_cache.mbtx", [
    "--advise-caches", old + "/cache-hotspot-completed-apic-cuda-20261026-a.json",
    runs + "hotspot-apic3-abba-20261025-c/run-0", runs + "hotspot-apic3-abba-20261025-c/run-1",
    runs + "hotspot-apic3-abba-20261025-c/run-2", runs + "hotspot-apic3-abba-20261025-c/run-3",
    runs + "hotspot-apic3-abba-20261025-b/run-0", runs + "hotspot-apic3-abba-20261025-b/run-1",
    runs + "hotspot-apic4096-abba-20261025-a/run-0",
  ])
  run("closed-build-pages", old + "/advise_hotspot_recent_cache_e.mbtx", ["--host-build", "cache-hotspot-completed-builds-20261026-a.json"])
  run("closed-image-pages", old + "/advise_closed_smc_image_pages_f.mbtx", ["--advise", "cache-hotspot-image-before-inspection-20261026-a.json"])
  run("series", base + "/run_hotspot_inspection_series.mbtx", ["inspection", "20261026-a"])
}
