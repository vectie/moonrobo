///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/async@0.20.2/io",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn field(value : Json, key : String) -> Json raise {
  guard value is Object(fields) && fields.get(key) is Some(value) else {
    fail("missing field: " + key)
  }
  value
}

///|
async fn read(path : String) -> Json {
  @json.parse(@fs.read_file(path).text())
}

///|
async fn run(exe : String, args : Array[String]) -> String {
  let (code, out, err) = native_collect_output(exe, args)
  assert_eq(code, 0, msg=err.text() + out.text())
  out.text()
}

///|
async fn copy(source : String, destination : String) -> Unit {
  ignore(run("/bin/cp", [source, destination]))
}

///|
async fn main {
  let args = @env.args()
  assert_eq(
    args.length(),
    5,
    msg="usage: fit_g1_paired_tail.mbtx REPO DATA_RUN ADAPTIVE_RUN OUTPUT",
  )
  let root = args[1]
  let source = args[2]
  let incoming = args[3]
  let output = args[4]
  assert_true(!@fs.exists(output), msg="choose a fresh study directory")
  @fs.mkdir(output + "/provider-sources", recursive=true)
  for name in ["policy.py", "dynamics.py", "cpu_physics.py"] {
    @fs.write_file(
      output + "/provider-sources/" + name,
      @fs.read_file(root + "/providers/motion_learning/" + name).binary(),
      create_mode=CreateOrTruncate,
    )
  }
  let cells : Array[Json] = []
  for id in ["paired-tail-on", "paired-tail-off"] {
    let cell = output + "/" + id
    @fs.mkdir(cell + "/policy", recursive=true)
    @fs.mkdir(cell + "/fit", recursive=true)
    @fs.mkdir(cell + "/collection", recursive=true)
    let config = read(root + "/examples/learning/g1-policy-long-fit.json")
    guard config is Object(fields) else { fail("expected config") }
    fields.set("test_seeds", [8200, 8201, 8202])
    fields.set("actor_critic_bootstrap", Json(id == "paired-tail-on"))
    fields.set("critic_horizontal_translation_invariant", true)
    fields.set("critic_training_source", "frozen")
    fields.set("evaluation_updates", [1, 5, 10, 20])
    fields.set(
      "study", "Selected adaptive actor/critic/model triples, fixed model and critic. Only terminal critic contribution to actor objective differs. 200 actor updates at learning rate 0.0003; no critic or model fitting and no new training collection. Weights-only warm start, not exact restart.",
    )
    fields.set(
      "physical_qualification", "All nine fresh ten-second physics trials must have zero falls and mean joint RMSE at most 0.15 rad. No hardware authority.",
    )
    @fs.write_file(
      cell + "/config.json",
      config.stringify(indent=2),
      create_mode=CreateOrTruncate,
    )
    for seed in 0..<3 {
      let one = @json.parse(config.stringify())
      guard one is Object(one_fields) else { fail("expected config") }
      one_fields.set("seeds", Json([seed]))
      @fs.write_file(
        cell + "/config-seed-\{seed}.json",
        one.stringify(indent=2),
        create_mode=CreateOrTruncate,
      )
    }
    cells.push({ "id": Json(id), "config": config })
  }
  @fs.write_file(
    output + "/charter.json",
    (
      {
        "format": "moonrobo.g1-paired-tail-charter.v1",
        "data_run": Json(source),
        "incoming": Json(incoming),
        "cells": Json(cells),
        "selection": "Validation seeds 30-32 at updates 0/1/5/10/20/50/100/150/200, including initial actor. Fresh final seeds 8200-8202 never select weights. Each seed starts from its own paired selected model and critic.",
        "physical_execution_allowed": false,
      } : Json).stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  let summaries : Array[Json] = []
  for entry in cells {
    guard field(entry, "id") is String(id) else { fail("expected id") }
    let cell = output + "/" + id
    copy(source + "/collection/dataset.json", cell + "/collection/dataset.json")
    copy(incoming + "/fit/report.json", cell + "/fit/report.json")
    let results : Array[Json] = []
    let initial_models : Map[String, Json] = Map([])
    for seed in 0..<3 {
      let model = cell + "/fit/dynamics-seed-\{seed}.moon.json"
      copy(incoming + "/fit/dynamics-seed-\{seed}.moon.json", model)
      copy(
        incoming + "/fit/latest-dynamics-seed-\{seed}.moon.json",
        cell + "/fit/latest-dynamics-seed-\{seed}.moon.json",
      )
      let seed_output = cell + "/seed-\{seed}"
      @fs.write_file(
        cell + "/policy-seed-\{seed}.log",
        run(root + "/scripts/run_native_learning.mbtx", [
          output + "/provider-sources/policy.py",
          "fit",
          "--train",
          source + "/train-batch.json",
          "--dynamics",
          model,
          "--scene",
          root + "/target/mujoco_menagerie/unitree_g1/scene_mjx.xml",
          "--config",
          cell + "/config-seed-\{seed}.json",
          "--experiment",
          root + "/examples/learning/g1-long-experiment.json",
          "--warm-start-policy",
          incoming + "/policy",
          "--output",
          seed_output,
        ]),
        create_mode=CreateOrTruncate,
      )
      let report = read(seed_output + "/report.json")
      guard field(report, "runs") is Array(runs) && runs.length() == 1 else {
        fail("expected one run")
      }
      let result = runs[0]
      assert_eq(field(result, "critic_unchanged"), true)
      assert_eq(field(result, "dynamics_unchanged"), true)
      assert_eq(field(result, "reload_matches"), true)
      results.push(result)
      initial_models.set(seed.to_string(), field(report, "dynamics_sha256"))
      for
        name in [
          "actor-seed-\{seed}.moon.json",
          "latest-actor-seed-\{seed}.moon.json",
          "physics-seed-\{seed}.json",
          "candidate-data-seed-\{seed}.json",
        ] {
        copy(seed_output + "/" + name, cell + "/policy/" + name)
      }
      println(
        id +
        " seed \{seed}: " +
        (
          {
            "selected_update": field(result, "selected_update"),
            "candidate": field(result, "candidate"),
            "qualifies": field(result, "qualifies"),
          } : Json).stringify(),
      )
    }
    let aggregate : Json = {
      "format": "moonrobo.g1-policy-fit.v1",
      "config": field(entry, "config"),
      "runs": Json(results),
      "evidence_class": "physics-simulation",
      "checkpoint_selection": "validation-physics-only",
      "initial_dynamics_by_seed": Json(initial_models),
      "dynamics_sha256": null,
      "experiment": read(root + "/examples/learning/g1-long-experiment.json"),
      "any_qualified": Json(
        results.any(r => field(r, "qualifies") == (true : Json)),
      ),
      "scope": "No additional model fitting: fit/ preserves incoming selected model diagnostics. Single-seed trainer reports retain provider digests. Initial model is per-seed, not a shared checkpoint.",
    }
    @fs.write_file(
      cell + "/policy/report.json",
      aggregate.stringify(indent=2),
      create_mode=CreateOrTruncate,
    )
    summaries.push({ "id": Json(id), "runs": Json(results) })
  }
  @fs.write_file(
    output + "/summary.json",
    (
      {
        "format": "moonrobo.g1-paired-tail-study.v1",
        "cells": Json(summaries),
        "physical_execution_allowed": false,
      } : Json).stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
}

///|
/// Checkpoint copies are validated or converted by the reviewed native loader.
fn native_checkpoint_copy_command(
  exe : String,
  args : Array[String],
) -> (String, Array[String])? raise {
  if exe != "/bin/cp" || args.length() < 2 {
    return None
  }
  if !args[0].has_suffix(".moon.json") &&
    !args[0].has_suffix(".pt") &&
    !args[1].has_suffix(".moon.json") {
    return None
  }
  guard args.length() == 2 && args[1].has_suffix(".moon.json") else {
    fail("checkpoint copies require SOURCE and native .moon.json DESTINATION")
  }
  let name = args[0].split("/").last().unwrap_or("").to_owned()
  let kind = if name.contains("dynamics-seed-") {
    "residual-dynamics"
  } else if name.contains("actor-seed-") {
    "g1-actor"
  } else {
    fail("unreviewed checkpoint copy kind: " + name)
  }
  let root = @env.args()[1]
  Some(
    (
      root,
      [
        "run",
        root + "/scripts/run_native_learning.mbtx",
        root,
        "src/learning_training/launch/cmd",
        "checkpoint-copy",
        args[0],
        args[1],
        kind,
      ],
    ),
  )
}

///|
/// Structured native dispatch. A .py argument is a reviewed provider descriptor, never an executable or an interpreter fallback.
async fn native_collect_output(
  exe : String,
  args : Array[String],
) -> (Int32, &@io.Data, &@io.Data) {
  let suffix = "/scripts/run_native_learning.mbtx"
  if exe.has_suffix(suffix) {
    let root = exe[:exe.length() - suffix.length()].to_owned()
    let command = ["run", exe, root, "src/learning_training/launch/cmd"]
    command.append(args)
    return @process.collect_output("moon", command, cwd=root)
  }
  if native_checkpoint_copy_command(exe, args) is Some((root, command)) {
    return @process.collect_output("moon", command, cwd=root)
  }
  @process.collect_output(exe, args)
}

///|
async fn native_process_run(
  exe : String,
  args : Array[String],
  stdout? : &@process.ProcessOutput,
  stderr? : &@process.ProcessOutput,
) -> Int32 {
  let suffix = "/scripts/run_native_learning.mbtx"
  if exe.has_suffix(suffix) {
    let root = exe[:exe.length() - suffix.length()].to_owned()
    let command = ["run", exe, root, "src/learning_training/launch/cmd"]
    command.append(args)
    return @process.run("moon", command, cwd=root, stdout?, stderr?)
  }
  if native_checkpoint_copy_command(exe, args) is Some((root, command)) {
    return @process.run("moon", command, cwd=root, stdout?, stderr?)
  }
  @process.run(exe, args, stdout?, stderr?)
}
