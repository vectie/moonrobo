///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
}

///|
async fn main {
  let out = "output/spark-runtime-20261024/actor-backward-boundaries-20261029-a"
  let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host = "wlc004s@192.168.2.179"
  let fixture = @fs.read_file(out + "/training_fixture_ap_complete.mbt")
    .text()
    .replace_all(
      old="records.push(shared_write(output,\"world-\\{i}-gradient\",g))",
      new="records.push(Json(shared_write(output,\"world-\\{i}-gradient\",g)))",
    )
  let prefix = @fs.read_file(out + "/build_aligned_training_ap_complete.mbtx")
  .text()
  .split("async fn main {")
  .to_array()[0].to_owned()
  let build = prefix +
    (
      #|async fn main {
      #|  require_idle()
      #|  let ws=base+"/workspace/moonrobo-actor-step-training-native-ap"
      #|  run("fixture-training-ap-final","cp",[base+"/training_fixture_ap_final.mbt",ws+"/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt"])
      #|  container("build-training-ap-final","/toolchain/bin/moon",["test","--build-only","--release","--target","native","-j","2","--frozen","src/learning_aligned_gpu/cmd"],workdir="/workspace/moonrobo-actor-step-training-native-ap")
      #|  run("binary-training-ap-final","cp",[ws+"/_build/native/release/test/vectie/moonrobo/src/learning_aligned_gpu/cmd/cmd.whitebox_test.exe",base+"/actor-step-gate-training-native-ap"])
      #|}
    )
  for
    (name, value) in [
      ("training_fixture_ap_final.mbt", fixture),
      ("build_aligned_training_ap_final.mbtx", build),
    ] {
    @fs.write_file(out + "/" + name, value, create_mode=CreateNew)
    assert_eq(
      @process.run("scp", [
        "-q",
        "-o",
        "ControlPath=/tmp/moonrobo-operator-179.sock",
        out + "/" + name,
        host + ":" + base + "/" + name,
      ]),
      0,
    )
  }
  assert_eq(
    @process.run(
      "ssh",
      [
        "-S",
        "/tmp/moonrobo-operator-179.sock",
        host,
        "env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native " +
        base +
        "/build_aligned_training_ap_final.mbtx",
      ],
      stdout=@process.redirect_to_file(
        out + "/training-build-ap-final.stdout.log",
        create_mode=CreateNew,
      ),
      stderr=@process.redirect_to_file(
        out + "/training-build-ap-final.stderr.log",
        create_mode=CreateNew,
      ),
    ),
    0,
  )
}
