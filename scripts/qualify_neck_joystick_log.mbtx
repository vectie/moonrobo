///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
async fn main {
  let path = @env.args().get(1).unwrap()
  let source = @fs.read_file(path).text()
  let mut samples = 0
  let mut opens = 0
  let mut errors = 0
  let mut first = -1L
  let mut previous = -1L
  let mut max_gap = 0L
  let mut x_min = 1000
  let mut x_max = -1000
  let mut y_min = 1000
  let mut y_max = -1000
  for line in source.split("\n") {
    if !line.has_prefix("{") {
      continue
    }
    let record = @json.parse(line)
    guard record is { "physical_execution": false, .. } else {
      fail("Log includes an entry outside input-only monitoring")
    }
    match record {
      { "waiting_for_input": _, .. } => errors += 1
      { "kernel_sample": _, .. } => opens += 1
      { "sample": { "captured_ms": String(time), "x": x, "y": y, .. }, .. } => {
        let time = @string.parse_int64(time)
        let x : Int32 = @json.from_json(x)
        let y : Int32 = @json.from_json(y)
        if first < 0L {
          first = time
        }
        if previous >= 0L {
          guard time > previous else { fail("Nonmonotonic input log") }
          max_gap = Int64::max(max_gap, time - previous)
        }
        previous = time
        samples += 1
        x_min = Int32::min(x_min, x)
        x_max = Int32::max(x_max, x)
        y_min = Int32::min(y_min, y)
        y_max = Int32::max(y_max, y)
      }
      _ => fail("Unknown monitor entry")
    }
  }
  let passed = errors == 0 &&
    opens == 1 &&
    samples >= 280 &&
    previous - first >= 295000L &&
    x_min >= -200 &&
    x_max <= 200 &&
    y_min >= -200 &&
    y_max <= 200
  println(
    (
      {
        "passed": Json(passed),
        "physical_execution": false,
        "samples": Json(samples),
        "input_opens": Json(opens),
        "waiting_errors": Json(errors),
        "observed_span_ms": Json(previous - first),
        "maximum_logged_heartbeat_gap_ms": Json(max_gap),
        "x_range": Json([x_min, x_max]),
        "y_range": Json([y_min, y_max]),
        "note": "Monitor logs changes and approximately one heartbeat per second; logged gap is not HID report age.",
      } : Json).stringify(indent=2),
  )
  guard passed else { fail("Five-minute neutral input qualification failed") }
}
