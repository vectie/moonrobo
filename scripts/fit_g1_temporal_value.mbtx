///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn field(value : Json, key : String) -> Json raise {
  guard value is Object(fields) && fields.get(key) is Some(value) else {
    fail("missing field: " + key)
  }
  value
}

///|
async fn read(path : String) -> Json {
  @json.parse(@fs.read_file(path).text())
}

///|
async fn main {
  let args = @env.args()
  assert_eq(
    args.length(),
    5,
    msg="usage: fit_g1_temporal_value.mbtx REPO TEMPORAL_STUDY MIXED_FIT OUTPUT",
  )
  let root = args[1]
  let source = args[2]
  let output = args[4]
  assert_true(!@fs.exists(output), msg="choose a fresh value study directory")
  @fs.mkdir(output + "/provider-sources", recursive=true)
  for
    name in [
      "temporal_value.py", "temporal_value_training.py", "temporal_actor.py", "temporal_training.py",
      "temporal_probe.py", "actor_update_probe.py", "critic_probe.py", "policy.py",
      "dynamics.py", "cpu_physics.py",
    ] {
    @fs.write_file(
      output + "/provider-sources/" + name,
      @fs.read_file(root + "/providers/motion_learning/" + name).binary(),
      create_mode=CreateOrTruncate,
    )
  }
  @fs.write_file(
    output + "/provider-sources/teacher_feedback.py",
    @fs.read_file(source + "/provider-sources/teacher_feedback.py").binary(),
    create_mode=CreateOrTruncate,
  )
  let config = read(root + "/examples/learning/g1-temporal-value-study.json")
  @fs.write_file(
    output + "/charter.json",
    (
      {
        "format": "moonrobo.g1-temporal-value-charter.v1",
        "config": config,
        "incoming": Json(source),
        "mixed_fit": Json(args[3]),
        "selection": "Sway validation seeds 30-32, including incoming actor. Fresh canonical final 9100-9102, independent value audit seeds 5300/5400 plus 10000×policy seed, never choose weights. Both on/off train a critic and recollect at the same times. Initial direction probe does not choose policies.",
        "physical_execution_allowed": false,
      } : Json).stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  assert_eq(
    @process.run(
      "gzip",
      ["-nc", source + "/teacher-data/dataset.json"],
      stdout=@process.redirect_to_file(
        output + "/dataset.json.gz",
        create_mode=CreateOrTruncate,
      ),
    ),
    0,
  )
  @async.with_task_group() <| group => {
    let running : Array[(@process.Process, String)] = []
    for variant in ["frame", "preview"] {
      for (suffix, bootstrap) in [("off", false), ("on", true)] {
        let id = variant + "-value-" + suffix
        let cell = output + "/" + id
        @fs.mkdir(cell + "/collection", recursive=true)
        @fs.mkdir(cell + "/fit", recursive=true)
        assert_eq(
          @process.run("/bin/cp", [
            output + "/dataset.json.gz",
            cell + "/collection/dataset.json.gz",
          ]),
          0,
        )
        for
          name in [
            "report.json", "training-input.json", "dynamics-seed-0.moon.json", "dynamics-seed-1.moon.json",
            "dynamics-seed-2.moon.json", "latest-dynamics-seed-0.moon.json", "latest-dynamics-seed-1.moon.json",
            "latest-dynamics-seed-2.moon.json",
          ] {
          copy_model_file(root, args[3] + "/" + name, cell + "/fit/" + name)
        }
        let settings = @json.parse(config.stringify())
        guard settings is Object(fields) else { fail("expected config") }
        fields.set("actor_critic_bootstrap", Json(bootstrap))
        fields.set("variant", Json(variant))
        @fs.write_file(
          cell + "/config.json",
          settings.stringify(indent=2),
          create_mode=CreateOrTruncate,
        )
        let process = @process.spawn(
          group,
          "moon",
          native_args(root, [
            output + "/provider-sources/temporal_value_training.py",
            "--config",
            cell + "/config.json",
            "--experiment",
            source + "/experiment.json",
            "--collection",
            source + "/collection.json",
            "--data",
            source + "/teacher-data/dataset.json",
            "--policies",
            source + "/" + variant + "/policy",
            "--dynamics",
            args[3] + "/dynamics-seed-0.moon.json",
            "--scene",
            root + "/target/mujoco_menagerie/unitree_g1/scene_mjx.xml",
            "--output",
            cell + "/policy",
          ]),
          stdout=@process.redirect_to_file(
            cell + "/train.log",
            create_mode=CreateOrTruncate,
          ),
          stderr=@process.redirect_to_file(
            cell + "/stderr.log",
            create_mode=CreateOrTruncate,
          ),
        )
        running.push((process, id))
      }
    }
    for (process, id) in running {
      assert_eq(process.wait(), 0, msg=id + " failed")
      let report = read(output + "/" + id + "/policy/report.json")
      guard field(report, "runs") is Array(runs) else { fail("missing runs") }
      assert_eq(runs.length(), 3)
      for row in runs {
        println(
          id +
          ": " +
          (
            {
              "seed": field(row, "seed"),
              "selected_update": field(row, "selected_update"),
              "baseline": field(row, "baseline"),
              "candidate": field(row, "candidate"),
              "qualifies": field(row, "qualifies"),
            } : Json).stringify(),
        )
      }
    }
  }
}

///|
/// Historical .py names are inert routing descriptors. Each target parses
/// original flags and calls real native APIs; unknown descriptors fail closed.
fn native_args(root : String, command : Array[String]) -> Array[String] raise {
  guard !command.is_empty() else { fail("missing native provider descriptor") }
  let descriptor = command[0].split("/").last().unwrap_or("").to_owned()
  let training = [
    "policy.py", "dynamics.py", "cpu_physics.py", "teacher_step_verification.py",
    "compare_dynamics.py",
  ].contains(descriptor)
  let package = if training {
    "src/learning_training/launch/cmd"
  } else {
    "src/learning_balance/launch"
  }
  [
    "run",
    "--quiet",
    "--warn-list",
    "-a",
    root + "/scripts/run_native_learning.mbtx",
    root,
    package,
    ..command,
    ..if training {
      []
    } else {
      ["--repo", root]
    },
  ]
}

///|
/// Native checkpoint copies validate or explicitly convert restricted Torch
/// state dictionaries. JSON names never contain renamed pickle bytes.
async fn copy_model_file(
  root : String,
  source : String,
  destination : String,
) -> Unit {
  if destination.has_suffix(".moon.json") {
    assert_eq(
      @process.run("moon", [
        "run",
        "--quiet",
        "--warn-list",
        "-a",
        root + "/scripts/run_native_learning.mbtx",
        root,
        "src/learning_training/launch/cmd",
        "checkpoint-copy",
        source,
        destination,
        "residual-dynamics",
      ]),
      0,
    )
  } else {
    @fs.write_file(
      destination,
      @fs.read_file(source).binary(),
      create_mode=CreateOrTruncate,
    )
  }
}
