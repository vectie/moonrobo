///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/crypto",
}

///|
let parent_sha = "9b31cb2a54768e792106746c9b3e6de7ef95b7c4e3bfd9e9ce29ca2378180ec3"

///|
let pair_sha = "0e2db9db695160d23ef2e877e4ed90eba02b1cec8ffa89212755baec91f73f52"

///|
fn digest(s : String) -> String {
  let h = @crypto.SHA256::new()
  h.update(@utf8.encode(s))
  @crypto.bytes_to_hex_string(h.finalize())
}

///|
async fn read(path : String) -> String {
  guard @fs.kind(path, follow_symlink=false) == Regular else {
    fail("regular source required")
  }
  let f = @fs.open(path, mode=ReadOnly)
  defer f.close()
  let n = f.size()
  guard n > 0L && n <= 2097152L else { fail("source exceeds 2 MiB") }
  @utf8.decode(f.read_exactly_at(n.to_int(), position=0L))
}

///|
fn replace_exact(
  s : String,
  old : String,
  new : String,
  count~ : Int32 = 1,
) -> String raise {
  let parts = s.split(old).map(p => p.to_owned()).to_array()
  guard parts.length() == count + 1 else {
    fail("unexpected frozen-source match count for " + old)
  }
  parts.join(new)
}

///|
fn replace_function(
  source : String,
  start : String,
  end : String,
  replacement : String,
) -> String raise {
  let first = source.split(start).map(p => p.to_owned()).to_array()
  guard first.length() == 2 else { fail("function start not unique") }
  let rest = first[1].split(end).map(p => p.to_owned()).to_array()
  guard rest.length() == 2 else { fail("function end not unique") }
  first[0] + replacement + "\n\n///|\n" + end + rest[1]
}

///|
fn configuration_source(candidate : String, key : String) -> String {
  let enabled = candidate == "six_plus_noise_snapshot"
  (
    $|fn diagnostic_config(source : Json, key : String) -> Json raise {
    $|  guard key == "\{key}" else { fail("fixed candidate side required") }
    $|  let source_bytes = @utf8.encode(source.stringify(indent=2) + "\{"\\n"}")
    $|  let h = @crypto.SHA256::new()
    $|  h.update(source_bytes)
    $|  guard @crypto.bytes_to_hex_string(h.finalize()) == "\{pair_sha}" else { fail("exact frozen G2 pair required") }
    $|  let side = field(source, key)
    $|  let config = @json.parse(field(side, "expected_config").stringify())
    $|  guard field(side, "kind") == Json("native") && config is Object(values) else { fail("native candidate config required") }
    $|  for option in ["reuse_geometry", "body_orientation_batched", "resident_reference_cache", "adam_checked_norm", "defer_scalar_metrics", "world_staging_batch"] {
    $|    guard values.get(option) == Some(Json(true)) else { fail("six optimization switches required") }
    $|  }
    $|  for option in ["noise_staging_batch", "actor_norm_snapshot"] {
    $|    guard values.get(option) == Some(Json(\{enabled})) else { fail("candidate switch identity differs") }
    $|  }
    $|  for (name, expected) in [
    $|    ("max_motion_sampler_bins", Json(9000)), ("noise_staging_max_mib", Json(16)),
    $|    ("resident_reference_max_mib", Json(1376)), ("world_staging_max_mib", Json(128)),
    $|    ("pi_batch", Json(4096)), ("pi_microbatch", Json(512)), ("wm_microbatch", Json(0)),
    $|    ("reuse_critic_normalization", Json(false)), ("critic_cuda_graph", Json(false)),
    $|    ("layer_norm_mode", Json("expanded")), ("memory_admission_percent", Json(80)),
    $|    ("telemetry_max_samples", Json(512)), ("amp", Json("none")), ("allow_tf32", Json(true)),
    $|  ] { guard values.get(name) == Some(expected) else { fail("candidate fixed configuration differs: " + name) } }
    $|  values["iterations"] = Json(24)
    $|  values["checkpoint_every"] = Json(24)
    $|  values["profile_max_spans"] = Json(65536)
    $|  values["scope"] = Json("standalone G2 \{candidate} logical4096/micro512 profile:20 world-only+4 actor rounds; not steady throughput or paired performance")
    $|  config
    $|}
  )
}

