import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/fs", "moonbitlang/async@0.20.2/process", "moonbitlang/core/env" }
fn rep(s : String,a : String,b : String) -> String raise {guard s.contains(a)else{fail(a)};s.replace_all(old=a,new=b)}
async fn run(p : String,a : Array[String]) -> Unit {guard @process.run(p,a)==0 else{fail(p)}}
async fn main {
  let repo="/Users/kq/Workspace/moonrobo";let old=repo+"/output/spark-runtime-20261024/fused-rotation-20261028"
  let dir=repo+"/output/spark-runtime-20261024/geometry-tail-20261028"
  let base="/home/wlc004s/moonrobo/private/shared-compute-20261026-a";let host="wlc004s@192.168.2.179";let sock="/tmp/moonrobo-operator-179.sock"
  guard @env.args() is [_,mode]else{fail("prepare|stage|build")}
  if mode=="prepare" {
    @fs.mkdir(dir,recursive=true)
    let mut f=@fs.read_file(old+"/fused_rotation_fixture_b.mbt").text()
    f=rep(f,"fused_axis_rotation: [Some(\"axis\"),Some(\"both\")].contains(@env.get_env_var(\"MOONROBO_TOP3_VARIANT\")),","fused_axis_rotation: true,\n      fused_cross_forward: [Some(\"cross\"),Some(\"both\")].contains(@env.get_env_var(\"MOONROBO_TOP3_VARIANT\")),")
    f=rep(f,"fused_skew: [Some(\"skew\"),Some(\"both\")].contains(@env.get_env_var(\"MOONROBO_TOP3_VARIANT\")),","fused_skew: true,\n      fused_so3_tail: [Some(\"tail\"),Some(\"both\")].contains(@env.get_env_var(\"MOONROBO_TOP3_VARIANT\")),")
    f=rep(f,"let axis = enabled && (factor == \"axis\" || factor == \"both\")","let cross = enabled && (factor == \"cross\" || factor == \"both\")")
    f=rep(f,"let skew = enabled && (factor == \"skew\" || factor == \"both\")","let tail = enabled && (factor == \"tail\" || factor == \"both\")")
    f=rep(f,"fused_axis_rotation: axis, fused_skew: skew,","fused_axis_rotation: true, fused_skew: true, fused_cross_forward: cross, fused_so3_tail: tail,")
    f=rep(f,".with_fused_axis_rotation(axis)",".with_fused_axis_rotation(true).with_fused_cross_forward(cross)")
    @fs.write_file(dir+"/geometry_tail_fixture_a.mbt",f,create_mode=CreateNew)
    let mut b=@fs.read_file(old+"/build_fused_rotation_b.mbtx").text()
    for (a,v) in [("moonrobo-fused-rotation-a","moonrobo-geometry-tail-a"),("fused-rotation-gate-b","geometry-tail-gate-a"),("fused-rotation-tensor-a","geometry-tail-tensor-a"),("fused-rotation-runtime-a","geometry-tail-runtime-a"),("libmoonrobo_fused_rotation_a.so","libmoonrobo_geometry_tail_a.so"),("fused-rotation-cuda-build-a","geometry-tail-cuda-build-a"),("fused-rotation-plugin-a","geometry-tail-plugin-a"),("fused-rotation-cpu-a","geometry-tail-cpu-a"),("fused_rotation.cu","geometry_tail.cu"),("fused_rotation_wbtest.mbt:0-2","geometry_tail_wbtest.mbt:0-2")] {b=rep(b,a,v)}
    b=rep(b,"\"-o\",\"/build/fused_rotation_a.o\"","\"-o\",\"/build/geometry_tail_a.o\"")
    b=rep(b,"\"/build/fused_rotation_a.o\", \"-o\"","\"/build/fused_rotation_a.o\", \"/build/geometry_tail_a.o\", \"-o\"")
    @fs.write_file(dir+"/build_geometry_tail_a.mbtx",b,create_mode=CreateNew)
    let mut driver=@fs.read_file(old+"/run_fused_rotation_c.mbtx").text()
    for (a,v) in [("fused-rotation-gate-b","geometry-tail-gate-a"),("run_fused_rotation_c.mbtx","run_geometry_tail_a.mbtx"),("build_fused_rotation_b.mbtx","build_geometry_tail_a.mbtx"),("fused_rotation_fixture_b.mbt","geometry_tail_fixture_a.mbt"),("libmoonrobo_fused_rotation_a.so","libmoonrobo_geometry_tail_a.so"),("[\"baseline\", \"actor1024\"","[\"tail\", \"abba-tail\", \"abba-cross\", \"baseline\", \"actor1024\"")] {driver=rep(driver,a,v)}
    // Reuse the validated current compiler cache for both off and event runs.
    driver=rep(driver,"implementation==\"smc\" && observation==\"events\"","implementation==\"smc\"")
    @fs.write_file(dir+"/run_geometry_tail_a.mbtx",driver,create_mode=CreateNew)
    @fs.write_file(dir+"/invoke_geometry_tail_a.mbtx",rep(@fs.read_file(old+"/invoke_fused_rotation_c.mbtx").text(),"run_fused_rotation_c.mbtx","run_geometry_tail_a.mbtx"),create_mode=CreateNew)
    return
  }
  if mode=="stage" {
    for f in ["geometry_tail_fixture_a.mbt","build_geometry_tail_a.mbtx","run_geometry_tail_a.mbtx","invoke_geometry_tail_a.mbtx"] {run("scp",["-o","ControlPath="+sock,dir+"/"+f,host+":"+base+"/"+f])}
    run("ssh",["-S",sock,host,"test ! -e "+base+"/workspace/moonrobo-geometry-tail-a"])
    run("ssh",["-S",sock,host,"cp -a --reflink=auto "+base+"/workspace/moonrobo-fused-rotation-a "+base+"/workspace/moonrobo-geometry-tail-a"])
    for f in ["execution_optimizations.mbt","learning.mbt","microbatch.mbt","actor_microbatch.mbt","geometry/state.mbt","geometry/context.mbt","geometry/rotations.mbt","geometry/geometry_tail.mbt","geometry/geometry_tail_wbtest.mbt","geometry/moon.pkg","cmd/optimizations.mbt","cmd/optimizations_wbtest.mbt"] {run("scp",["-o","ControlPath="+sock,repo+"/src/learning_aligned_gpu/"+f,host+":"+base+"/workspace/moonrobo-geometry-tail-a/src/learning_aligned_gpu/"+f])}
    for f in ["geometry_tail.inc","geometry_tail_loader.inc","geometry_tail.mbt","geometry_tail.cu","adapter.cpp","loader.c","moon.pkg"] {run("scp",["-o","ControlPath="+sock,repo+"/src/learning_tensor/"+f,host+":"+base+"/workspace/moonrobo-geometry-tail-a/src/learning_tensor/"+f])}
    run("ssh",["-S",sock,host,"cp "+base+"/geometry_tail_fixture_a.mbt "+base+"/workspace/moonrobo-geometry-tail-a/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt"]);return
  }
  guard mode=="build"else{fail("mode")}
  for m in ["fused-cuda","plugin","gate-build-geometry-tail-a","cpu"] {run("ssh",["-S",sock,host,"env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native "+base+"/build_geometry_tail_a.mbtx -- "+m])}
}
