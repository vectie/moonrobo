import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/fs", "moonbitlang/async@0.20.2/process", "moonbitlang/core/env" }
fn rep(s : String,a : String,b : String) -> String raise {guard s.contains(a)else{fail("missing "+a)};s.replace_all(old=a,new=b)}
async fn run(p : String,a : Array[String]) -> Unit {guard @process.run(p,a)==0 else{fail(p)}}
async fn main {
  let repo="/Users/kq/Workspace/moonrobo";let old=repo+"/output/spark-runtime-20261024/smc-structural-20261028"
  let dir=repo+"/output/spark-runtime-20261024/smc-heading-body-20261028"
  let base="/home/wlc004s/moonrobo/private/shared-compute-20261026-a";let host="wlc004s@192.168.2.179";let socket="/tmp/moonrobo-operator-179.sock"
  guard @env.args() is [_,mode]else{fail("prepare|stage|build")}
  if mode=="prepare" {
    @fs.mkdir(dir,recursive=true)
    let mut f=@fs.read_file(old+"/structural_fixture_b.mbt").text()
    f=f.split("\n").map(l=>if l.trim().has_prefix("compact_axis_rotation:")&& !l.contains("compact_skew") {"      compact_axis_rotation: true,"}else if l.trim().has_prefix("compact_skew:"){"      compact_skew: false,"}else if l.trim().has_prefix("static_fk_pruning:"){"      static_fk_pruning: true,"}else{l.to_owned()}).collect().join("\n")
    f=rep(f,"      reuse_geometry: true,","      compact_heading: [Some(\"heading\"),Some(\"combined\")].contains(@env.get_env_var(\"MOONROBO_TOP3_VARIANT\")),\n      body_errors_batched: [Some(\"bodies\"),Some(\"combined\")].contains(@env.get_env_var(\"MOONROBO_TOP3_VARIANT\")),\n      reuse_geometry: true,")
    f=rep(f,"let axis = enabled && (factor == \"axis\" || factor == \"structural\" || factor == \"fk\")","let heading = enabled && (factor == \"heading\" || factor == \"combined\")")
    f=rep(f,"      let skew = enabled && (factor == \"skew\" || factor == \"structural\")\n      let fixed = enabled && (factor == \"static\" || factor == \"structural\" || factor == \"fk\")","      let bodies = enabled && (factor == \"bodies\" || factor == \"combined\")")
    f=rep(f,"compact_axis_rotation: axis, compact_skew: skew, static_fk_pruning: fixed,","compact_heading: heading, body_errors_batched: bodies,")
    f=rep(f,"context: learner.context.with_compact_axis_rotation(axis).with_static_fk_pruning(fixed),","context: learner.context.with_compact_heading(heading).with_body_errors_batched(bodies),")
    @fs.write_file(dir+"/heading_body_fixture_a.mbt",f,create_mode=CreateNew)
    let mut b=@fs.read_file(old+"/build_structural_b.mbtx").text()
    b=b.replace_all(old="smc-structural",new="smc-heading-body").replace_all(old="-structural-cpu-b",new="-heading-body-cpu-a").replace_all(old="-heading-body-b",new="-heading-body-a").replace_all(old="smc-heading-body-gate-b",new="smc-heading-body-gate-a").replace_all(old="smc-heading-body-tensor-b",new="smc-heading-body-tensor-a").replace_all(old="smc-heading-body-runtime-b",new="smc-heading-body-runtime-a").replace_all(old="smc-heading-body-tests-b",new="smc-heading-body-tests-a").replace_all(old="libmoonrobo_smc_structural_a.so",new="libmoonrobo_smc_heading_body_a.so")
    b=rep(b,"\"compact_rotation_wbtest.mbt:0-2\"","\"compact_heading_wbtest.mbt:0-1\"")
    b=rep(b,"\"static_fk_test.mbt:0-1\"","\"body_errors_test.mbt:0-1\"")
    b=rep(b,"\"optimizations_wbtest.mbt:0-8\"","\"optimizations_wbtest.mbt:0-9\"")
    b=rep(b,"      \"PATH=/toolchain/bin:/usr/bin:/bin\",","      \"PATH=/toolchain/bin:/usr/bin:/bin\",\n      \"--mount\", \"type=bind,src=/usr/local/cuda-13.0,dst=/cuda-toolkit,readonly\",")
    b=rep(b,"  if mode == \"plugin\" {",
      #|  if mode == "cuda" {
      #|    container("heading-body-cuda-build-a", "/cuda-toolkit/bin/nvcc", [
      #|      "-std=c++17", "-O3", "-arch=sm_121", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false",
      #|      "-Xcompiler=-fPIC", "-D_GLIBCXX_USE_CXX11_ABI=1",
      #|      "-I/opt/isaaclab-venv/lib/python3.12/site-packages/torch/include",
      #|      "-I/opt/isaaclab-venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include",
      #|      "-c", "/workspace/moonrobo-smc-heading-body-a/src/learning_tensor/compact_heading.cu", "-o", "/build/compact_heading_a.o",
      #|    ])
      #|    return
      #|  }
      #|  if mode == "plugin" {
    )
    b=rep(b,"\"-DMR_ENABLE_NVTX3=1\",","\"-DMR_ENABLE_GEOMETRY_FUSION=1\", \"-DMR_ENABLE_NVTX3=1\",")
    b=rep(b,"/src/learning_tensor/adapter.cpp\", \"-o\",","/src/learning_tensor/adapter.cpp\", \"/build/compact_heading_a.o\", \"-o\",")
    @fs.write_file(dir+"/build_heading_body_a.mbtx",b,create_mode=CreateNew)
    let mut driver=@fs.read_file(old+"/run_structural_b.mbtx").text()
    for (a,v) in [("smc-structural-gate-b","smc-heading-body-gate-a"),("run_structural_b.mbtx","run_heading_body_a.mbtx"),("build_structural_b.mbtx","build_heading_body_a.mbtx"),("structural_fixture_b.mbt","heading_body_fixture_a.mbt"),("libmoonrobo_smc_structural_a.so","libmoonrobo_smc_heading_body_a.so"),("\"abba-fk\"","\"abba-fk\", \"heading\", \"bodies\", \"combined\", \"abba-heading\", \"abba-bodies\", \"abba-combined\"")] {driver=rep(driver,a,v)}
    @fs.write_file(dir+"/run_heading_body_a.mbtx",driver,create_mode=CreateNew)
    @fs.write_file(dir+"/invoke_heading_body_a.mbtx",rep(@fs.read_file(old+"/invoke_structural_b.mbtx").text(),"run_structural_b.mbtx","run_heading_body_a.mbtx"),create_mode=CreateNew)
    return
  }
  if mode=="stage" {
    for file in ["heading_body_fixture_a.mbt","build_heading_body_a.mbtx","run_heading_body_a.mbtx","invoke_heading_body_a.mbtx"] {run("scp",["-o","ControlPath="+socket,dir+"/"+file,host+":"+base+"/"+file])}
    run("ssh",["-S",socket,host,"test ! -e "+base+"/workspace/moonrobo-smc-heading-body-a"])
    run("ssh",["-S",socket,host,"cp -a --reflink=auto "+base+"/workspace/moonrobo-smc-structural-b "+base+"/workspace/moonrobo-smc-heading-body-a"])
    for path in ["execution_optimizations.mbt","learning.mbt","microbatch.mbt","actor_microbatch.mbt","world_error_batched.mbt","geometry/context.mbt","geometry/rotations.mbt","geometry/state.mbt","geometry/compact_heading_wbtest.mbt","geometry/body_errors.mbt","geometry/body_errors_test.mbt","geometry/moon.pkg","cmd/optimizations.mbt","cmd/optimizations_wbtest.mbt"] {run("scp",["-o","ControlPath="+socket,repo+"/src/learning_aligned_gpu/"+path,host+":"+base+"/workspace/moonrobo-smc-heading-body-a/src/learning_aligned_gpu/"+path])}
    for path in ["compact_heading.inc","compact_heading.cu","compact_heading_loader.inc","compact_heading.mbt","adapter.cpp","loader.c","moon.pkg","CMakeLists.txt"] {run("scp",["-o","ControlPath="+socket,repo+"/src/learning_tensor/"+path,host+":"+base+"/workspace/moonrobo-smc-heading-body-a/src/learning_tensor/"+path])}
    run("ssh",["-S",socket,host,"cp "+base+"/heading_body_fixture_a.mbt "+base+"/workspace/moonrobo-smc-heading-body-a/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt"])
    return
  }
  guard mode=="build"else{fail("mode")}
  for m in ["cuda","plugin","gate-build-smc-heading-body-a","smc-heading-body-tests-a"] {run("ssh",["-S",socket,host,"env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native "+base+"/build_heading_body_a.mbtx -- "+m])}
}
