///|
struct LaunchSpec {
  format : String
  image_id : String
  trainer_relative_path : String
  trainer_sha256 : String
  tensor_library_sha256 : String
  physics_library : String
  physics_library_sha256 : String
  artifact_relative_path : String
  artifact_sha256 : String
  manifest_sha256 : String
  config_sha256 : String
  memory_limit_bytes : Int64
  data_ready_timeout_seconds : Int32
} derive(ToJson, FromJson)

///|
#cfg(target="native")
fn native_helper_target() -> Bool {
  true
}

///|
#cfg(not(target="native"))
fn native_helper_target() -> Bool {
  false
}

///|
fn sha_text_valid(text : String) -> Bool {
  text.length() == 64 &&
  text.iter().all(c => (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))
}

///|
fn safe_relative(path : String) -> Bool {
  path.length() > 0 &&
  path.length() <= 512 &&
  !path.has_prefix("/") &&
  path.split("/").all(x => x != "" && x != "." && x != "..") &&
  path
  .iter()
  .all(c => {
    (c >= 'a' && c <= 'z') ||
    (c >= 'A' && c <= 'Z') ||
    (c >= '0' && c <= '9') ||
    c == '/' ||
    c == '.' ||
    c == '-' ||
    c == '_'
  })
}

///|
fn validate_spec(spec : LaunchSpec) -> Unit raise {
  guard spec.format == "moonrobo.spark-native-bounded-ddp-spec.v1" &&
    (
      spec.trainer_relative_path ==
      "private/native-bounded-training-20261024-a/trainer" ||
      spec.trainer_relative_path == "private/native-bounded-gate/trainer"
    ) &&
    spec.image_id == image_id &&
    spec.physics_library == physics_library &&
    spec.physics_library_sha256 == physics_sha &&
    spec.artifact_sha256 == artifact_sha &&
    spec.manifest_sha256 == manifest_sha &&
    spec.config_sha256 == config_sha &&
    spec.memory_limit_bytes == memory_limit &&
    spec.trainer_sha256 == trainer_sha &&
    spec.tensor_library_sha256 == tensor_sha &&
    safe_relative(spec.artifact_relative_path) &&
    spec.artifact_relative_path.has_suffix("/manifest.json") &&
    spec.data_ready_timeout_seconds >= 60 &&
    spec.data_ready_timeout_seconds <= 21600 else {
    fail(
      "bounded DDP gate requires the fixed N4 bundle/runtime/microbatch config/trainer/tensor/40-motion identities and 48 GiB limit; readiness 60..21600 seconds",
    )
  }
}

///|
async fn read_spec(path : String) -> LaunchSpec {
  let spec : LaunchSpec = @json.from_json(bounded_json(path, 8192L))
  validate_spec(spec)
  spec
}

///|
fn trainer_relative_path(spec : LaunchSpec) -> String {
  spec.trainer_relative_path
}

///|
fn template_spec(
  trainer : String,
  tensor : String,
  artifact : String,
  ready_seconds : Int32,
  trainer_path~ : String? = None,
) -> LaunchSpec raise {
  let spec : LaunchSpec = {
    format: "moonrobo.spark-native-bounded-ddp-spec.v1",
    image_id,
    trainer_relative_path: trainer_path.unwrap_or(
      "private/native-bounded-training-20261024-a/trainer",
    ),
    trainer_sha256: trainer,
    tensor_library_sha256: tensor,
    physics_library,
    physics_library_sha256: physics_sha,
    artifact_relative_path: artifact,
    artifact_sha256: artifact_sha,
    manifest_sha256: manifest_sha,
    config_sha256: config_sha,
    memory_limit_bytes: memory_limit,
    data_ready_timeout_seconds: ready_seconds,
  }
  validate_spec(spec)
  spec
}

///|
fn expected_repo(rank : Int32) -> String raise {
  match rank {
    0 => "/home/wlc003s/moonrobo"
    1 => "/home/wlc004s/moonrobo"
    _ => fail("only ranks zero and one are supported")
  }
}

///|
fn validate_route(repo : String, rank : Int32, session : String) -> Unit raise {
  guard repo == expected_repo(rank) && safe_session(session) else {
    fail(
      "rank-specific canonical Spark repository and fresh 16..64 character ASCII session are required",
    )
  }
}

///|
/// Pure, reviewable launch description. No filesystem, Docker, CUDA or
/// rendezvous operation is performed here; the caller reads only the small spec.
fn launch_plan(
  spec : LaunchSpec,
  repo : String,
  rank : Int32,
  session : String,
) -> Json raise {
  validate_spec(spec)
  validate_route(repo, rank, session)
  let output = repo +
    "/runs/spark-native-bounded-ddp-gate-" +
    session +
    "/rank-\{rank}"
  {
    "format": "moonrobo.spark-native-bounded-ddp-plan.v1",
    "plan_only": true,
    "read_only": true,
    "gpu_allocated": false,
    "ticket_generated": false,
    "image_presence_checked": false,
    "staged_asset_hashes_checked": false,
    "ssh_authentication_created": false,
    "spec": Json(spec),
    "resolved_host_trainer": repo + "/" + trainer_relative_path(spec),
    "rank": rank,
    "world_size": 2,
    "session_id": session,
    "repository": repo,
    "output": output,
    "base_seed": 179,
    "collection_seed": rank + 179,
    "config": gate_config(),
    "profile_scope": "N4 / microbatch2 / compact replay / bounded gather / stream-v2 / fixed forty-motion LAFAN1 / one optimizer iteration",
    "first_step_on_178": {
      "program": "moon",
      "arguments": Json([
        "run",
        "--target",
        "native",
        "scripts/forward_native_nccl_id.mbtx",
        "--",
        "/home/wlc003s/moonrobo",
        session,
        "--data-ready-timeout-seconds",
        spec.data_ready_timeout_seconds.to_string(),
      ]),
      "start_once_before_both_rank_launchers": true,
      "requires_existing_authenticated_control_socket": "/home/wlc003s/moonrobo/private/ssh-179.sock",
      "new_authentication_created": false,
    },
    "coordinator_receipt_required_before_launch": repo +
    "/private/" +
    session +
    ".id.json.data-ready-coordinator.json",
    "rendezvous": {
      "host_path": repo + "/private/" + session + ".id.json",
      "container_path": "/rendezvous/" + session + ".id.json",
      "ticket_published_after_both_ranks_prepare_and_identity_matches": true,
      "ticket_timeout_seconds": 60,
      "preparation_timeout_seconds": spec.data_ready_timeout_seconds,
      "preparation_deadline_scope": "shared coordinator deadline beginning when the forwarder starts; not renewed per rank",
      "ordinary_failure_marker_propagation": true,
      "sigkill_or_oom_peer_detection": "bounded coordinator deadline or external container watchdog; immediate propagation is not guaranteed",
    },
    "container": {
      "image": image_id,
      "pull": "never",
      "architecture": "arm64",
      "memory_limit_bytes": Json(memory_limit),
      "extra_swap_bytes": 0,
      "cpus": 4,
      "shared_memory_bytes": Json(1073741824L),
      "network": "host",
      "nccl_net": "IB",
      "interface": if rank == 0 {
        "enp1s0f1np1"
      } else {
        "enp1s0f0np0"
      },
      "hca": if rank == 0 {
        "rocep1s0f1:1"
      } else {
        "rocep1s0f0:1"
      },
      "user": "ordinary account UID:GID read at launch",
      "read_only_repository_mount": repo,
      "writable_mounts": Json([repo + "/private", output]),
    },
    "trainer_program": "/usr/bin/timeout",
    "launcher_target_required": "native",
    "trainer_arguments": Json(trainer_arguments(spec, rank, session)),
    "combined_trainer_deadline_seconds": spec.data_ready_timeout_seconds + 300,
    "post_preparation_budget_seconds": 300,
    "training_phase_deadline_independently_enforced": false,
    "attach_deadline_seconds": spec.data_ready_timeout_seconds + 345,
    "memory_admission_percent": 65,
    "memory_guard_bypassed": false,
    "memory_peak_scope": "actual kernel cumulative cgroup peak sampled before helper exit; missing final samples stay unknown",
    "complete_lifetime_peak_certified": false,
    "sdk_numerical_parity_verified": false,
    "benchmark": false,
  }
}

///|
async fn file_sha(path : String, bound : Int64) -> String {
  guard @fs.kind(path, follow_symlink=false) == Regular else {
    fail("required staged input is not a regular file: " + path)
  }
  let file = @fs.open(path, mode=ReadOnly)
  defer file.close()
  let size = file.size()
  guard size > 0L && size <= bound else {
    fail("staged input size exceeds gate envelope: " + path)
  }
  let hash = @crypto.SHA256::new()
  for offset = 0L; offset < size; {
    let count = (size - offset).min(65536L).to_int()
    hash.update(file.read_exactly_at(count, position=offset))
    continue offset + count.to_int64()
  }
  guard file.size() == size else {
    fail("pinned input changed size while hashing: " + path)
  }
  @crypto.bytes_to_hex_string(hash.finalize())
}

///|
fn safe_session(value : String) -> Bool {
  value.length() >= 16 &&
  value.length() <= 64 &&
  value
  .iter()
  .all(c => {
    (c >= 'a' && c <= 'z') ||
    (c >= 'A' && c <= 'Z') ||
    (c >= '0' && c <= '9') ||
    c == '-' ||
    c == '_'
  })
}

///|
fn field(value : Json, name : String) -> Json raise {
  guard value is Object(fields) && fields.get(name) is Some(result) else {
    fail("required JSON field missing: " + name)
  }
  result
}

///|
fn error_message(error : Error) -> String {
  match error {
    Failure(message) => message
    _ => error.to_string()
  }
}

///|
fn integer(value : Json) -> Int64 raise {
  match value {
    String(text) => @string.parse_int64(text)
    Number(value, ..) => {
      guard value >= 0 &&
        value <= 9007199254740991.0 &&
        value.to_int64().to_double() == value else {
        fail("invalid exact nonnegative integer")
      }
      value.to_int64()
    }
    _ => fail("expected integer or decimal integer string")
  }
}

///|
/// Explicit Json(Some(value)) uses a one-element array. This differs from
/// derived record fields of type Option, which encode the present value itself.
fn required_some(value : Json, label : String) -> Json raise {
  guard value is Array(values) && values.length() == 1 else {
    fail("required MoonBit Some value missing or malformed: " + label)
  }
  values[0]
}

///|
/// Keeps the two serializers' different Option representations in regression
/// coverage without changing either existing training-report schema.
struct OptionEncodingProbe {
  value : Json?
} derive(ToJson)

///|
async fn bounded_json(path : String, limit : Int64) -> Json {
  guard @fs.kind(path, follow_symlink=false) == Regular else {
    fail("JSON input must be a regular file: " + path)
  }
  let file = @fs.open(path, mode=ReadOnly)
  defer file.close()
  let size = file.size()
  guard size > 0L && size <= limit else {
    fail("JSON input exceeds bound: " + path)
  }
  let bytes = file.read_exactly_at(size.to_int(), position=0L)
  guard file.size() == size else {
    fail("JSON input size changed while reading: " + path)
  }
  @json.parse(@utf8.decode(bytes))
}

///|
async fn write_json(path : String, value : Json) -> Unit {
  @fs.write_file(
    path,
    value.stringify(indent=2) + "\n",
    create_mode=CreateNew,
    sync=Full,
  )
}

///|
async fn checked_output(program : String, args : Array[String]) -> String {
  let result = @shell.Cmd(program, args).output(
    timeout_ms=10000,
    max_output_bytes=16384,
  )
  result.check()
  result.stdout().trim().to_owned()
}

///|
async fn now_unix_ms() -> Int64 {
  @string.parse_int64(checked_output("/usr/bin/date", ["+%s"])) * 1000L
}

