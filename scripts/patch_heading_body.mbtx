import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/fs" }
let root="/Users/kq/Workspace/moonrobo/"
async fn edit(path : String, changes : Array[(String,String)]) -> Unit {
  let mut s=@fs.read_file(root+path).text()
  for (a,b) in changes { if b!="" && s.contains(b) {continue};if b=="" && !s.contains(a){continue};guard s.contains(a) else {fail(path+": "+a)};s=s.replace_all(old=a,new=b) }
  @fs.write_file(root+path,s)
}
async fn main {
  edit("src/learning_tensor/adapter.cpp",[("#include \"compact_rotation.inc\"","#include \"compact_rotation.inc\"\n#include \"compact_heading.inc\"")])
  edit("src/learning_tensor/loader.c",[("#include \"compact_rotation_loader.inc\"","#include \"compact_rotation_loader.inc\"\n#include \"compact_heading_loader.inc\"")])
  edit("src/learning_tensor/moon.pkg",[("    \"compact_rotation.mbt\":","    \"compact_heading.mbt\": [ \"native\" ],\n    \"compact_rotation.mbt\":")])
  edit("src/learning_aligned_gpu/geometry/moon.pkg",[("    \"context.mbt\":","    \"body_errors.mbt\": [ \"native\" ],\n    \"body_errors_test.mbt\": [ \"native\" ],\n    \"compact_heading_wbtest.mbt\": [ \"native\" ],\n    \"context.mbt\":")])
  edit("src/learning_aligned_gpu/execution_optimizations.mbt",[("  static_fk_pruning : Bool","  static_fk_pruning : Bool\n  compact_heading : Bool\n  body_errors_batched : Bool"),("    static_fk_pruning: false,","    static_fk_pruning: false,\n    compact_heading: false,\n    body_errors_batched: false,")])
  edit("src/learning_aligned_gpu/cmd/optimizations.mbt",[("    static_fk_pruning: setting(config, \"static_fk_pruning\", false),","    static_fk_pruning: setting(config, \"static_fk_pruning\", false),\n    compact_heading: setting(config, \"compact_heading\", false),\n    body_errors_batched: setting(config, \"body_errors_batched\", false),"),("  if s.optimizations.world_norm_snapshot {","  if s.optimizations.compact_heading {\n    values[\"execution_compact_heading\"] = 67108864L.max(128L * (c.horizon.to_int64()+1L) * actor_rows.to_int64())\n  }\n  if s.optimizations.body_errors_batched {\n    values[\"execution_body_errors_batched\"] = 67108864L.max(128L * 64L * (c.horizon.to_int64()+1L) * actor_rows.to_int64())\n  }\n  if s.optimizations.world_norm_snapshot {")])
  edit("src/learning_aligned_gpu/geometry/context.mbt",[("  static_fk_pruning : Bool","  static_fk_pruning : Bool\n  compact_heading : Bool\n  body_errors_batched : Bool"),("    static_fk_pruning: false,","    static_fk_pruning: false,\n    compact_heading: false,\n    body_errors_batched: false,"),("mode=self.heading_mode","mode=self.heading_mode, compact=self.compact_heading"),("heading_mode=self.heading_mode, compact=self.compact_heading)","heading_mode=self.heading_mode, compact_heading=self.compact_heading)"),("  for i, body in bodies {\n    let ref_body = refs[i]","  for i, body in bodies {\n    let ref_body = refs[i]\n    if !self.body_errors_batched {"),("    if !self.body_orientation_batched {","    }\n    if !self.body_orientation_batched {"),("    vs.push(\n","    if !self.body_errors_batched {\n    vs.push(\n"),("  let ep = columns(self.backend, ps).mean_dim(1, keepdim=true)","  }\n  let (ep, ev, ew) = if self.body_errors_batched {\n    self.batched_body_errors(dr, anchor, reference, bodies, refs)\n  } else {\n    (columns(self.backend, ps).mean_dim(1, keepdim=true), columns(self.backend, vs).mean_dim(1, keepdim=true), columns(self.backend, ws).mean_dim(1, keepdim=true))\n  }"),("  let ev = columns(self.backend, vs).mean_dim(1, keepdim=true)\n  let ew = columns(self.backend, ws).mean_dim(1, keepdim=true)\n","")])
  edit("src/learning_aligned_gpu/geometry/rotations.mbt",[("  mode~ : HeadingMode = StableFallback,\n)","  mode~ : HeadingMode = StableFallback,\n  compact~ : Bool = false,\n)"),("  let x = entry(r, 0)\n  let y = entry(r, 3)","  if compact && mode == SmcProjected { return r.compact_heading() }\n  let x = entry(r, 0)\n  let y = entry(r, 3)")])
  edit("src/learning_aligned_gpu/geometry/state.mbt",[("  heading_mode~ : HeadingMode = StableFallback,","  heading_mode~ : HeadingMode = StableFallback,\n  compact_heading~ : Bool = false,"),("mode=heading_mode)","mode=heading_mode, compact=compact_heading)"),("invariant_features(backend, s, heading_mode~)","invariant_features(backend, s, heading_mode~, compact_heading~)"),("predicted, heading_mode~, smc_rotation~)","predicted, heading_mode~, compact_heading~, smc_rotation~)")])
  for path in ["learning.mbt","microbatch.mbt","actor_microbatch.mbt"] {
    edit("src/learning_aligned_gpu/"+path,[("heading_mode=self.optimizations.heading_mode,","heading_mode=self.optimizations.heading_mode,\n        compact_heading=self.optimizations.compact_heading,")])
  }
  edit("src/learning_aligned_gpu/learning.mbt",[("    .with_static_fk_pruning(optimizations.static_fk_pruning)","    .with_static_fk_pruning(optimizations.static_fk_pruning)\n    .with_compact_heading(optimizations.compact_heading)\n    .with_body_errors_batched(optimizations.body_errors_batched)")])
  let template=@fs.read_file(root+"src/learning_aligned_gpu/geometry/body_orientation_test.mbt").text()
  let code=template.replace_all(old="batched body quaternion log",new="batched body position and velocities").replace_all(old="body_orientation",new="body_errors")
  @fs.write_file(root+"src/learning_aligned_gpu/geometry/body_errors_test.mbt","///|\n"+code,create_mode=CreateNew)
}
