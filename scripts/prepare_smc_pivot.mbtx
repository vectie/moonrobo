import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/fs", "moonbitlang/async@0.20.2/process" }
async fn run(cmd : String, args : Array[String]) -> Unit { guard @process.run(cmd,args)==0 else {fail(cmd)} }
fn replace(s : String, a : String, b : String) -> String raise { guard s.contains(a) else {fail(a)}; s.replace_all(old=a,new=b) }
async fn main {
  let repo="/Users/kq/Workspace/moonrobo"
  let out=repo+"/output/spark-runtime-20261024/smc-heading-20261027"
  let base="/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host="wlc004s@192.168.2.179"
  let socket="/tmp/moonrobo-operator-179.sock"
  let mut fixture=@fs.read_file(out+"/heading_fixture_a.mbt").text()
  fixture=replace(fixture,"@env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"heading\")","(@env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"heading\") || @env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"pivot\"))")
  fixture=replace(fixture,"      reuse_geometry: true,","      zero_joint_pivot: @env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"pivot\"),\n      reuse_geometry: true,")
  @fs.write_file(out+"/heading_fixture_b.mbt",fixture,create_mode=CreateNew)
  let mut builder=@fs.read_file(out+"/build_heading_a.mbtx").text()
  for (a,b) in [("smc-heading-a","smc-heading-b"),("smc-heading-gate-a","smc-heading-gate-b"),("smc-heading-tensor-a","smc-heading-tensor-b"),("smc-heading-runtime-a","smc-heading-runtime-b"),("smc-heading-tests-a","smc-heading-tests-b"),("smc-heading-geometry-cpu-a","smc-heading-geometry-cpu-b"),("smc-heading-config-cpu-a","smc-heading-config-cpu-b"),("smc-heading-resume-cpu-a","smc-heading-resume-cpu-b"),("smc-heading-inference-cpu-a","smc-heading-inference-cpu-b")] {builder=replace(builder,a,b)}
  builder=replace(builder,"    container(\"smc-heading-config-cpu-b\"","    container(\"smc-heading-pivot-cpu-b\", \"/workspace/moonrobo-smc-heading-b/_build/native/release/test/vectie/moonrobo/src/learning_aligned_gpu/geometry/geometry.blackbox_test.exe\", [\"geometry_test.mbt:0-1\"])\n    container(\"smc-heading-config-cpu-b\"")
  @fs.write_file(out+"/build_heading_b.mbtx",builder,create_mode=CreateNew)
  let mut driver=@fs.read_file(out+"/run_heading_a.mbtx").text()
  for (a,b) in [("smc-heading-gate-a","smc-heading-gate-b"),("run_heading_a.mbtx","run_heading_b.mbtx"),("build_heading_a.mbtx","build_heading_b.mbtx"),("heading_fixture_a.mbt","heading_fixture_b.mbt"),("\"linear\", \"heading\"","\"linear\", \"heading\", \"pivot\"")] {driver=replace(driver,a,b)}
  @fs.write_file(out+"/run_heading_b.mbtx",driver,create_mode=CreateNew)
  let wrapper=replace(@fs.read_file(out+"/invoke_heading_a.mbtx").text(),"run_heading_a.mbtx","run_heading_b.mbtx")
  @fs.write_file(out+"/invoke_heading_b.mbtx",wrapper,create_mode=CreateNew)
  for file in ["heading_fixture_b.mbt","build_heading_b.mbtx","run_heading_b.mbtx","invoke_heading_b.mbtx"] {
    run("scp",["-o","ControlPath="+socket,out+"/"+file,host+":"+base+"/"+file])
  }
  run("ssh",["-S",socket,host,"test ! -e "+base+"/workspace/moonrobo-smc-heading-b"])
  run("ssh",["-S",socket,host,"cp -a --reflink=auto "+base+"/workspace/moonrobo-smc-heading-a "+base+"/workspace/moonrobo-smc-heading-b"])
  for path in ["execution_optimizations.mbt","learning.mbt","geometry/context.mbt","geometry/geometry_test.mbt","geometry/moon.pkg","cmd/optimizations.mbt","cmd/optimizations_wbtest.mbt"] {
    run("scp",["-o","ControlPath="+socket,repo+"/src/learning_aligned_gpu/"+path,host+":"+base+"/workspace/moonrobo-smc-heading-b/src/learning_aligned_gpu/"+path])
  }
  run("ssh",["-S",socket,host,"cp "+base+"/heading_fixture_b.mbt "+base+"/workspace/moonrobo-smc-heading-b/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt"])
  for mode in ["gate-build-smc-heading-b","smc-heading-tests-b"] {
    run("ssh",["-S",socket,host,"env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native "+base+"/build_heading_b.mbtx -- "+mode])
  }
}
