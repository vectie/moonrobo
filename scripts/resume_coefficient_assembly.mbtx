  s=s.replace_all(old=original,new=release)
  @fs.write_file(dir+"/coefficient_assembly_suite_b.mbtx",s,create_mode=CreateNew)
  let p=dir+"/report.mbtx";let r=@fs.read_file(p).text();let old="{\"coefficient-assembly-\"+v+\"-\"+p+\"-\"+k+\"-a\"}";guard r.contains(old)else{fail("report label")}
  @fs.write_file(p,r.replace_all(old=old,new="{\"coefficient-assembly-\"+v+\"-\"+p+\"-\"+k+(if p==\"world\"&&v==\"forward\"&&k==\"gate\"{\"-b\"}else{\"-a\"})}"))
