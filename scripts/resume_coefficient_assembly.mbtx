    #|      let path=dir+"/"+file;guard @fs.realpath(path)==path&&@fs.kind(path,follow_symlink=false)==Regular else{fail("regular output")}
    #|      let f=@fs.open(path,mode=ReadOnly);bytes+=f.size();f.close();guard bytes<=2147483648L else{fail("2GiB per-call bound")}
