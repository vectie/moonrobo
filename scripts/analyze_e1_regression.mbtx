///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/math",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
}

///|
fn[T : FromJson] field(v : Json, k : String) -> T raise {
  guard v is Object(f) && f.get(k) is Some(x) else { fail(k) }
  @json.from_json(x)
}

///|
async fn read(path : String) -> Json {
  @json.parse(@utf8.decode(@fs.read_file(path).binary()))
}

///|
async fn sha(path : String) -> String {
  let h = @crypto.SHA256::new()
  h.update(@fs.read_file(path).binary())
  @crypto.bytes_to_hex_string(h.finalize())
}

///|
fn norm_drift(base : Json, current : Json) -> Json raise {
  let a : Array[Double] = field(base, "mean")
  let b : Array[Double] = field(current, "mean")
  let va : Array[Double] = field(base, "variance")
  let vb : Array[Double] = field(current, "variance")
  let mut square = 0.0
  let mut log_square = 0.0
  let mut maximum = 0.0
  for i in 0..<a.length() {
    let z = (b[i] - a[i]) / (va[i] + 0.0001).sqrt()
    square += z * z
    maximum = maximum.max(z.abs())
    let d = 0.5 * @math.ln((vb[i] + 0.0001) / (va[i] + 0.0001))
    log_square += d * d
  }
  {
    "mean_shift_rms_in_baseline_std": (square / a.length().to_double()).sqrt(),
    "max_mean_shift_in_baseline_std": maximum,
    "log_std_ratio_rms": (log_square / a.length().to_double()).sqrt(),
    "count": (field(current, "count") : Double),
  }
}

///|
fn plot_group(
  title : String,
  values : Array[Json],
  y_title : String,
  ymax : Double,
  top : Int32,
  log_scale~ : Bool = false,
  y_min~ : Double = 0.001,
) -> Json {
  {
    "type": "group",
    "encode": {
      "enter": {
        "x": { "value": 65 },
        "y": { "value": top },
        "width": { "value": 720 },
        "height": { "value": 180 },
      },
    },
    "title": { "text": title, "anchor": "start", "fontSize": 15 },
    "data": [{ "name": "rows", "values": values }],
    "scales": [
      {
        "name": "x",
        "type": "linear",
        "domain": [0, 6500],
        "range": [0, 720],
        "zero": true,
      },
      {
        "name": "y",
        "type": if log_scale {
          "log"
        } else {
          "linear"
        },
        "domain": if log_scale {
          Json([y_min, ymax])
        } else {
          Json([0.0, ymax])
        },
        "range": [180, 0],
        "zero": !log_scale,
      },
      {
        "name": "color",
        "type": "ordinal",
        "domain": { "data": "rows", "field": "series" },
        "range": [
          "#007c91", "#c85b27", "#7355a0", "#699c35", "#bb4e82", "#756d5d",
        ],
      },
    ],
    "axes": [
      {
        "scale": "x",
        "orient": "bottom",
        "title": "Training iteration",
        "tickCount": 7,
      },
      {
        "scale": "y",
        "orient": "left",
        "title": y_title,
        "grid": true,
        "tickCount": 5,
        "format": if log_scale {
          ".2~g"
        } else {
          ".2~f"
        },
      },
    ],
    "legends": [
      {
        "stroke": "color",
        "orient": "top",
        "direction": "horizontal",
        "title": null,
        "labelFontSize": 11,
      },
    ],
    "marks": [
      {
        "type": "rule",
        "encode": {
          "enter": {
            "x": { "scale": "x", "value": 4000 },
            "y": { "value": 0 },
            "y2": { "value": 180 },
            "stroke": { "value": "#999" },
            "strokeDash": { "value": [4, 4] },
          },
        },
      },
      {
        "type": "group",
        "from": {
          "facet": { "name": "series", "data": "rows", "groupby": "series" },
        },
        "marks": [
          {
            "type": "line",
            "from": { "data": "series" },
            "encode": {
              "enter": {
                "x": { "scale": "x", "field": "iteration" },
                "y": { "scale": "y", "field": "value" },
                "stroke": { "scale": "color", "field": "series" },
                "strokeWidth": { "value": 2 },
              },
            },
          },
          {
            "type": "symbol",
            "from": { "data": "series" },
            "encode": {
              "enter": {
                "x": { "scale": "x", "field": "iteration" },
                "y": { "scale": "y", "field": "value" },
                "fill": { "scale": "color", "field": "series" },
                "size": { "value": 22 },
              },
            },
          },
        ],
      },
    ],
  }
}

///|
async fn write_json(path : String, value : Json) -> Unit {
  @fs.write_file(
    path,
    @utf8.encode(value.stringify(indent=2)),
    create_mode=CreateOrTruncate,
  )
}

///|
async fn main {
  guard @env.args() is [_, root] else { fail("audit directory required") }
  let reference = read(root + "/generation-4000/checkpoint.json")
  let identity : Json = field(reference, "identity")
  let base_learner : Json = field(reference, "learner")
  let base_norms : Array[Json] = field(base_learner, "normalizers")
  let first_train = read(root + "/evaluation-500/train.json")
  let clips : Array[Json] = field(first_train, "per_clip")
  let names : Array[String] = clips.map(c => field(c, "clip_id"))
  let bin_counts : Array[Int32] = clips.map(c => {
    ((field(c, "expected_steps") : Int32) - 1) / 50 + 1
  })
  let bin_total = bin_counts.fold(init=0, (a, b) => a + b)
  let checkpoint_rows : Array[Json] = []
  let norm_plot : Array[Json] = []
  let sampler_plot : Array[Json] = []
  let mut identity_equal = true
  let mut base_prob : Array[Double] = []
  let base_returns : Array[Double] = field(reference, "sampler_returns")
  let base_average : Array[Double] = field(reference, "sampler_average")
  let base_logits = base_returns.map(v => -2.5 * v)
  let max_logit = base_logits.fold(init=base_logits[0], (a, b) => a.max(b))
  let soft = base_logits.map(v => @math.exp(v - max_logit))
  let soft_sum = soft.fold(init=0.0, (a, b) => a + b)
  let avg_sum = base_average.fold(init=0.0, (a, b) => a + b)
  base_prob = Array::makei(bin_total, i => {
    0.5 / bin_total.to_double() +
    0.4 * soft[i] / soft_sum +
    0.1 * base_average[i] / avg_sum
  })
  for iteration = 100; iteration <= 6500; iteration = iteration + 100 {
    let path = root +
      "/generation-" +
      iteration.to_string() +
      "/checkpoint.json"
    if !@fs.exists(path) {
      continue
    }
    let saved = read(path)
    let learner : Json = field(saved, "learner")
    identity_equal = identity_equal &&
      (field(saved, "identity") : Json) == identity
    let norms : Array[Json] = field(learner, "normalizers")
    let od = norm_drift(base_norms[2], norms[2])
    let gd = norm_drift(base_norms[3], norms[3])
    norm_plot.push({
      "iteration": iteration,
      "series": "Observation mean drift",
      "value": (field(od, "mean_shift_rms_in_baseline_std") : Double),
    })
    norm_plot.push({
      "iteration": iteration,
      "series": "Goal mean drift",
      "value": (field(gd, "mean_shift_rms_in_baseline_std") : Double),
    })
    let returns : Array[Double] = field(saved, "sampler_returns")
    let average : Array[Double] = field(saved, "sampler_average")
    let completed : Array[Int32] = field(saved, "sampler_completed")
    assert_eq(returns.length(), bin_total)
    let logits = returns.map(v => -2.5 * v)
    let mx = logits.fold(init=logits[0], (a, b) => a.max(b))
    let exp = logits.map(v => @math.exp(v - mx))
    let sum = exp.fold(init=0.0, (a, b) => a + b)
    let hist = average.fold(init=0.0, (a, b) => a + b)
    let probabilities = Array::makei(bin_total, i => {
      0.5 / bin_total.to_double() + 0.4 * exp[i] / sum + 0.1 * average[i] / hist
    })
    let tv = Array::makei(bin_total, i => {
        (probabilities[i] - base_prob[i]).abs()
      }).fold(init=0.0, (a, b) => a + b) *
      0.5
    let masses : Array[Json] = []
    let mut offset = 0
    for i, name in names {
      let count = bin_counts[i]
      let mass = probabilities[offset:offset + count].fold(init=0.0, (a, b) => {
        a + b
      })
      let events = completed[offset:offset + count].fold(init=0, (a, b) => a + b)
      masses.push({
        "clip": name,
        "probability": mass,
        "completed_episodes": events,
      })
      sampler_plot.push({
        "iteration": iteration,
        "series": name,
        "value": mass,
      })
      offset += count
    }
    let runtime : Json = field(saved, "runtime")
    checkpoint_rows.push({
      "iteration": iteration,
      "obs_drift": od,
      "goal_drift": gd,
      "sampler_total_variation_from4000": tv,
      "reset_probability_by_clip": masses,
      "counters": (field(runtime, "counters") : Json),
    })
  }
  let evaluation_rows : Array[Json] = []
  let evaluation_plot : Array[Json] = []
  let clip_plot : Array[Json] = []
  let mut evaluation_contract_equal = true
  let mut actor_binding_equal = true
  for iteration = 500; iteration <= 6500; iteration = iteration + 500 {
    let dir = root + "/evaluation-" + iteration.to_string()
    if !@fs.exists(dir + "/validation.json") {
      continue
    }
    let actor = read(dir + "/actor/actor.json")
    let checkpoint = read(
      root + "/generation-" + iteration.to_string() + "/checkpoint.json",
    )
    let learner : Json = field(checkpoint, "learner")
    let norms : Array[Json] = field(learner, "normalizers")
    let spec : Json = field(actor, "spec")
    actor_binding_equal = actor_binding_equal &&
      (field(actor, "identity") : Json) == identity &&
      (field(spec, "obs_norm") : Json) == norms[2] &&
      (field(spec, "goal_norm") : Json) == norms[3] &&
      (field(actor, "source_checkpoint_sha256") : String) ==
      sha(root + "/generation-" + iteration.to_string() + "/checkpoint.json")
    for split in ["train", "validation"] {
      let report = read(dir + "/" + split + ".json")
      let initial_report = read(root + "/evaluation-500/" + split + ".json")
      evaluation_contract_equal = evaluation_contract_equal &&
        (field(report, "protocol") : Json) ==
        (field(initial_report, "protocol") : Json) &&
        (field(report, "tensor_library_sha256") : String) ==
        (field(initial_report, "tensor_library_sha256") : String) &&
        (field(report, "mujoco_library_sha256") : String) ==
        (field(initial_report, "mujoco_library_sha256") : String) &&
        (field(report, "full_catalog_evaluated") : Bool) &&
        (field(report, "benchmark_complete") : Bool)
      actor_binding_equal = actor_binding_equal &&
        (field(report, "actor_metadata_sha256") : String) ==
        sha(dir + "/actor/actor.json") &&
        (field(report, "actor_archive_sha256") : String) ==
        (field(actor, "archive_sha256") : String)
      let rows : Array[Json] = field(report, "per_clip")
      let initial_rows : Array[Json] = field(initial_report, "per_clip")
      assert_eq(rows.length(), initial_rows.length())
      for i, row in rows {
        evaluation_contract_equal = evaluation_contract_equal &&
          (field(row, "clip_id") : String) ==
          (field(initial_rows[i], "clip_id") : String) &&
          (field(row, "expected_steps") : Int32) ==
          (field(initial_rows[i], "expected_steps") : Int32)
        let label = match (field(row, "clip_id") : String) {
          "vendor-0_boxing" => "Boxing (train)"
          "vendor-02_boxing" => "Boxing (held out)"
          "g1-jumps1_subject5" => "Jump"
          "g1-run2_subject4" => "Run"
          "g1-sprint1_subject2" => "Sprint"
          _ => "Walk"
        }
        clip_plot.push({
          "iteration": iteration,
          "series": label,
          "value": (field(row, "normalized_return") : Double),
        })
      }
      evaluation_plot.push({
        "iteration": iteration,
        "series": split,
        "value": (field(report, "norm_return") : Double),
      })
      evaluation_rows.push({
        "iteration": iteration,
        "split": split,
        "score": (field(report, "norm_return") : Double),
        "frame_weighted_score": (field(report, "norm_return_framew") : Double),
        "completed": (field(report, "n_completed") : Int32),
        "clips": (field(report, "n_clips") : Int32),
        "per_clip": rows,
      })
    }
  }
  let metrics : Map[Int32, Array[Json]] = Map([])
  let log = @utf8.decode(@fs.read_file(root + "/training.log").binary())
  let mut extra_collection = 0L
  for line in log.split("\n") {
    guard line.find("{") is Some(at) else { continue }
    let row = @json.parse(line[at:]) catch { _ => continue }
    if row is { "iteration": Number(n, ..), "world": _, .. } {
      let bucket = (n.to_int() - 1) / 100
      if !metrics.contains(bucket) {
        metrics[bucket] = []
      }
      metrics[bucket].push(row)
      let readiness : Json = field(row, "actor_readiness")
      if readiness is Array(items) {
        for item in items {
          extra_collection += (field(item, "extra_physical_transitions") : Int64)
        }
      }
    }
  }
  let training_rows : Array[Json] = []
  let wm_plot : Array[Json] = []
  let policy_plot : Array[Json] = []
  let critic_plot : Array[Json] = []
  for bucket in 0..<70 {
    guard metrics.get(bucket) is Some(rows) else { continue }
    let mut wm = 0.0
    let mut err = 0.0
    let mut lr = 0.0
    let mut pi = 0.0
    let mut critic = 0.0
    let mut reward = 0.0
    let mut survival = 0.0
    let mut actors = 0
    for row in rows {
      let world : Json = field(row, "world")
      wm += (field(world, "wm_loss") : Double)
      err += (field(world, "wm_err8") : Double)
      lr += (field(row, "learning_rate") : Double)
      let policy : Json = field(row, "policy")
      if policy is Object(_) {
        actors += 1
        pi += (field(policy, "pi_loss") : Double)
        critic += (field(policy, "v_loss") : Double)
        reward += (field(policy, "imagined_reward") : Double)
        survival += (field(policy, "imagined_survival") : Double)
      }
    }
    let count = rows.length().to_double()
    let a = actors.to_double().max(1.0)
    let iteration : Int32 = field(rows[rows.length() - 1], "iteration")
    training_rows.push({
      "iteration": iteration,
      "count": rows.length(),
      "wm_loss": wm / count,
      "wm_err8": err / count,
      "lr": lr / count,
      "actor_count": actors,
      "pi_loss": pi / a,
      "critic_loss": critic / a,
      "imagined_reward": reward / a,
      "imagined_survival": survival / a,
    })
    wm_plot.push({
      "iteration": iteration,
      "series": "WM eight-step error",
      "value": err / count,
    })
    if actors > 0 {
      policy_plot.push({
        "iteration": iteration,
        "series": "Imagined normalized reward",
        "value": reward / a,
      })
      policy_plot.push({
        "iteration": iteration,
        "series": "Imagined survival (short horizon)",
        "value": survival / a,
      })
      critic_plot.push({
        "iteration": iteration,
        "series": "Critic loss",
        "value": critic / a,
      })
    }
  }
  let report : Json = {
    "checkpoint_identities_equal": identity_equal,
    "evaluation_contracts_equal": evaluation_contract_equal,
    "actor_bindings_equal": actor_binding_equal,
    "extra_actor_readiness_physical_transitions": extra_collection,
    "evaluation": evaluation_rows,
    "training_100_iteration_means": training_rows,
    "checkpoints": checkpoint_rows,
    "scope": "checkpoint snapshots and fixed full-clip evaluations; training losses are on changing on-policy replay, not a fixed validation set",
  }
  write_json(root + "/analysis.json", report)
  let common : Json = {
    "$schema": "https://vega.github.io/schema/vega/v6.json",
    "width": 820,
    "height": 560,
    "padding": 15,
    "background": "white",
    "config": {
      "font": "Arial",
      "axis": {
        "labelFontSize": 11,
        "titleFontSize": 12,
        "gridColor": "#eeeeee",
        "domainColor": "#888",
      },
    },
  }
  guard common is Object(spec) else { fail("plot") }
  spec["marks"] = Json([
    plot_group(
      "Fixed full-motion evaluation: train and held-out boxing", evaluation_plot,
      "Normalized return", 1.0, 50,
    ),
    plot_group(
      "Per-motion evaluation (same full-duration denominator)", clip_plot, "Normalized return",
      1.0, 340,
    ),
  ])
  spec["height"] = Json(560)
  write_json(root + "/evaluation-curves.vg.json", common)
  spec["marks"] = Json([
    plot_group(
      "Training replay prediction error (100-iteration means)",
      wm_plot,
      "Eight-step error",
      3.0,
      50,
      log_scale=true,
      y_min=0.05,
    ),
    plot_group(
      "Policy imagination statistics (not full-clip survival)", policy_plot, "Normalized metric",
      1.05, 340,
    ),
    plot_group(
      "Critic fit on imagined targets",
      critic_plot,
      "Value loss",
      0.1,
      630,
      log_scale=true,
    ),
  ])
  spec["height"] = Json(850)
  write_json(root + "/training-curves.vg.json", common)
  let drift_max = norm_plot
    .map(row => (field(row, "value") : Double))
    .fold(init=0.2, (a, b) => a.max(b)) *
    1.1
  spec["marks"] = Json([
    plot_group(
      "Adaptive reset probability by training motion", sampler_plot, "Probability mass",
      0.7, 50,
    ),
    plot_group(
      "Actor input mean drift relative to checkpoint 4000", norm_plot, "RMS baseline std",
      drift_max, 340,
    ),
  ])
  spec["height"] = Json(560)
  write_json(root + "/distribution-curves.vg.json", common)
  println(
    "identities=" +
    identity_equal.to_string() +
    " protocols=" +
    evaluation_contract_equal.to_string() +
    " actor_bindings=" +
    actor_binding_equal.to_string() +
    " bins=" +
    bin_total.to_string(),
  )
  for row in evaluation_rows {
    println(
      "eval " +
      (field(row, "iteration") : Int32).to_string() +
      " " +
      (field(row, "split") : String) +
      " score=" +
      (field(row, "score") : Double).to_string() +
      " complete=" +
      (field(row, "completed") : Int32).to_string(),
    )
  }
  for row in checkpoint_rows {
    let it : Int32 = field(row, "iteration")
    if [3000, 3500, 4000, 4500, 5000, 5500, 6000].contains(it) {
      println(row.stringify())
    }
  }
}
