///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/process",
}

///|
// Continue only the pending arms; successful precision controls stay immutable.
async fn main {
  let closed = [
    "cost-ieee-events-d", "cost-ieee-off-a", "cost-corrected-off-a", "cost-smc-off-a",
    "cost-tail-abba-a", "cost-layout-abba-a",
  ]
  for
    i, (runner, kind, observer, label) in [
      ("a", "smc", "off", "cost-smc-off-c"),
      ("b", "native-abba-both", "off", "cost-both-abba-a"),
      ("a", "smc", "off", "cost-smc-off-b"),
      ("a", "smc-corrected", "off", "cost-corrected-off-b"),
      ("b", "native-both", "events", "cost-both-events-a"),
    ] {
    assert_eq(
      @process.run(
        "moon",
        [
          "run",
          "--target",
          "native",
          "scripts/reclaim_geometry_cost.mbtx",
          "--",
          "final_control_" + i.to_string(),
          ..closed,
        ],
      ),
      0,
    )
    assert_eq(
      @process.run("env", [
        "GEOMETRY_COST_RUNNER=" + runner,
        "moon",
        "run",
        "--target",
        "native",
        "scripts/run_geometry_cost.mbtx",
        "--",
        kind,
        observer,
        label,
      ]),
      0,
    )
    if runner == "b" {
      assert_eq(
        @process.run("moon", [
          "run", "--target", "native", "scripts/check_geometry_cost_snapshot.mbtx",
          "--", label,
        ]),
        0,
      )
    }
    closed.push(label)
    println("COMPLETED " + label)
  }
}
