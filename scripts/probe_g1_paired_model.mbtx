///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/async@0.20.2/io",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn field(value : Json, key : String) -> Json raise {
  guard value is Object(fields) && fields.get(key) is Some(value) else {
    fail("missing field: " + key)
  }
  value
}

///|
async fn main {
  let args = @env.args()
  assert_eq(
    args.length(),
    6,
    msg="usage: probe_g1_paired_model.mbtx REPO DATA_RUN ADAPTIVE_RUN OUTPUT SUMMARY_JSON",
  )
  let root = args[1]
  let output = args[4]
  assert_true(!@fs.exists(output), msg="choose a fresh probe directory")
  @fs.mkdir(output + "/provider-sources", recursive=true)
  for
    name in [
      "paired_model_probe.py", "actor_update_probe.py", "policy.py", "dynamics.py",
      "cpu_physics.py", "critic_probe.py",
    ] {
    @fs.write_file(
      output + "/provider-sources/" + name,
      @fs.read_file(root + "/providers/motion_learning/" + name).binary(),
      create_mode=CreateOrTruncate,
    )
  }
  let experiment = @json.parse(
    @fs.read_file(root + "/examples/learning/g1-goal-collection.json").text(),
  )
  guard experiment is Object(fields) else { fail("expected experiment") }
  fields.set("duration_s", 10)
  fields.set("action_noise_std_rad", 0)
  @fs.write_file(
    output + "/experiment.json",
    experiment.stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  @fs.write_file(
    output + "/config.json",
    @fs.read_file(root + "/examples/learning/g1-paired-model-probe.json").binary(),
    create_mode=CreateOrTruncate,
  )
  let (code, out, err) = native_collect_output(
    root + "/scripts/run_native_learning.mbtx",
    [
      output + "/provider-sources/paired_model_probe.py",
      "--train",
      args[2] + "/train-batch.json",
      "--initial",
      args[2] + "/fit/dynamics-seed-0.moon.json",
      "--adapted",
      args[3] + "/fit",
      "--policies",
      args[3] + "/policy",
      "--scene",
      root + "/target/mujoco_menagerie/unitree_g1/scene_mjx.xml",
      "--config",
      output + "/config.json",
      "--experiment",
      output + "/experiment.json",
      "--output",
      output,
    ],
  )
  @fs.write_file(
    output + "/probe.log",
    out.text() + err.text(),
    create_mode=CreateOrTruncate,
  )
  assert_eq(code, 0, msg=err.text())
  let summary = @json.parse(@fs.read_file(output + "/summary.json").text())
  assert_eq(field(summary, "maximum_restore_error"), (0 : Json))
  guard field(summary, "summaries") is Array(rows) else { fail("missing rows") }
  assert_eq(rows.length(), 84)
  for row in rows {
    if field(row, "multiplier") == (1 : Json) {
      println(
        (
          {
            "policy_seed": field(row, "policy_seed"),
            "model": field(row, "model"),
            "bootstrap": field(row, "direction_bootstrap"),
            "origins": field(row, "origins"),
            "omitted": field(row, "omitted_origins"),
            "predicted_reward": field(row, "predicted_recent_reward_change"),
            "predicted_bootstrapped": field(
              row, "predicted_recent_bootstrapped_change",
            ),
            "physical_reward": field(row, "physical_reward_change"),
            "physical_bootstrapped": field(row, "physical_bootstrapped_change"),
            "full_physical_reward": field(row, "full_physical_reward_change"),
            "full_improves_fraction": field(
              row, "full_reward_improves_fraction",
            ),
            "full_steps_change": field(row, "mean_full_steps_change"),
            "full_baseline_falls": field(row, "full_baseline_falls"),
            "full_candidate_falls": field(row, "full_candidate_falls"),
          } : Json).stringify(),
      )
    }
  }
  @fs.write_file(
    args[5],
    summary.stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  println(out.text())
}

///|
/// Checkpoint copies are validated or converted by the reviewed native loader.
fn native_checkpoint_copy_command(
  exe : String,
  args : Array[String],
) -> (String, Array[String])? raise {
  if exe != "/bin/cp" || args.length() < 2 {
    return None
  }
  if !args[0].has_suffix(".moon.json") &&
    !args[0].has_suffix(".pt") &&
    !args[1].has_suffix(".moon.json") {
    return None
  }
  guard args.length() == 2 && args[1].has_suffix(".moon.json") else {
    fail("checkpoint copies require SOURCE and native .moon.json DESTINATION")
  }
  let name = args[0].split("/").last().unwrap_or("").to_owned()
  let kind = if name.contains("dynamics-seed-") {
    "residual-dynamics"
  } else if name.contains("actor-seed-") {
    "g1-actor"
  } else {
    fail("unreviewed checkpoint copy kind: " + name)
  }
  let root = @env.args()[1]
  Some(
    (
      root,
      [
        "run",
        root + "/scripts/run_native_learning.mbtx",
        root,
        "src/learning_training/launch/cmd",
        "checkpoint-copy",
        args[0],
        args[1],
        kind,
      ],
    ),
  )
}

///|
/// Structured native dispatch. A .py argument is a reviewed provider descriptor, never an executable or an interpreter fallback.
async fn native_collect_output(
  exe : String,
  args : Array[String],
) -> (Int32, &@io.Data, &@io.Data) {
  let suffix = "/scripts/run_native_learning.mbtx"
  if exe.has_suffix(suffix) {
    let root = exe[:exe.length() - suffix.length()].to_owned()
    let command = ["run", exe, root, "src/learning_training/launch/cmd"]
    command.append(args)
    return @process.collect_output("moon", command, cwd=root)
  }
  if native_checkpoint_copy_command(exe, args) is Some((root, command)) {
    return @process.collect_output("moon", command, cwd=root)
  }
  @process.collect_output(exe, args)
}

///|
async fn native_process_run(
  exe : String,
  args : Array[String],
  stdout? : &@process.ProcessOutput,
  stderr? : &@process.ProcessOutput,
) -> Int32 {
  let suffix = "/scripts/run_native_learning.mbtx"
  if exe.has_suffix(suffix) {
    let root = exe[:exe.length() - suffix.length()].to_owned()
    let command = ["run", exe, root, "src/learning_training/launch/cmd"]
    command.append(args)
    return @process.run("moon", command, cwd=root, stdout?, stderr?)
  }
  if native_checkpoint_copy_command(exe, args) is Some((root, command)) {
    return @process.run("moon", command, cwd=root, stdout?, stderr?)
  }
  @process.run(exe, args, stdout?, stderr?)
}
