import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/fs", "moonbitlang/async@0.20.2/process" }
fn replace(s : String,a : String,b : String) -> String raise {guard s.contains(a) else {fail(a)};s.replace_all(old=a,new=b)}
async fn run(cmd : String,args : Array[String]) -> Unit {guard @process.run(cmd,args)==0 else {fail(cmd)}}
async fn main {
  let repo="/Users/kq/Workspace/moonrobo"
  let prev=repo+"/output/spark-runtime-20261024/smc-heading-20261027"
  let out=repo+"/output/spark-runtime-20261024/smc-algebra-20261028"
  @fs.mkdir(out,recursive=true)
  let base="/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host="wlc004s@192.168.2.179"
  let socket="/tmp/moonrobo-operator-179.sock"
  let mut fixture=@fs.read_file(prev+"/heading_fixture_b.mbt").text()
  let lines=fixture.split("\n").map(line => {
    let trim=line.trim()
    if trim.has_prefix("world_error_batched:") {"      world_error_batched: true,"}
    else if trim.has_prefix("sparse_joint_axis:") {"      sparse_joint_axis: true,"}
    else if trim.has_prefix("policy_linear_mode:") {"      policy_linear_mode: @gpu.NativeLinear,"}
    else if trim.has_prefix("critic_linear_mode:") {"      critic_linear_mode: @gpu.NativeLinear,"}
    else if trim.has_prefix("rotation_error_mode:") {"      rotation_error_mode: @geometry.TraceAcos,"}
    else if trim.has_prefix("heading_mode:") {"      heading_mode: @geometry.SmcProjected,"}
    else if trim.has_prefix("zero_joint_pivot:") {"      zero_joint_pivot: true,"}
    else {line.to_owned()}
  }).collect()
  fixture=lines.join("\n")
  for (key,variant) in [("smc_world_rotation","world"),("smc_xi_normalization","xi"),("smc_actor_return","return")] {
    fixture=replace(fixture,"      reuse_geometry: true,","      "+key+": @env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\""+variant+"\") || @env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"all\"),\n      reuse_geometry: true,")
  }
  fixture=replace(fixture,"heading_mode: Some(learner.optimizations.heading_mode)","heading_mode: Some(learner.optimizations.heading_mode), smc_world_rotation: Some(learner.optimizations.smc_world_rotation), smc_xi_normalization: Some(learner.optimizations.smc_xi_normalization), smc_actor_return: Some(learner.optimizations.smc_actor_return)")
  @fs.write_file(out+"/algebra_fixture_a.mbt",fixture,create_mode=CreateNew)
  let mut builder=@fs.read_file(prev+"/build_heading_b.mbtx").text()
  for (a,b) in [("smc-heading-b","smc-algebra-a"),("smc-heading-gate-b","smc-algebra-gate-a"),("smc-heading-tensor-b","smc-algebra-tensor-a"),("smc-heading-runtime-b","smc-algebra-runtime-a"),("smc-heading-tests-b","smc-algebra-tests-a"),("smc-heading-geometry-cpu-b","smc-algebra-geometry-cpu-a"),("smc-heading-pivot-cpu-b","smc-algebra-pivot-cpu-a"),("smc-heading-config-cpu-b","smc-algebra-config-cpu-a"),("smc-heading-resume-cpu-b","smc-algebra-resume-cpu-a"),("smc-heading-inference-cpu-b","smc-algebra-inference-cpu-a"),("libmoonrobo_mlp_b.so","libmoonrobo_smc_algebra_a.so"),("mlp-plugin-build-b","smc-algebra-plugin-a")] {builder=replace(builder,a,b)}
  builder=replace(builder,"    container(\"smc-algebra-geometry-cpu-a\"","    container(\"smc-algebra-primitive-cpu-a\", \"/build/smc-algebra-tensor-a\", [\"smc_algebra_test.mbt:0-3\"])\n    container(\"smc-algebra-geometry-cpu-a\"")
  @fs.write_file(out+"/build_algebra_a.mbtx",builder,create_mode=CreateNew)
  let mut driver=@fs.read_file(prev+"/run_heading_b.mbtx").text()
  for (a,b) in [("smc-heading-gate-b","smc-algebra-gate-a"),("run_heading_b.mbtx","run_algebra_a.mbtx"),("build_heading_b.mbtx","build_algebra_a.mbtx"),("heading_fixture_b.mbt","algebra_fixture_a.mbt"),("libmoonrobo_mlp_b.so","libmoonrobo_smc_algebra_a.so"),("\"heading\", \"pivot\"","\"heading\", \"pivot\", \"world\", \"xi\", \"return\", \"all\""),("hotspot-shared-heading-\" + phase","hotspot-shared-algebra-all-\" + phase")] {driver=replace(driver,a,b)}
  @fs.write_file(out+"/run_algebra_a.mbtx",driver,create_mode=CreateNew)
  let wrapper=replace(@fs.read_file(prev+"/invoke_heading_b.mbtx").text(),"run_heading_b.mbtx","run_algebra_a.mbtx")
  @fs.write_file(out+"/invoke_algebra_a.mbtx",wrapper,create_mode=CreateNew)
  for file in ["algebra_fixture_a.mbt","build_algebra_a.mbtx","run_algebra_a.mbtx","invoke_algebra_a.mbtx"] {
    run("scp",["-o","ControlPath="+socket,out+"/"+file,host+":"+base+"/"+file])
  }
  run("ssh",["-S",socket,host,"test ! -e "+base+"/workspace/moonrobo-smc-algebra-a"])
  run("ssh",["-S",socket,host,"cp -a --reflink=auto "+base+"/workspace/moonrobo-smc-heading-b "+base+"/workspace/moonrobo-smc-algebra-a"])
  for path in ["execution_optimizations.mbt","checkpoint.mbt","audit.mbt","audit_wbtest.mbt","precision_wbtest.mbt","learning.mbt","microbatch.mbt","actor_microbatch.mbt","world_error_batched.mbt","smc_algebra.mbt","moon.pkg","geometry/state.mbt","cmd/optimizations.mbt","cmd/optimizations_wbtest.mbt","inference/actor_wbtest.mbt"] {
    run("scp",["-o","ControlPath="+socket,repo+"/src/learning_aligned_gpu/"+path,host+":"+base+"/workspace/moonrobo-smc-algebra-a/src/learning_aligned_gpu/"+path])
  }
  for path in ["smc_algebra.inc","smc_algebra_loader.inc","smc_algebra.mbt","smc_algebra_test.mbt","adapter.cpp","loader.c","moon.pkg"] {
    run("scp",["-o","ControlPath="+socket,repo+"/src/learning_tensor/"+path,host+":"+base+"/workspace/moonrobo-smc-algebra-a/src/learning_tensor/"+path])
  }
  run("ssh",["-S",socket,host,"cp "+base+"/algebra_fixture_a.mbt "+base+"/workspace/moonrobo-smc-algebra-a/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt"])
  for mode in ["plugin","gate-build-smc-algebra-a","smc-algebra-tests-a"] {
    run("ssh",["-S",socket,host,"env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native "+base+"/build_algebra_a.mbtx -- "+mode])
  }
}
