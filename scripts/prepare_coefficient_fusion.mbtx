import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/fs" }
async fn edit(p : String, changes : Array[(String,String)]) -> Unit {
  let mut s=@fs.read_file(p).text()
  for (a,b) in changes {guard s.contains(a)else{fail(p+": "+a)};s=s.replace_all(old=a,new=b)}
  @fs.write_file(p,s)
}
async fn main {
  let g="src/learning_aligned_gpu/";let t="src/learning_tensor/"
  let old=@fs.read_file(t+"geometry_vjp_loader.inc").text()
  let loader=old[old.find("MOONBIT_FFI_EXPORT NativeTensor *mr_tensor_so3_coefficients_call").unwrap():].to_owned().replace_all(old="so3_coefficients",new="so3_coefficient_forward")
  @fs.write_file(t+"geometry_vjp_loader.inc",old+"\nMOONBIT_FFI_EXPORT int32_t mr_tensor_has_coefficient_forward(Backend *b) { return dlsym(b->library,\"mr_tensor_so3_coefficient_forward_v1\")!=NULL; }\n"+loader)
  let old=@fs.read_file(t+"geometry_vjp.mbt").text()
  let extra=old[old.find("///|\n#borrow(backend, x)").unwrap():].to_owned().replace_all(old="so3_coefficients",new="so3_coefficient_forward").replace_all(old="ATen forward and a fused first-order VJP",new="fused assembly, ATen transcendental functions and accepted first-order VJP")
  @fs.write_file(t+"geometry_vjp.mbt",old+"\n///|\n#borrow(backend)\nextern \"c\" fn coefficient_forward_available(backend : Backend) -> Int32 = \"mr_tensor_has_coefficient_forward\"\n///|\npub fn Backend::has_coefficient_forward(self : Backend) -> Bool { coefficient_forward_available(self) != 0 }\n\n"+extra)
  edit(g+"execution_optimizations.mbt",[("  fused_so3_coefficients : Bool","  fused_so3_coefficients : Bool\n  fused_so3_coefficients_forward : Bool\n  split_so3_coefficients : Bool"),("    fused_so3_coefficients: false,","    fused_so3_coefficients: false,\n    fused_so3_coefficients_forward: false,\n    split_so3_coefficients: false,")])
  edit(g+"cmd/optimizations.mbt",[("    fused_so3_coefficients: setting(config, \"fused_so3_coefficients\", false),","    fused_so3_coefficients: setting(config, \"fused_so3_coefficients\", false),\n    fused_so3_coefficients_forward: setting(config, \"fused_so3_coefficients_forward\", false),\n    split_so3_coefficients: setting(config, \"split_so3_coefficients\", false),"),("  if s.optimizations.split_world_delta {","  if s.optimizations.fused_so3_coefficients_forward || s.optimizations.split_so3_coefficients {\n    values[\"execution_coefficient_assembly\"] = 33554432L\n  }\n  if s.optimizations.split_world_delta {")])
  for f in ["geometry/rotations.mbt","geometry/state.mbt"] {
    edit(g+f,[("  fused_so3_coefficients~ : Bool = false,","  fused_so3_coefficients~ : Bool = false,\n  fused_so3_coefficients_forward~ : Bool = false,\n  split_so3_coefficients~ : Bool = false,")])
  }
  edit(g+"geometry/rotations.mbt",[("  let theta2 = v.square()","  guard (!fused_so3_coefficients_forward && !split_so3_coefficients) || fused_so3_coefficients else { fail(\"coefficient optimizations require accepted coefficient VJP\") }\n  let theta2 = v.square()"),("    let coefficients = theta2.so3_coefficients()\n    (col(coefficients, 0), col(coefficients, 1))","    let coefficients = if fused_so3_coefficients_forward { theta2.so3_coefficient_forward() } else { theta2.so3_coefficients() }\n    if split_so3_coefficients {\n      let parts = coefficients.split_sections([1, 1])\n      (parts[0], parts[1])\n    } else {\n      (col(coefficients, 0), col(coefficients, 1))\n    }")])
  edit(g+"geometry/state.mbt",[("        fused_so3_coefficients~,","        fused_so3_coefficients~,\n        fused_so3_coefficients_forward~,\n        split_so3_coefficients~,")])
  for f in ["learning.mbt","microbatch.mbt","actor_microbatch.mbt"] {edit(g+f,[("fused_so3_coefficients=self.optimizations.fused_so3_coefficients,","fused_so3_coefficients=self.optimizations.fused_so3_coefficients,\n        fused_so3_coefficients_forward=self.optimizations.fused_so3_coefficients_forward,\n        split_so3_coefficients=self.optimizations.split_so3_coefficients,")])}
  edit(g+"learning.mbt",[("  if optimizations.compact_skew {","  if optimizations.fused_so3_coefficients_forward || optimizations.split_so3_coefficients {\n    guard optimizations.fused_so3_coefficients && (!optimizations.fused_so3_coefficients_forward || backend.has_coefficient_forward()) && (!optimizations.split_so3_coefficients || backend.has_split_sections()) else { fail(\"coefficient assembly requires accepted VJP and matching plugin\") }\n  }\n  if optimizations.compact_skew {")])
  edit(g+"cmd/optimizations_wbtest.mbt",[("  assert_false(execution_optimizations({}).fused_so3_coefficients)","  assert_false(execution_optimizations({}).fused_so3_coefficients)\n  assert_false(execution_optimizations({}).fused_so3_coefficients_forward)\n  assert_false(execution_optimizations({}).split_so3_coefficients)\n  assert_true(execution_optimizations({ \"fused_so3_coefficients_forward\": true }).fused_so3_coefficients_forward)\n  assert_true(execution_optimizations({ \"split_so3_coefficients\": true }).split_so3_coefficients)"),("    { \"fused_so3_coefficients\": \"true\" },","    { \"fused_so3_coefficients\": \"true\" },\n    { \"fused_so3_coefficients_forward\": \"true\" },\n    { \"split_so3_coefficients\": \"true\" },")])
}
