///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
}

///|
fn id(v : Json) -> String raise {
  guard v is { "id": String(name), .. } else { fail("missing source ID") }
  name
}

///|
async fn main {
  guard @env.args() is [_, source, output] && !@fs.exists(output) else {
    fail("source and fresh output required")
  }
  let bytes = @fs.read_file(source + "/manifest.json").binary()
  let h = @crypto.SHA256::new()
  h.update(bytes)
  let digest = @crypto.bytes_to_hex_string(h.finalize())
  assert_eq(
    digest, "760c59585d792da74e9437f12dced4d216afd5d17411cf4bfa507ed51e6bc60f",
  )
  let manifest = @json.parse(@utf8.decode(bytes))
  guard manifest is Object(fields) &&
    fields.get("clips") is Some(Array(clips)) &&
    clips.length() == 40 else {
    fail("pinned panel changed")
  }
  let ordered = clips.map(v => (id(v), v))
  ordered.sort_by((a, b) => {
    let a_id = a.0
    let b_id = b.0
    let a_walk = a_id.has_prefix("walk")
    let b_walk = b_id.has_prefix("walk")
    if a_walk && !b_walk {
      -1
    } else if !a_walk && b_walk {
      1
    } else {
      a_id.compare(b_id)
    }
  })
  fields["clips"] = Json(ordered.map(pair => pair.1))
  fields["original_manifest_sha256"] = Json(digest)
  fields["processing_order"] = Json(
    "walking first; all 40 source clips and their hashes unchanged",
  )
  @fs.mkdir(output)
  @fs.write_file(
    output + "/manifest.json",
    @utf8.encode(manifest.stringify(indent=2)),
    create_mode=CreateNew,
  )
  @fs.write_file(
    output + "/original-manifest.json",
    bytes,
    create_mode=CreateNew,
  )
  for name in ["lafan1_g1", "LICENSE.dataset", "README.dataset.md"] {
    @fs.symlink(target=source + "/" + name, output + "/" + name)
  }
  println("Reordered all 40 candidates; motion bytes and splits unchanged")
}
