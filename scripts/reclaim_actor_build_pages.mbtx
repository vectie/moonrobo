    .text()
    .split("async fn main {")
    .to_array()[0]
    .to_owned()
    .replace_all(old="depth<=8", new="depth<=16")
  let code = prefix +
    (
      #|async fn main {
      #|  idle()
      #|  let base="/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
      #|  let before=@fs.read_file("/proc/meminfo").text()
