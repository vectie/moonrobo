      #|    idle()
      #|    let path=base+"/workspace/"+ws+"/_build/native"
      #|    let files:Array[String]=[];collect(path,files,0)
      #|    let report=base+"/actor-build-pages-b-"+owner+".json"
      #|    assert_eq(@process.run("/home/wlc004s/moonrobo/private/fincore-official-20261024-a/root/usr/bin/fincore",["--json","--bytes","--output","FILE,SIZE,RES",..files],stdout=@process.redirect_to_file(report,create_mode=CreateNew)),0)
      #|    guard field(read(report),"fincore") is Array(rows) else {fail("residency")}
      #|    let mut resident=0.0
      #|    for row in rows {
      #|      let bytes=match field(row,"res") {Number(n,..)=>n;String(s)=>@string.parse_double(s);_=>fail("res bytes")}
      #|      if bytes==0.0 {continue}
      #|      guard field(row,"file") is String(file)&&files.contains(file)&&@fs.realpath(file)==file&&@fs.kind(file,follow_symlink=false)==Regular else {fail("owned build output")}
      #|      resident+=bytes
      #|      assert_eq(@process.run("sync",["-d",file]),0)
      #|      assert_eq(@process.run("dd",["if="+file,"iflag=nocache,nofollow","count=0","status=none"]),0)
      #|    }
      #|    records.push({"owner":Json(owner),"path":Json(path),"resident_bytes_advised":Json(resident)})
      #|  }
      #|  idle()
      #|  @fs.write_file(base+"/actor-build-pages-b.json",({"before":Json(before),"after":Json(@fs.read_file("/proc/meminfo").text()),"records":Json(records),"files_deleted":0,"contents_changed":false,"guards_changed":false}:Json).stringify(indent=2),create_mode=CreateNew)
      #|}
    )
  let runner = "reclaim_actor_build_pages_b.mbtx"
  @fs.write_file(out + "/" + runner, code, create_mode=CreateNew)
  assert_eq(
    @process.run("scp", [
      "-q",
      "-o",
      "ControlPath=/tmp/moonrobo-operator-179.sock",
