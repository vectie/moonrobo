import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/fs", "moonbitlang/async@0.20.2/process", "moonbitlang/core/env" }
fn rep(s : String,a : String,b : String) -> String raise {guard s.contains(a)else{fail(a)};s.replace_all(old=a,new=b)}
async fn run(p : String,a : Array[String]) -> Unit {guard @process.run(p,a)==0 else{fail(p)}}
async fn main {
  let repo="/Users/kq/Workspace/moonrobo";let dir=repo+"/output/spark-runtime-20261024/smc-heading-body-20261028"
  let base="/home/wlc004s/moonrobo/private/shared-compute-20261026-a";let host="wlc004s@192.168.2.179";let sock="/tmp/moonrobo-operator-179.sock"
  guard @env.args() is [_,mode]else{fail("prepare|stage|build")}
  if mode=="prepare" {
    let mut f=@fs.read_file(dir+"/heading_body_fixture_a.mbt").text()
    f=rep(f,"[Some(\"heading\"),Some(\"combined\")]","[Some(\"heading\"),Some(\"both\")]")
    f=rep(f,"body_errors_batched: [Some(\"bodies\"),Some(\"combined\")].contains(@env.get_env_var(\"MOONROBO_TOP3_VARIANT\")),","body_errors_batched: false,\n      split_world_delta: [Some(\"split\"),Some(\"both\")].contains(@env.get_env_var(\"MOONROBO_TOP3_VARIANT\")),")
    f=rep(f,"factor == \"heading\" || factor == \"combined\"","factor == \"heading\" || factor == \"both\"")
    f=rep(f,"let bodies = enabled && (factor == \"bodies\" || factor == \"combined\")","let split = enabled && (factor == \"split\" || factor == \"both\")")
    f=rep(f,"compact_heading: heading, body_errors_batched: bodies,","compact_heading: heading, split_world_delta: split,")
    f=rep(f,".with_body_errors_batched(bodies)",".with_body_errors_batched(false)")
    f=rep(f,"  guard backend.cuda_free_bytes(0) > 68719476736L else {","  let startup_free = backend.cuda_free_bytes(0)\n  println(\"STARTUP_CUDA_FREE_BYTES \" + startup_free.to_string())\n  guard startup_free > 68719476736L else {")
    @fs.write_file(dir+"/heading_body_fixture_b.mbt",f,create_mode=CreateNew)
    let mut b=@fs.read_file(dir+"/build_heading_body_a.mbtx").text()
    for (a,v) in [("moonrobo-smc-heading-body-a","moonrobo-smc-heading-body-b"),("smc-heading-body-gate-a","smc-heading-body-gate-b"),("smc-heading-body-tensor-a","smc-heading-body-tensor-b"),("smc-heading-body-runtime-a","smc-heading-body-runtime-b"),("smc-heading-body-tests-a","smc-heading-body-tests-b"),("smc-heading-body-plugin-a","smc-heading-body-plugin-b"),("-heading-body-cpu-a","-heading-body-cpu-b"),("libmoonrobo_smc_heading_body_a.so","libmoonrobo_smc_heading_body_b.so")] {b=rep(b,a,v)}
    b=rep(b,"[\"cross_preserve_test.mbt:0-1\"]","[\"cross_preserve_test.mbt:0-1\",\"split_sections_test.mbt:0-1\"]")
    b=b.split("\n").filter(l=>!l.contains("smc-primitives-pivot-heading-body-cpu-b")).map(l=>l.to_owned()).collect().join("\n")
    @fs.write_file(dir+"/build_heading_body_b.mbtx",b,create_mode=CreateNew)
    let mut driver=@fs.read_file(dir+"/run_heading_body_a.mbtx").text()
    for (a,v) in [("smc-heading-body-gate-a","smc-heading-body-gate-b"),("run_heading_body_a.mbtx","run_heading_body_b.mbtx"),("build_heading_body_a.mbtx","build_heading_body_b.mbtx"),("heading_body_fixture_a.mbt","heading_body_fixture_b.mbt"),("libmoonrobo_smc_heading_body_a.so","libmoonrobo_smc_heading_body_b.so"),("\"abba-combined\"","\"abba-combined\", \"split\", \"both\", \"abba-split\", \"abba-both\"")] {driver=rep(driver,a,v)}
    @fs.write_file(dir+"/run_heading_body_b.mbtx",driver,create_mode=CreateNew)
    @fs.write_file(dir+"/invoke_heading_body_b.mbtx",rep(@fs.read_file(dir+"/invoke_heading_body_a.mbtx").text(),"run_heading_body_a.mbtx","run_heading_body_b.mbtx"),create_mode=CreateNew);return
  }
  if mode=="stage" {
    for f in ["heading_body_fixture_b.mbt","build_heading_body_b.mbtx","run_heading_body_b.mbtx","invoke_heading_body_b.mbtx"] {run("scp",["-o","ControlPath="+sock,dir+"/"+f,host+":"+base+"/"+f])}
    run("ssh",["-S",sock,host,"test ! -e "+base+"/workspace/moonrobo-smc-heading-body-b"])
    run("ssh",["-S",sock,host,"cp -a --reflink=auto "+base+"/workspace/moonrobo-smc-heading-body-a "+base+"/workspace/moonrobo-smc-heading-body-b"])
    for f in ["execution_optimizations.mbt","learning.mbt","microbatch.mbt","actor_microbatch.mbt","geometry/state.mbt","cmd/optimizations.mbt","cmd/optimizations_wbtest.mbt"] {run("scp",["-o","ControlPath="+sock,repo+"/src/learning_aligned_gpu/"+f,host+":"+base+"/workspace/moonrobo-smc-heading-body-b/src/learning_aligned_gpu/"+f])}
    for f in ["split_sections.inc","split_sections_loader.inc","split_sections.mbt","split_sections_test.mbt","adapter.cpp","loader.c","moon.pkg"] {run("scp",["-o","ControlPath="+sock,repo+"/src/learning_tensor/"+f,host+":"+base+"/workspace/moonrobo-smc-heading-body-b/src/learning_tensor/"+f])}
    run("ssh",["-S",sock,host,"cp "+base+"/heading_body_fixture_b.mbt "+base+"/workspace/moonrobo-smc-heading-body-b/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt"]);return
  }
  guard mode=="build"else{fail("mode")}
  for m in ["plugin","gate-build-smc-heading-body-b","smc-heading-body-tests-b"] {run("ssh",["-S",sock,host,"env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native "+base+"/build_heading_body_b.mbtx -- "+m])}
}
