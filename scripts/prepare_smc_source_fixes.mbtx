    run("scp",["-o","ControlPath="+socket,repo+"/src/learning_aligned_gpu/"+path,host+":"+base+"/workspace/moonrobo-smc-fix-a/src/learning_aligned_gpu/"+path])
  }
  run("ssh",["-S",socket,host,"cp "+base+"/smc_fix_fixture_a.mbt "+base+"/workspace/moonrobo-smc-fix-a/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt"])
  for mode in ["gate-build-smc-fix-a","smc-fix-tests-a"] {
