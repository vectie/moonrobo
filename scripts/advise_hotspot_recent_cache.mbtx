        trace_root + "/run/native",
        "/home/wlc004s/moonrobo/private/native-micro512-256-prepared/tools/_build",
        "/home/wlc004s/moonrobo/private/native4096-candidate-profile-tools-20261024-g2/_build",
        "/home/wlc004s/moonrobo/private/native4096-six-profile-tools-20261024-g2-observed/_build",
        "/home/wlc004s/moonrobo/private/smc-n256-off-gate-20261024-a/_build",
        "/home/wlc004s/moonrobo/private/smc-native-g2-confirmation-prepared/_build",
        "/home/wlc004s/moonrobo/private/smc-compiled-eager4096-prepared/_build",
        "/home/wlc004s/moonrobo/private/smc-native-g2-gate-evidence/_build",
        "/home/wlc004s/moonrobo/private/hotspot-optimization-20261025-b/workspace/moonrobo-fixtures/_build",
        "/home/wlc004s/moonrobo/private/hotspot-optimization-20261025-b/workspace/moonrobo/_build",
        "/home/wlc004s/moonrobo/private/hotspot-optimization-20261025-b/_build",
        "/home/wlc004s/moonrobo/private/hotspot-optimization-20261025-a/_build",
        "/home/wlc004s/moonrobo/private/hotspot-optimization-20261025-a/workspace/moonrobo/_build",
        base + "/trace41-phase-actortracea-native-export",
        base + "/trace41-phase-actortraceb-smc-compiled-export",
        base + "/trace41-phase-collectnativea-native-export",
        base + "/trace41-phase-collecttrace-smc-compiled-export",
        base + "/trace41-phase-worldtraced-smc-compiled-export",
        base + "/trace41-phase-worldtracef-native-export",
        base + "/_build",
        base + "/workspace-clean/moonrobo/_build",
        base + "/workspace-clean/moonrobo/scripts/_build",
        base + "/workspace-clean/moonrobo-fixtures/_build",
        base + "/workspace-phase-b/moonrobo/_build",
        base + "/workspace-phase-b/moonrobo/scripts/_build",
        base + "/trace41-solo-j-native-export",
        base + "/trace41-solo-e-smc-compiled-export",
        base + "/trace41-solo-f-smc-eager-export",
        "/home/wlc004s/moonrobo/runs/operator-trace41-20261025-solo-j-native/run",
        "/home/wlc004s/moonrobo/runs/operator-trace41-20261025-solo-e-smc-compiled/run",
        "/home/wlc004s/moonrobo/runs/operator-trace41-20261025-solo-f-smc-eager/run",
        base + "/script-cache",
        "/home/wlc004s/moonrobo/_build",
        "/home/wlc004s/moonrobo/scripts/_build",
        "/home/wlc004s/moonrobo/private/_build",
        "/home/wlc004s/moonrobo/private/native4096-pair-tools-20261024-g2/_build",
        "/home/wlc004s/moonrobo/private/native-micro512-256-prepared/_build",
      ]
    }
    let rows : Array[Json] = []
    let before_mem = command("cat", ["/proc/meminfo"])
    errdefer {
      let partial : Json = {
        "format": "moonrobo.closed-operator-build-cache.v1",
        "passed": false,
        "mode": mode,
        "operations": rows,
        "meminfo_before": before_mem,
        "scope": "Interrupted attempt; completed per-file observations only; original failure remains a failure",
        "files_deleted": 0,
        "guards_changed": false,
      }
      @fs.write_file(
        base + "/" + name,
        partial.stringify(indent=2),
        create_mode=CreateNew,
      ) catch {
        _ => ()
      }
    }
    // Explicit completed task build products or closed pair caches only.
    // Exclude active control scripts; advice preserves all file contents.
    for source in sources {
      guard @fs.realpath(source) == source else { fail("canonical build root") }
      let files = command("find", [
        source,
        "-xdev",
        "-maxdepth",
        "18",
        "-type",
        "f",
        "-uid",
        "1000",
        "-size",
        if mode == "--host-warp" ||
          mode == "--host-phase-compiler" ||
          mode == "--host-diagnostic-warp" ||
          mode == "--host-build" ||
          mode == "--host-apic" {
          "+64k"
        } else {
          "+1M"
        },
        "-printf",
        "%p\\0",
      ])
      let paths = files
        .split("\x00")
        .filter(p => p != "" && !p.has_prefix(active_build))
        .map(p => p.to_owned())
        .to_array()
      guard paths.length() <= 4096 else { fail("build metadata file count") }
      for index, path in paths {
        guard @fs.realpath(path) == path &&
          @fs.kind(path, follow_symlink=false) == Regular else {
          fail("build regular canonical")
        }
        let stamp = command("stat", ["--format=%d %i %s %Y %Z %h %u", path])
          .trim()
          .to_owned()
        guard stamp.has_suffix(" 1 1000") else { fail("build owner/hardlink") }
        let before = @json.parse(
          command(fincore, [
            "--json", "--bytes", "--output", "FILE,SIZE,RES,PAGES", path,
          ]),
        )
        guard field(before, "fincore") is Array([b]) else { fail("fincore") }
        if num(field(b, "res")) == 0L {
          continue
        }
        if index % 32 == 0 {
          idle("")
        }
        ignore(
          command("dd", [
            "if=" + path,
            "iflag=nocache,nofollow",
            "count=0",
            "status=none",
          ]),
        )
        guard command("stat", ["--format=%d %i %s %Y %Z %h %u", path]).trim() ==
          stamp else {
          fail("build file changed")
        }
        let after = @json.parse(
          command(fincore, [
            "--json", "--bytes", "--output", "FILE,SIZE,RES,PAGES", path,
          ]),
        )
        rows.push({
          "path": path,
          "before": field(before, "fincore"),
          "after": field(after, "fincore"),
          "source": source,
          "passed": true,
        })
      }
    }
    idle("")
    let report : Json = {
      "passed": true,
      "format": "moonrobo.closed-operator-build-cache.v1",
      "mode": mode,
      "verified_ownership": ownership,
      "operations": rows,
      "meminfo_before": before_mem,
      "meminfo_after": command("cat", ["/proc/meminfo"]),
      "scope": "Explicit completed task build products or verified closed task caches, >64KiB for build/Warp or >1MiB otherwise; currently executing controller build excluded; all Docker/GPU jobs idle; no source/dataset advice; file-specific nocache preserves contents and existing run acceptance",
      "files_deleted": 0,
      "guards_changed": false,
    }
    @fs.write_file(
      base + "/" + name,
      report.stringify(indent=2),
      create_mode=CreateNew,
    )
    println("completed build cache advice: " + name)
    return
  }
  if a is [_, "--self-test"] {
    assert_true(component("abc-123.pch"))
    assert_false(component(".."))
    assert_false(component("a/b"))
    assert_eq(
      inventory(
        "d\t4096\t2\t1000\t1\t1\t0\t0\t\x00f\t4\t1\t1000\t1\t2\t0\t0\tx\x00",
      ).length(),
      1,
    )
    for
      invalid in [
        "l\t4\t1\t1000\t1\t2\t0\t0\tx\x00", "f\t4\t2\t1000\t1\t2\t0\t0\tx\x00", "f\t4\t1\t0\t1\t2\t0\t0\tx\x00",
        "f\t4\t1\t1000\t1\t2\t0\t0\t../x\x00",
      ] {
      let rejected = try {
        ignore(inventory(invalid))
        false
      } catch {
        _ => true
      }
      assert_true(rejected)
    }
    println("cache scope parser checks passed; no Docker/GPU")
    return
  }
  guard a.length() >= 5 &&
    a.length() <= 12 &&
    ["--plan", "--advise"].contains(a[1]) &&
    ["tmp", "inductor", "triton", "cuda"].contains(a[3]) &&
    component(a[2]) else {
    fail(
      "usage: --plan|--advise REPORT_BASENAME tmp|inductor|triton|cuda RUN_SUFFIX...",
    )
  }
  let report_path = base + "/" + a[2]
  guard !@fs.exists(report_path) else { fail("fresh report required") }
  let records : Array[Json] = []
  let ownership : Array[Json] = []
  let before = command("cat", ["/proc/meminfo"])
  let passed = try {
    idle("")
    guard command("sha256sum", [fincore]).has_prefix(
      "274ba306fe0b05add3a1b8a5fbdc3adba33a985b76686a2b9384860814b63ffb ",
    ) else {
      fail("fincore pin")
    }
    for suffix in a[4:] {
      guard [
        "b-smc-compiled", "solo-c-smc-compiled", "solo-d-smc-compiled", "solo-e-smc-compiled",
        "solo-f-smc-eager", "tiny-a-math", "tiny-b-math", "tiny-b-external-stop",
        "tiny-c-external-stop", "tiny-d-guarded-math", "phase-worldtraced-smc-compiled",
        "phase-collecttrace-smc-compiled",
      ].contains(suffix) else {
        fail("explicit ended diagnostic scope only")
      }
      let tiny = suffix.has_prefix("tiny-")
      guard !tiny || a[3] == "cuda" else {
        fail("only tiny private CUDA cache supported")
      }
      let root = if tiny {
        "/home/wlc004s/moonrobo/runs/operator-tiny-20261025-" +
        suffix[5:].to_owned()
      } else {
        "/home/wlc004s/moonrobo/runs/operator-trace41-20261025-" + suffix
      }
      guard @fs.realpath(root) == root else { fail("canonical root") }
      let receipt = read_json(root + "/outer-result.json")
      guard (
          tiny &&
          field(receipt, "format") == Json("moonrobo.operator-tiny-outer.v1")
        ) ||
        (
          !tiny &&
          field(receipt, "format") == Json("moonrobo.operator-trace41-outer.v1") &&
          field(receipt, "mode") == Json("--run")
        ) else {
        fail("diagnostic receipt")
      }
      let id = text(field(receipt, "container_id"))
      let actual = inspect(id)
      let saved = match read_json(root + "/docker-final.json") {
        Array([j]) => j
        Object(_) as j => j
        _ => fail("saved inspection")
      }
      stopped(actual)
      stopped(saved)
      for key in ["Id", "Image", "Config", "GraphDriver", "State"] {
        guard field(actual, key) == field(saved, key) else {
          fail("closed container identity differs: " + key)
        }
      }
      guard field(actual, "Mounts") is Array(am) &&
        field(saved, "Mounts") is Array(sm) &&
        am.length() == sm.length() &&
        am.all(m => {
          sm.filter(x => field(x, "Destination") == field(m, "Destination")) ==
          [m]
        }) else {
        fail("mount identities differ")
      }
      guard field(actual, "Mounts") is Array(mounts) &&
        mounts.any(m => {
          field(m, "Source") == Json(if tiny { root } else { root + "/run" }) &&
          field(m, "Destination") == Json("/run") &&
          field(m, "RW") == Json(true)
        }) else {
        fail("owned run bind")
      }
      ownership.push({
        "root": root,
        "result_passed": field(receipt, "passed"),
        "inspection": actual,
      })
      let source = match a[3] {
        "tmp" => root + "/run/" + text(field(receipt, "kind")) + "/tmp"
        "inductor" => root + "/pair/inductor-cache"
        "triton" => root + "/pair/triton-cache"
        _ => {
          guard field(field(actual, "GraphDriver"), "Name") == Json("overlay2") else {
            fail("overlay2 required")
          }
          let upper = text(
            field(field(field(actual, "GraphDriver"), "Data"), "UpperDir"),
          )
          guard upper.has_prefix("/var/lib/docker/overlay2/") &&
            upper.has_suffix("/diff") &&
            upper.split("/").all(s => s == "" || component(s.to_owned())) else {
            fail("upper scope")
          }
          upper + "/home/isaaclab/.nv/ComputeCache"
        }
      }
      cache(id, source, a[1] == "--advise", records)
    }
    true
  } catch {
    e => {
      records.push({ "error": e.to_string() })
      false
    }
  }
  let report : Json = {
    "format": "moonrobo.closed-operator-cache-advice.v1",
    "passed": passed,
    "mode": a[1],
    "kind": a[3],
    "ownership": ownership,
    "operations": records,
    "meminfo_before": before,
    "meminfo_after": command("cat", ["/proc/meminfo"]),
    "files_deleted": 0,
    "global_cache_operation": false,
    "content_read_or_written": false,
    "guards_changed": false,
    "reclaim_guaranteed": false,
    "failed_run_is_not_reclassified_as_passed": true,
  }
  @fs.write_file(
    report_path,
    report.stringify(indent=2) + "\n",
    create_mode=CreateNew,
  )
  let brief : Json = { "passed": passed, "report": report_path }
  println(brief.stringify())
  guard passed else {
    fail("bounded cache operation refused; evidence retained")
  }
}
