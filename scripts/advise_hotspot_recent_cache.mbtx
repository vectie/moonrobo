///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/async@0.20.2/io",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
let base = "/home/wlc004s/moonrobo/private/operator-diagnostic-20261025-a"

///|
let fincore = "/home/wlc004s/moonrobo/private/fincore-official-20261024-a/root/usr/bin/fincore"

///|
let image = "sha256:c76815627562a180052cef8e7e07edb37fe8547d83158eed6182ebd99bb8385d"

///|
fn field(j : Json, k : String) -> Json raise {
  guard j is Object(m) && m.get(k) is Some(v) else { fail("missing " + k) }
  v
}

///|
fn text(j : Json) -> String raise {
  guard j is String(s) else { fail("string") }
  s
}

///|
fn num(j : Json) -> Int64 raise {
  guard j is Number(n) && n >= 0.0 && n <= 9007199254740991.0 && n.floor() == n else {
    fail("integer")
  }
  n.to_int64()
}

///|
fn component(s : String) -> Bool {
  s != "" &&
  s != "." &&
  s != ".." &&
  s
  .iter()
  .all(c => {
    (c >= 'a' && c <= 'z') ||
    (c >= 'A' && c <= 'Z') ||
    (c >= '0' && c <= '9') ||
    c == '_' ||
    c == '-' ||
    c == '.'
  })
}

///|
async fn read_json(p : String) -> Json {
  guard @fs.realpath(p) == p && @fs.kind(p, follow_symlink=false) == Regular else {
    fail("canonical metadata required")
  }
  let f = @fs.open(p, mode=ReadOnly)
  defer f.close()
  let n = f.size()
  guard n > 0L && n <= 16777216L else { fail("metadata bound") }
  @json.parse(@utf8.decode(f.read_exactly_at(n.to_int(), position=0L)))
}

///|
async fn bounded(r : &@io.Reader) -> String {
  let b = FixedArray::make(4194305, b'\x00')
  let mut n = 0
  for ;; {
    let k = r.read(b, offset=n, max_len=b.length() - n)
    if k == 0 {
      break
    }
    n += k
    guard n <= 4194304 else { fail("4MiB output bound") }
  }
  @utf8.decode(Bytes::from_array(b[:n]))
}

///|
async fn command(p : String, a : Array[String]) -> String {
  @async.with_timeout(60000, () => {
    let (out, ot) = @process.read_from_process()
    let (err, et) = @process.read_from_process()
    @async.with_task_group() <| g => {
      let proc = g.spawn(() => @process.run(p, a, stdout=ot, stderr=et))
      let o = g.spawn(() => {
        defer out.close()
        bounded(out)
      })
      let e = g.spawn(() => {
        defer err.close()
        bounded(err)
      })
      let code = proc.wait()
      let value = o.wait()
      let error = e.wait()
      guard code == 0 else { fail(p + " failed: " + error) }
      value
    }
  })
}

///|
async fn docker(a : Array[String]) -> String {
  command("docker", ["--host", "unix:///var/run/docker.sock"] + a)
}

///|
async fn inspect(id : String) -> Json {
  guard @json.parse(docker(["inspect", id])) is Array([j]) else {
    fail("one container required")
  }
  j
}

///|
fn stopped(j : Json) -> Unit raise {
  let s = field(j, "State")
  guard field(s, "Running") == Json(false) &&
    field(s, "Status") == Json("exited") &&
    field(s, "Pid") == Json(0) &&
    field(s, "OOMKilled") == Json(false) &&
    !text(field(s, "FinishedAt")).has_prefix("0001-") else {
    fail("container not closed/noOOM")
  }
}

///|
async fn idle(worker : String) -> Unit {
  guard docker(["ps", "--no-trunc", "--quiet"]).trim() == worker else {
    fail("unrelated active container")
  }
  guard command("nvidia-smi", [
      "--query-compute-apps=pid", "--format=csv,noheader,nounits",
    ]).trim() ==
    "" else {
    fail("active GPU job")
  }
}

///|
struct Entry {
  path : String
  stamp : String
  size : Int64
}

///|
fn inventory(s : String) -> Array[Entry] raise {
  guard s.has_suffix("\x00") else { fail("truncated inventory") }
  let entries : Array[Entry] = []
  let mut bytes = 0L
  let rows = s.split("\x00").filter(s => s != "").to_array()
  guard rows.length() <= 32768 else { fail("entry bound") }
  for row in rows {
    let c = row.split("\t").to_array()
    guard c.length() == 9 else { fail("inventory columns") }
    let path = c[8].to_owned()
    guard path == "" ||
      (
        path.split("/").all(p => component(p.to_owned())) &&
        path.split("/").count() < 14
      ) else {
      fail("unsafe path")
    }
    if c[0] == "d" {
      continue
    }
    guard c[0] == "f" && c[2] == "1" && c[3] == "1000" else {
      fail("nonregular, linked or foreign file")
    }
    let size = @string.parse_int64(c[1])
    bytes += size
    guard size >= 0L && size <= 4294967296L && bytes <= 17179869184L else {
      fail("file/total bytes bound")
    }
    entries.push({ path, size, stamp: c[:8].map(x => x.to_owned()).join("\t"), })
  }
  entries
}

///|
async fn residency(worker : String, entries : Array[Entry]) -> Array[Json] {
  let result : Array[Json] = []
  for start = 0; start < entries.length(); start = start + 32 {
    let end = if start + 32 < entries.length() {
      start + 32
    } else {
      entries.length()
    }
    let paths = entries[start:end].map(e => "/cache/" + e.path)
    let j = @json.parse(
      docker(
        [
          "exec", worker, "/fincore", "--json", "--bytes", "--output", "FILE,SIZE,RES,PAGES",
        ] +
        paths,
      ),
    )
    guard field(j, "fincore") is Array(rows) && rows.length() == paths.length() else {
      fail("residency count")
    }
    for i, row in rows {
      guard field(row, "file") == Json(paths[i]) &&
        num(field(row, "size")) == entries[start + i].size else {
        fail("file identity changed")
      }
      result.push(row)
    }
  }
  result
}

///|
async fn cache(
  id : String,
  source : String,
  advise : Bool,
  records : Array[Json],
) -> Unit {
  idle("")
  stopped(inspect(id))
  let args = [
    "create",
    "--runtime",
    "runc",
    "--network",
    "none",
    "--read-only",
    "--user",
    "1000:1000",
    "--cap-drop",
    "ALL",
    "--security-opt",
    "no-new-privileges",
    "--memory",
    "268435456",
    "--memory-swap",
    "268435456",
    "--cpus",
    "1",
    "--pids-limit",
    "32",
    "--env",
    "NVIDIA_VISIBLE_DEVICES=void",
    "--env",
    "NVIDIA_DRIVER_CAPABILITIES=",
    "--mount",
    "type=bind,src=" + source + ",dst=/cache,readonly",
    "--mount",
    "type=bind,src=" + fincore + ",dst=/fincore,readonly",
    "--entrypoint",
    "/usr/bin/sleep",
    image,
    "1800",
  ]
  let worker = docker(args).trim().to_owned()
  let record : Json = {
    "source": source,
    "owner_container": id,
    "worker": worker,
    "worker_argv": args,
    "passed": false,
  }
  records.push(record)
  guard record is Object(m) else { fail("record") }
  let success = try {
    let initial = inspect(worker)
    m["worker_initial"] = initial
    let host = field(initial, "HostConfig")
    guard field(initial, "Image") == Json(image) &&
      field(host, "Runtime") == Json("runc") &&
      field(host, "ReadonlyRootfs") == Json(true) &&
      field(host, "Memory") == Json(268435456) &&
      field(host, "MemorySwap") == Json(268435456) &&
      field(host, "NetworkMode") == Json("none") &&
      field(field(initial, "Config"), "User") == Json("1000:1000") &&
      field(initial, "Mounts") is Array(mounts) &&
      mounts.length() == 2 &&
      mounts.all(x => field(x, "RW") == Json(false)) else {
      fail("worker confinement")
    }
    ignore(docker(["start", worker]))
    idle(worker)
    let entries = inventory(
      docker([
        "exec", worker, "/usr/bin/find", "-P", "/cache", "-xdev", "-maxdepth", "14",
        "-printf", "%y\t%s\t%n\t%U\t%D\t%i\t%T@\t%C@\t%P\\0",
      ]),
    )
    let before = residency(worker, entries)
    m["before"] = Json(before)
    let done : Array[Json] = []
    m["advice"] = Json(done)
    for i, entry in entries {
      if !advise || num(field(before[i], "res")) == 0L {
        continue
      }
      idle(worker)
      stopped(inspect(id))
      let path = "/cache/" + entry.path
      let now = docker([
          "exec", worker, "/usr/bin/find", "-P", path, "-maxdepth", "0", "-printf",
          "%y\t%s\t%n\t%U\t%D\t%i\t%T@\t%C@",
        ])
        .trim()
        .to_owned()
      guard now == entry.stamp else { fail("file changed before advice") }
      ignore(
        docker([
          "exec",
          worker,
          "/usr/bin/dd",
          "if=" + path,
          "iflag=nocache,nofollow",
          "count=0",
          "status=none",
        ]),
      )
      done.push({
        "path": entry.path,
        "size": entry.size,
        "operation": "POSIX_FADV_DONTNEED via GNU dd count=0; no read/write/delete",
        "returned_zero": true,
      })
    }
    m["advice"] = Json(done)
    m["after"] = Json(residency(worker, entries))
    true
  } catch {
    e => {
      m["error"] = Json(e.to_string())
      false
    }
  }
  ignore(docker(["stop", "--time", "1", worker]))
  m["worker_final"] = inspect(worker)
  m["passed"] = Json(success)
  stopped(inspect(id))
  idle("")
  guard success else { fail("cache operation failed; retained record") }
}

///|
async fn main {
  let a = @env.args()
  if a is [_, "--paired-checkpoints", name] {
    guard component(name) && !@fs.exists(base + "/" + name) else {
      fail("fresh report")
    }
    idle("")
    guard command("sha256sum", [fincore]).has_prefix(
      "274ba306fe0b05add3a1b8a5fbdc3adba33a985b76686a2b9384860814b63ffb ",
    ) else {
      fail("fincore pin")
    }
    let records : Array[Json] = []
    let before = command("cat", ["/proc/meminfo"])
    let passed = try {
      for i in 0..<4 {
        let root = "/home/wlc004s/moonrobo/runs/smc-microbatch4096-abba-20261025-b/run-" +
          i.to_string()
        guard @fs.realpath(root + "/logs") == root + "/logs" else {
          fail("canonical closed run logs")
        }
        let result = read_json(root + "/result.json")
        guard field(result, "passed") == Json(true) else {
          fail("successful ended pair required")
        }
        guard read_json(root + "/training-docker-final.json") is Array([saved]) else {
          fail("one container")
        }
        let id = text(field(saved, "Id"))
        let actual = inspect(id)
        stopped(actual)
        for key in ["Id", "Image", "Config", "State", "GraphDriver"] {
          guard field(saved, key) == field(actual, key) else {
            fail("closed container identity changed: " + key)
          }
        }
        // Docker's Mounts enumeration order is not stable. Preserve exact
        // member identity and cardinality without treating order as identity.
        guard field(saved, "Mounts") is Array(old_mounts) &&
          field(actual, "Mounts") is Array(new_mounts) &&
          old_mounts.length() == new_mounts.length() &&
          old_mounts.all(old => {
            new_mounts.filter(now => now == old).length() == 1
          }) else {
          fail("closed container mount identity changed")
        }
        guard field(actual, "Mounts") is Array(mounts) &&
          mounts.any(m => {
            field(m, "Source") == Json(root) &&
            field(m, "Destination") == Json("/pair")
          }) else {
          fail("exact pair owns checkpoint files")
        }
        cache(id, root + "/logs", true, records)
      }
      true
    } catch {
      e => {
        records.push({ "error": e.to_string() })
        false
      }
    }
    @fs.write_file(
      base + "/" + name,
      Json({
        "format": Json("moonrobo.closed-pair-file-pages.v1"),
        "passed": Json(passed),
        "records": Json(records),
        "host_before": Json(before),
        "host_after": Json(command("cat", ["/proc/meminfo"])),
        "no_deletion_or_content_change": Json(true),
      }).stringify(indent=2) +
      "\n",
      create_mode=CreateNew,
    )
    guard passed else { fail("pair cache advice failed; retained receipt") }
    println("Completed closed-pair file page advice")
    return
  }
  if a is [_, mode, name] &&
    [
      "--host-build", "--host-pair", "--host-triton", "--host-warp", "--host-diagnostic-warp",
      "--host-apic", "--host-phase-compiler",
    ].contains(mode) {
    guard component(name) && !@fs.exists(base + "/" + name) else {
      fail("fresh report")
    }
    idle("")
    let ownership : Array[Json] = []
    let self_exe = @fs.realpath("/proc/self/exe")
    guard self_exe.has_prefix(base + "/_build/") &&
      self_exe.contains("/native/") else {
      fail("expected native controller in private build root")
    }
    let active_build = self_exe.split("/native/").to_array()[0].to_owned() + "/"
