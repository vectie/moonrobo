    #|    guard field(read(dir+"/completion.json"),"passed")==Json(true)&&field(read(dir+"/training-guard.json"),"reason")==Json("completed") else {continue}
    #|    guard read(dir+"/training-docker-final.json") is [{"Id":String(id),"State":state,..}] && state is {"OOMKilled":False,"Running":False,"Pid":0,..} else {fail("closed container required")}
    #|    assert_eq(@json.parse(output("docker",["inspect","--format","{{json .State}}",id])),state)
    #|    idle();let files:Array[String]=[]
    #|    if @fs.exists(dir+"/cuda-cache"){collect(dir+"/cuda-cache",files,0)}
    #|    let mut size=0L
    #|    for path in files {
    #|      guard @fs.realpath(path)==path&&@fs.kind(path,follow_symlink=false)==Regular else {fail("canonical regular output")}
    #|      let f=@fs.open(path,mode=ReadOnly);size+=f.size();f.close()
    #|    }
