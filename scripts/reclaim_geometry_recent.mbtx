///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
}

///|
async fn main {
  let out = "output/spark-runtime-20261024/geometry-math-20261029-a"
  let source = @fs.read_file("scripts/reclaim_geometry_history.mbtx").text()
  let lines = source
    .split("\n")
    .filter(line => line.contains("let names=["))
    .to_array()
  assert_eq(lines.length(), 1)
  let line = lines[0].to_owned()
  let replacement = "    #| let names=[\"geometry-math-native-gate-h\",\"geometry-math-native-gate-k\",\"geometry-math-native-gate-l\",\"geometry-reference-inputs-a\",\"geometry-math-reference-gate-m\"]"
  let script = source
    .replace_all(old=line, new=replacement)
    .replace_all(old="history_b", new="recent_a")
    .replace_all(old="history-advice-b", new="recent-advice-a")
  @fs.write_file(out + "/reclaim_recent_a.mbtx", script, create_mode=CreateNew)
  assert_eq(
    @process.run("moon", [
      "run",
      "--target",
      "native",
      out + "/reclaim_recent_a.mbtx",
    ]),
    0,
  )
}
