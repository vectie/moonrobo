///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args() is [_, mode] && ["prepare", "build", "run"].contains(mode) else {
    fail("prepare/build/run")
  }
  let out = "output/spark-runtime-20261024/actor-backward-boundaries-20261029-a"
  let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host = "wlc004s@192.168.2.179"
  if mode == "prepare" {
    for
      file in [
        "actor_reward_fixture_a.mbt", "build_actor_reward_a.mbtx", "run_actor_reward_native_a.mbtx",
      ] {
      let mut code = @fs.read_file(out + "/" + file).text()
      for
        stem in [
          "actor_reward_fixture_", "build_actor_reward_", "run_actor_reward_native_",
        ] {
        code = code.replace_all(old=stem + "a.", new=stem + "b.")
      }
      for
        stem in [
          "moonrobo-actor-reward-", "actor-reward-copy-", "actor-reward-overlay-",
          "actor-reward-fixture-", "actor-reward-source-", "actor-reward-helper-",
          "actor-reward-tracking-", "actor-reward-build-", "actor-reward-cpu-tests-",
          "actor-reward-binary-", "actor-reward-gate-",
        ] {
        code = code.replace_all(old=stem + "a", new=stem + "b")
      }
      if file == "actor_reward_fixture_a.mbt" {
        for field in ["p", "rotation", "v", "w", "q", "qd"] {
          code = code.replace_all(
            old="references[1:].map(r=>r." + field + ").to_owned()",
            new="references[1:].map(r=>r." + field + ")",
          )
        }
        code = code +
          "\n///|\nasync fn shared_export_trained(" +
          @fs.read_file(out + "/actor_step_fixture_d.mbt")
          .text()
          .split("async fn shared_export_trained(")
          .to_array()[1].to_owned()
      }
      let target = file.replace_all(old="_a.", new="_b.")
      @fs.write_file(out + "/" + target, code, create_mode=CreateNew)
      assert_eq(
        @process.run("scp", [
          "-q",
          "-o",
          "ControlPath=/tmp/moonrobo-operator-179.sock",
          out + "/" + target,
          host + ":" + base + "/" + target,
        ]),
        0,
      )
    }
    return
  }
  let folder = out + "/reward-native-" + mode + "-b"
  @fs.mkdir(folder)
  let command = if mode == "build" {
    "build_actor_reward_b.mbtx"
  } else {
    "run_actor_reward_native_b.mbtx -- actor native off 1 actor-reward-native-b bf16-full"
  }
  let code = @process.run(
    "ssh",
    [
      "-S",
      "/tmp/moonrobo-operator-179.sock",
      host,
      "env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native " +
      base +
      "/" +
      command,
    ],
    stdout=@process.redirect_to_file(
      folder + "/controller.stdout.log",
      create_mode=CreateNew,
    ),
    stderr=@process.redirect_to_file(
      folder + "/controller.stderr.log",
      create_mode=CreateNew,
    ),
  )
  if mode == "run" {
    for
      name in [
        "result.json", "completion.json", "training-guard.json", "training-docker-final.json",
        "training.stdout.log", "training.stderr.log", "protocol.json",
      ] {
      ignore(
        @process.run("scp", [
          "-q",
          "-o",
          "ControlPath=/tmp/moonrobo-operator-179.sock",
          host +
          ":/home/wlc004s/moonrobo/runs/hotspot-shared-actor-reward-native-b/" +
          name,
          folder + "/" + name,
        ]),
      )
    }
  }
  assert_eq(code, 0)
}
