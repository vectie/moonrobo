///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args() is [_, mode, rev] &&
    ["prepare", "export"].contains(mode) &&
    ["a", "b", "c", "d", "e", "f", "g"].contains(rev) else {
    fail("prepare/export a..g")
  }
  let out = "output/spark-runtime-20261024/actor-backward-boundaries-20261029-a"
  let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host = "wlc004s@192.168.2.179"
  let runner = "run_actor_backward_padding_" + rev + ".mbtx"
  let adapter = "export_actor_backward_padding_" + rev + ".py"
  if mode == "prepare" {
    let code = @fs.read_file(out + "/run_actor_step_export_b.mbtx")
      .text()
      .replace_all(old="run_actor_step_export_b.mbtx", new=runner)
      .replace_all(old="export_actor_steps_b.py", new=adapter)
    for
      (name, content) in [
        (runner, code),
        (
          adapter,
          @fs.read_file(
            "providers/motion_learning/export_actor_backward_padding.py",
          ).text(),
        ),
      ] {
      @fs.write_file(out + "/" + name, content, create_mode=CreateNew)
      assert_eq(
        @process.run("scp", [
          "-q",
          "-o",
          "ControlPath=/tmp/moonrobo-operator-179.sock",
          out + "/" + name,
          host + ":" + base + "/" + name,
        ]),
        0,
      )
    }
    return
  }
  let folder = out + "/backward-padding-" + rev
  @fs.mkdir(folder)
  let status = @process.run(
    "ssh",
    [
      "-S",
      "/tmp/moonrobo-operator-179.sock",
      host,
      "env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native " +
      base +
      "/" +
      runner +
      " -- actor compiled off actor-backward-padding-" +
      rev +
      " bf16",
    ],
    stdout=@process.redirect_to_file(
      folder + "/controller.stdout.log",
      create_mode=CreateNew,
    ),
    stderr=@process.redirect_to_file(
      folder + "/controller.stderr.log",
      create_mode=CreateNew,
    ),
  )
  for
    name in [
      "result.json", "completion.json", "training-guard.json", "training-docker-final.json",
      "training.stdout.log", "training.stderr.log", "protocol.json", "exported-artifacts.json",
      "initial-reference-decisions.json", "recurrent-reference-decisions.json",
    ] {
    ignore(
      @process.run("scp", [
        "-q",
        "-o",
        "ControlPath=/tmp/moonrobo-operator-179.sock",
        host +
        ":/home/wlc004s/moonrobo/runs/hotspot-mlp-actor-backward-padding-" +
        rev +
        "/" +
        name,
        folder + "/" + name,
      ]),
    )
  }
  assert_eq(status, 0)
}
