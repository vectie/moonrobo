///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
}

///|
async fn main {
  let out = "output/spark-runtime-20261024/geometry-math-20261029-a"
  let cleanup = @fs.read_file("scripts/reclaim_geometry_builds_current.mbtx")
    .text()
    .replace_all(old="residency-c", new="residency-d")
    .replace_all(old="advice-c", new="advice-d")
    .replace_all(old="builds_c", new="builds_d")
    .replace_all(old="reclaim_builds_c", new="reclaim_builds_d")
  @fs.write_file(
    out + "/reclaim_builds_d_launcher.mbtx",
    cleanup,
    create_mode=CreateNew,
  )
  assert_eq(
    @process.run("moon", [
      "run",
      "--target",
      "native",
      out + "/reclaim_builds_d_launcher.mbtx",
    ]),
    0,
  )
  let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host = "wlc004s@192.168.2.179"
  let socket = "/tmp/moonrobo-math-179.sock"
  for
    (name, code) in [
      (
        "geometry_update_boundary_b.py",
        @fs.read_file("providers/motion_learning/geometry_update_boundary.py").text(),
      ),
      (
        "run_geometry_boundary_reference_b.mbtx",
        @fs.read_file(out + "/run_geometry_boundary_reference_a.mbtx")
        .text()
        .replace_all(
          old="geometry_update_boundary_a.py",
          new="geometry_update_boundary_b.py",
        )
        .replace_all(
          old="run_geometry_boundary_reference_a.mbtx",
          new="run_geometry_boundary_reference_b.mbtx",
        ),
      ),
    ] {
    @fs.write_file(out + "/" + name, code, create_mode=CreateNew)
    assert_eq(
      @process.run("scp", [
        "-q",
        "-o",
        "ControlPath=" + socket,
        out + "/" + name,
        host + ":" + base + "/" + name,
      ]),
      0,
    )
  }
  let folder = out + "/geometry-boundary-reference-b"
  @fs.mkdir(folder)
  let status = @process.run(
    "ssh",
    [
      "-S",
      socket,
      host,
      "env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native " +
      base +
      "/run_geometry_boundary_reference_b.mbtx -- world geometry-boundary-reference-b",
    ],
    stdout=@process.redirect_to_file(
      folder + "/controller.stdout.log",
      create_mode=CreateNew,
    ),
    stderr=@process.redirect_to_file(
      folder + "/controller.stderr.log",
      create_mode=CreateNew,
    ),
  )
  for
    name in [
      "result.json", "completion.json", "training-guard.json", "training.stdout.log",
      "training.stderr.log",
    ] {
    ignore(
      @process.run("scp", [
        "-q",
        "-o",
        "ControlPath=" + socket,
        host +
        ":/home/wlc004s/moonrobo/runs/hotspot-mlp-geometry-boundary-reference-b/" +
        name,
        folder + "/" + name,
      ]),
    )
  }
  assert_eq(status, 0)
}
