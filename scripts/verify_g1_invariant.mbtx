///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/async@0.20.2/io",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn field(value : Json, key : String) -> Json raise {
  guard value is Object(fields) && fields.get(key) is Some(value) else {
    fail("missing field: " + key)
  }
  value
}

///|
async fn run_command(exe : String, args : Array[String]) -> String {
  let (code, stdout, stderr) = native_collect_output(exe, args)
  assert_eq(code, 0, msg=stderr.text() + stdout.text())
  stdout.text()
}

///|
async fn read(path : String) -> Json {
  @json.parse(@fs.read_file(path).text())
}

///|
async fn main {
  let args = @env.args()
  assert_eq(
    args.length(),
    5,
    msg="usage: verify_g1_invariant.mbtx REPO WARM_POLICY INVARIANT_RUN SUMMARY_JSON",
  )
  let root = args[1]
  let study = args[3]
  let policy = read(study + "/policy/report.json")
  guard field(policy, "runs") is Array(runs) else { fail("missing runs") }
  let comparisons : Array[Json] = []
  for run in runs {
    guard field(run, "seed") is Number(seed_number, ..) else {
      fail("missing seed")
    }
    let seed = seed_number.to_int()
    let output = study + "/incoming-evaluation-\{seed}"
    ignore(
      run_command(root + "/scripts/run_native_learning.mbtx", [
        root + "/providers/motion_learning/policy.py",
        "evaluate",
        "--checkpoint",
        args[2] + "/actor-seed-\{seed}.moon.json",
        "--scene",
        root + "/target/mujoco_menagerie/unitree_g1/scene_mjx.xml",
        "--config",
        study + "/policy-config.json",
        "--experiment",
        root + "/examples/learning/g1-long-experiment.json",
        "--output",
        output,
      ]),
    )
    let incoming = read(output + "/physics.json")
    let selected = read(study + "/policy/physics-seed-\{seed}.json")
    let old_candidate = field(incoming, "candidate")
    let new_candidate = field(selected, "candidate")
    if field(run, "selected_update") == (0 : Json) {
      guard field(old_candidate, "trials") is Array(before) &&
        field(new_candidate, "trials") is Array(after) else {
        fail("missing physics trials")
      }
      assert_eq(before.length(), after.length())
      for i in 0..<before.length() {
        for
          key in [
            "case_id", "seed", "replay", "failed", "end_reason", "simulated_seconds",
            "joint_rmse_rad",
          ] {
          assert_eq(
            field(before[i], key),
            field(after[i], key),
            msg="update-zero replay changed: " + key,
          )
        }
      }
    }
    comparisons.push({
      "seed": seed.to_json(),
      "selected_update": field(run, "selected_update"),
      "incoming": field(old_candidate, "summary"),
      "selected": field(new_candidate, "summary"),
      "qualifies": field(run, "qualifies"),
    })
  }
  let summary : Json = {
    "format": "moonrobo.g1-invariant-comparison.v1",
    "comparisons": comparisons.to_json(),
    "tail_probe": read(study + "/tail-probe/summary.json"),
    "translation_probe": read(study + "/translation-probe/summary.json"),
    "physical_execution_allowed": false,
  }
  @fs.write_file(
    args[4],
    summary.stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  println(comparisons.to_json().stringify(indent=2))
}

///|
/// Checkpoint copies are validated or converted by the reviewed native loader.
fn native_checkpoint_copy_command(
  exe : String,
  args : Array[String],
) -> (String, Array[String])? raise {
  if exe != "/bin/cp" || args.length() < 2 {
    return None
  }
  if !args[0].has_suffix(".moon.json") &&
    !args[0].has_suffix(".pt") &&
    !args[1].has_suffix(".moon.json") {
    return None
  }
  guard args.length() == 2 && args[1].has_suffix(".moon.json") else {
    fail("checkpoint copies require SOURCE and native .moon.json DESTINATION")
  }
  let name = args[0].split("/").last().unwrap_or("").to_owned()
  let kind = if name.contains("dynamics-seed-") {
    "residual-dynamics"
  } else if name.contains("actor-seed-") {
    "g1-actor"
  } else {
    fail("unreviewed checkpoint copy kind: " + name)
  }
  let root = @env.args()[1]
  Some(
    (
      root,
      [
        "run",
        root + "/scripts/run_native_learning.mbtx",
        root,
        "src/learning_training/launch/cmd",
        "checkpoint-copy",
        args[0],
        args[1],
        kind,
      ],
    ),
  )
}

///|
/// Structured native dispatch. A .py argument is a reviewed provider descriptor, never an executable or an interpreter fallback.
async fn native_collect_output(
  exe : String,
  args : Array[String],
) -> (Int32, &@io.Data, &@io.Data) {
  let suffix = "/scripts/run_native_learning.mbtx"
  if exe.has_suffix(suffix) {
    let root = exe[:exe.length() - suffix.length()].to_owned()
    let command = ["run", exe, root, "src/learning_training/launch/cmd"]
    command.append(args)
    return @process.collect_output("moon", command, cwd=root)
  }
  if native_checkpoint_copy_command(exe, args) is Some((root, command)) {
    return @process.collect_output("moon", command, cwd=root)
  }
  @process.collect_output(exe, args)
}

///|
async fn native_process_run(
  exe : String,
  args : Array[String],
  stdout? : &@process.ProcessOutput,
  stderr? : &@process.ProcessOutput,
) -> Int32 {
  let suffix = "/scripts/run_native_learning.mbtx"
  if exe.has_suffix(suffix) {
    let root = exe[:exe.length() - suffix.length()].to_owned()
    let command = ["run", exe, root, "src/learning_training/launch/cmd"]
    command.append(args)
    return @process.run("moon", command, cwd=root, stdout?, stderr?)
  }
  if native_checkpoint_copy_command(exe, args) is Some((root, command)) {
    return @process.run("moon", command, cwd=root, stdout?, stderr?)
  }
  @process.run(exe, args, stdout?, stderr?)
}
