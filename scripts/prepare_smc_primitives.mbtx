import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/fs", "moonbitlang/async@0.20.2/process" }
fn replace(s : String,a : String,b : String) -> String raise {guard s.contains(a) else {fail(a)};s.replace_all(old=a,new=b)}
async fn run(cmd : String,args : Array[String]) -> Unit {guard @process.run(cmd,args)==0 else {fail(cmd)}}
async fn main {
  let repo="/Users/kq/Workspace/moonrobo"
  let prev=repo+"/output/spark-runtime-20261024/smc-algebra-20261028"
  let out=repo+"/output/spark-runtime-20261024/smc-primitives-20261028"
  @fs.mkdir(out,recursive=true)
  let base="/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host="wlc004s@192.168.2.179"
  let socket="/tmp/moonrobo-operator-179.sock"
  let geometry=@fs.read_file(repo+"/src/learning_aligned_gpu/geometry/geometry_test.mbt").text()
  let blocks=geometry.split("///|").collect()
  let selected=blocks.filter(b=>b.contains("test \"zero pivot FK specialization"))
  guard selected.length()==1 else {fail("geometry fixture")}
  let cross=replace(replace(replace(selected[0].to_owned(),"zero pivot FK specialization","native cross FK"),"SKIP zero pivot FK integration","SKIP native cross FK integration"),".with_zero_joint_pivot(true)",".with_native_cross(true)")
  @fs.write_file(repo+"/src/learning_aligned_gpu/geometry/native_cross_test.mbt","///|"+cross,create_mode=CreateNew)
  let mut fixture=@fs.read_file(prev+"/algebra_fixture_a.mbt").text()
  fixture=fixture.split("\n").map(line=>{
    let t=line.trim()
    if t.has_prefix("smc_world_rotation:") {"      smc_world_rotation: false,"}
    else if t.has_prefix("smc_xi_normalization:") {"      smc_xi_normalization: false,"}
    else if t.has_prefix("smc_actor_return:") {"      smc_actor_return: false,"}
    else {line.to_owned()}
  }).collect().join("\n")
  for (key,variant) in [("native_cross","cross"),("world_norm_snapshot","snapshot")] {
    fixture=replace(fixture,"      reuse_geometry: true,","      "+key+": @env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\""+variant+"\") || @env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"both\"),\n      reuse_geometry: true,")
  }
  @fs.write_file(out+"/primitives_fixture_a.mbt",fixture,create_mode=CreateNew)
  let mut builder=@fs.read_file(prev+"/build_algebra_b.mbtx").text()
  for (a,b) in [("smc-algebra","smc-primitives"),("algebra-b","primitives-a"),("primitive-cpu-b","primitive-cpu-a"),("geometry-cpu-b","geometry-cpu-a"),("pivot-cpu-b","pivot-cpu-a"),("config-cpu-b","config-cpu-a"),("resume-cpu-b","resume-cpu-a"),("inference-cpu-b","inference-cpu-a"),("gate-b","gate-a"),("tensor-b","tensor-a"),("runtime-b","runtime-a"),("tests-b","tests-a"),("libmoonrobo_smc_algebra_a.so","libmoonrobo_smc_primitives_a.so"),("smc_algebra_test.mbt:0-3","native_cross_test.mbt:0-1"),("geometry_test.mbt:0-1","native_cross_test.mbt:0-1"),("optimizations_wbtest.mbt:0-4","optimizations_wbtest.mbt:0-5"),("precision_wbtest.mbt:0-1","world_norm_snapshot_wbtest.mbt:0-1")] {
    // The workspace suffix is changed below; other replacements require a source match.
    if builder.contains(a) {builder=replace(builder,a,b)}
  }
  builder=replace(builder,"moonrobo-smc-primitives-b","moonrobo-smc-primitives-a")
  builder=replace(builder,"gate-auild","gate-build")
  @fs.write_file(out+"/build_primitives_a.mbtx",builder,create_mode=CreateNew)
  let mut driver=@fs.read_file(prev+"/run_algebra_b.mbtx").text()
  for (a,b) in [("smc-algebra-gate-b","smc-primitives-gate-a"),("run_algebra_b.mbtx","run_primitives_a.mbtx"),("build_algebra_b.mbtx","build_primitives_a.mbtx"),("algebra_fixture_a.mbt","primitives_fixture_a.mbt"),("libmoonrobo_smc_algebra_a.so","libmoonrobo_smc_primitives_a.so"),("\"world\", \"xi\", \"return\", \"all\"","\"cross\", \"snapshot\", \"both\""),("hotspot-shared-algebra-all-","hotspot-shared-primitives-baseline-")] {driver=replace(driver,a,b)}
  @fs.write_file(out+"/run_primitives_a.mbtx",driver,create_mode=CreateNew)
  let wrapper=replace(@fs.read_file(prev+"/invoke_algebra_b.mbtx").text(),"run_algebra_b.mbtx","run_primitives_a.mbtx")
  @fs.write_file(out+"/invoke_primitives_a.mbtx",wrapper,create_mode=CreateNew)
  for file in ["primitives_fixture_a.mbt","build_primitives_a.mbtx","run_primitives_a.mbtx","invoke_primitives_a.mbtx"] {
    run("scp",["-o","ControlPath="+socket,out+"/"+file,host+":"+base+"/"+file])
  }
  run("ssh",["-S",socket,host,"test ! -e "+base+"/workspace/moonrobo-smc-primitives-a"])
  run("ssh",["-S",socket,host,"cp -a --reflink=auto "+base+"/workspace/moonrobo-smc-algebra-b "+base+"/workspace/moonrobo-smc-primitives-a"])
  for path in ["execution_optimizations.mbt","learning.mbt","microbatch.mbt","world_norm_snapshot.mbt","world_norm_snapshot_wbtest.mbt","moon.pkg","geometry/context.mbt","geometry/native_cross_test.mbt","geometry/moon.pkg","cmd/optimizations.mbt","cmd/optimizations_wbtest.mbt"] {
    run("scp",["-o","ControlPath="+socket,repo+"/src/learning_aligned_gpu/"+path,host+":"+base+"/workspace/moonrobo-smc-primitives-a/src/learning_aligned_gpu/"+path])
  }
  for path in ["native_cross.inc","native_cross_loader.inc","native_cross.mbt","native_cross_test.mbt","adapter.cpp","loader.c","moon.pkg"] {
    run("scp",["-o","ControlPath="+socket,repo+"/src/learning_tensor/"+path,host+":"+base+"/workspace/moonrobo-smc-primitives-a/src/learning_tensor/"+path])
  }
  run("ssh",["-S",socket,host,"cp "+base+"/primitives_fixture_a.mbt "+base+"/workspace/moonrobo-smc-primitives-a/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt"])
  for mode in ["plugin","gate-build-smc-primitives-a","smc-primitives-tests-a"] {
    run("ssh",["-S",socket,host,"env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native "+base+"/build_primitives_a.mbtx -- "+mode])
  }
}
