///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn field(j : Json, key : String) -> Json raise {
  guard j is Object(fields) && fields.get(key) is Some(value) else {
    fail("Missing field: " + key)
  }
  value
}

///|
async fn run(program : String, args : Array[String]) -> String {
  let (code, out, err) = @process.collect_output(program, args)
  guard code == 0 else {
    fail("\{program} exited \{code}: \{out.text()} \{err.text()}")
  }
  out.text()
}

///|
async fn main {
  let args = @env.args()
  let socket = args.get(1).unwrap()
  // A required file records the actual operator request. This helper only
  // prepares a gate receipt; it never invokes the physical execute command.
  let approval_source = @json.parse(@fs.read_file(args.get(2).unwrap()).text())
  let version = field(approval_source, "neck_profile_version")
  let maximum_degrees = match version {
    "2" => 5
    "5" | "6" => {
      for
        (key, expected) in [
          ("neck_travel_limit_degrees", "30"),
          ("raw_feedback_velocity_limit", "100"),
          ("completion_policy", "stable-hold-with-accuracy"),
          ("target_accuracy_ticks", "11"),
          ("tracking_error_limit_ticks", "16"),
        ] {
        guard field(approval_source, key) == Json(expected) else {
          fail(
            "Profile 5/6 authorization must explicitly bind " +
            key +
            "=" +
            expected,
          )
        }
      }
      if version == Json("6") {
        for
          (key, expected) in [
            ("maximum_step_ticks", "2"),
            ("minimum_step_interval_ms", "50"),
            ("maximum_target_slew_ticks_per_second", "40"),
          ] {
          guard field(approval_source, key) == Json(expected) else {
            fail("Profile 6 authorization must explicitly bind " + key)
          }
        }
      }
      30
    }
    "3" | "4" => {
      guard field(approval_source, "neck_travel_limit_degrees") == Json("10") else {
        fail("Wide-range authorization must explicitly bind ten-degree travel")
      }
      if version == Json("4") {
        guard field(approval_source, "raw_feedback_velocity_limit") ==
          Json("100") else {
          fail(
            "Profile 4 needs explicit authorization of raw velocity limit 100",
          )
        }
      }
      10
    }
    _ => fail("Unknown neck profile version")
  }
  let action = field(approval_source, "action")
  let plan_action = match action {
    ["ReturnToStart", pan, tilt] if version == Json("6") => {
      let pan : Int32 = @json.from_json(pan)
      let tilt : Int32 = @json.from_json(tilt)
      guard pan >= 1586 && pan <= 2268 && tilt >= 1706 && tilt <= 2388 else {
        fail("Return pose outside commissioned envelope")
      }
      "return-start \{pan} \{tilt}"
    }
    ["Sweep", degrees] if version == Json("6") => {
      let degrees : Int32 = @json.from_json(degrees)
      guard degrees >= 1 && degrees <= maximum_degrees else {
        fail("Sweep requires reviewed 1..30 degree range")
      }
      "sweep \{degrees}"
    }
    [String(mode), seconds] if mode == "Joystick" || mode == "Buttons" => {
      let seconds : Int32 = @json.from_json(seconds)
      guard seconds >= 1 && seconds <= 300 else {
        fail(
          "Joystick duration must be within the existing 1..300 second limit",
        )
      }
      "\{if mode == "Buttons" { "buttons" } else { "joystick" }} \{seconds}"
    }
    ["Jog", String(direction), degrees] => {
      let degrees : Int32 = @json.from_json(degrees)
      guard degrees >= 1 && degrees <= maximum_degrees else {
        fail(
          "Jog must be within the reviewed 1..\{maximum_degrees} degree limit",
        )
      }
      let name = match direction {
        "Left" => "left"
        "Up" => "up"
        "Right" => "right"
        "Down" => "down"
        _ => fail("Unknown neck direction")
      }
      "\{name} \{degrees}"
    }
    _ => fail("Need an exact bounded Joystick, Buttons or Jog authorization")
  }
  guard field(approval_source, "operator_authorized") == Json(true) &&
    field(approval_source, "servo_speed_limit") == Json("50") else {
    fail(
      "Need explicit authorization for this exact bounded trial and speed profile",
    )
  }
  let ssh = ["-S", socket, "-o", "BatchMode=yes", "elf@192.168.2.192"]
  let base = @env.current_dir().unwrap() + "/_build/neck-control-elf"
  let plan_text = run(
    "ssh",
    ssh + ["/home/elf/moonrobo-neck/neck-control plan " + plan_action],
  )
  let plan = @json.parse(plan_text)
  guard field(field(plan, "simulation"), "simulated") == Json(true) &&
    field(field(field(plan, "simulation"), "report"), "completed") == Json(true) else {
    fail("Exact-action MoonBit simulation did not complete")
  }
  let intent = field(plan, "intent")
  let parameters = field(intent, "parameters")
  let planned_action_text : String = @json.from_json(
    field(parameters, "action"),
  )
  guard @json.parse(planned_action_text) == action &&
    field(parameters, "neck_profile_version") ==
    field(approval_source, "neck_profile_version") &&
    field(parameters, "servo_speed_limit") ==
    field(approval_source, "servo_speed_limit") else {
    fail(
      "Installed plan differs from the operator-reviewed action or speed profile",
    )
  }
  if version == Json("3") ||
    version == Json("4") ||
    version == Json("5") ||
    version == Json("6") {
    guard field(parameters, "neck_travel_limit_degrees") ==
      field(approval_source, "neck_travel_limit_degrees") else {
      fail("Installed plan differs from the reviewed travel envelope")
    }
  }
  if version == Json("4") || version == Json("5") || version == Json("6") {
    guard field(parameters, "raw_feedback_velocity_limit") ==
      field(approval_source, "raw_feedback_velocity_limit") else {
      fail("Installed plan differs from the reviewed velocity limit")
    }
  }
  if version == Json("5") || version == Json("6") {
    for
      key in [
        "completion_policy", "target_accuracy_ticks", "tracking_error_limit_ticks",
      ] {
      guard field(parameters, key) == field(approval_source, key) else {
        fail("Installed plan differs from reviewed " + key)
      }
    }
  }
  if version == Json("6") {
    for
      key in [
        "maximum_step_ticks", "minimum_step_interval_ms", "maximum_target_slew_ticks_per_second",
      ] {
      guard field(parameters, key) == field(approval_source, key) else {
        fail("Installed plan differs from reviewed " + key)
      }
    }
  }
  let intent_id : String = @json.from_json(field(intent, "intent_id"))
  let root = base + "/trials/" + intent_id
  @fs.mkdir(root, recursive=true)
  @fs.write_file(root + "/plan.json", plan_text)
  @fs.write_file(
    root + "/robot.json",
    field(plan, "profile").stringify(indent=2),
  )
  @fs.write_file(
    root + "/operator-source.json",
    approval_source.stringify(indent=2),
  )
  let api = @env.current_dir().unwrap() +
    "/_build/native/debug/build/vectie/moonrobo/cmd/main/main.exe"
  let dry_id = "dry-" + intent_id
  let mut approval_id = ""
  let mut ready : Json = Json(false)
  for stage in ["dry-run", "approve", "evaluate"] {
    // Evaluate the timestamped source snapshot at its recorded observation
    // time, not at an invented cross-host clock offset. The resulting receipt
    // has the existing 60-second expiry. The actuator independently reads and
    // enforces fresh <=150 ms feedback on ELF before every physical write.
    let transport_start = @env.now().reinterpret_as_int64()
    let status_text = run(
      "ssh",
      ssh + ["/home/elf/moonrobo-neck/neck-control preflight"],
    )
    let preflight = @json.parse(status_text)
    let status = field(preflight, "report")
    guard field(status, "completed") == Json(true) &&
      field(status, "holding") == Json(true) else {
      fail("Read-only servo preflight failed")
    }
    @fs.write_file(root + "/status-" + stage + ".json", status_text)
    let started : Int64 = @json.from_json(field(preflight, "started_epoch_ms"))
    let now : Int64 = @json.from_json(field(preflight, "finished_epoch_ms"))
    let elapsed = now - started
    guard elapsed >= 0L && elapsed <= 150L else {
      fail(
        "Servo preflight took \{elapsed} ms, exceeding the existing freshness gate; no grant",
      )
    }
    @fs.write_file(
      root + "/snapshot-time-" + stage + ".json",
      (
        {
          "evaluated_at_source_epoch_ms": Json(now),
          "source_feedback_age_upper_bound_ms": Json(elapsed),
          "transport_round_trip_ms": Json(
            @env.now().reinterpret_as_int64() - transport_start,
          ),
          "dispatch_fresh_feedback_required_on_elf": true,
        } : Json).stringify(indent=2),
    )
    let body : Json = {
      "intent_id": Json(intent_id),
      "robot_id": "noetix-e1-neck",
      "capability": "control.low.neck",
      "parameters": field(intent, "parameters"),
      "requester": field(intent, "requested_by"),
      "receipt_id": Json(stage + "-" + intent_id),
      "now_ms": Json(now),
      "approval_id": Json(if stage == "evaluate" { approval_id } else { "" }),
      "dry_run_receipt_id": Json(dry_id),
      "developer_gate": true,
      "telemetry_age_ms": Json(elapsed.to_int()),
    }
    let response_text = run(api, [
      "api-route",
      root,
      "POST",
      "/api/intents/" + stage,
      body.stringify(),
    ])
    @fs.write_file(root + "/" + stage + "-response.json", response_text)
    let response = @json.parse(response_text)
    guard field(response, "persisted") == Json(true) else {
      fail("Gate did not persist " + stage)
    }
    let result = field(response, "result")
    if stage == "approve" {
      // The API generates its approval ID from intent and timestamp unless
      // an explicit ID was provided. Use the ID it actually persisted.
      let approval = field(response, "approval")
      guard field(approval, "intent") == intent else {
        fail("Approval intent differs from exact simulated action")
      }
      approval_id = @json.from_json(field(approval, "approval_id"))
      @fs.write_file(root + "/approval.json", approval.stringify(indent=2))
    }
    if stage == "evaluate" {
      ready = field(result, "receipt")
      guard field(ready, "status") == Json("ReadyForExecution") &&
        field(field(ready, "verdict"), "decision") == Json("Allow") else {
        fail("MoonRobo gate denied this trial: " + response_text)
      }
    }
  }
  let receipt = root + "/ready.json"
  @fs.write_file(receipt, ready.stringify(indent=2))
  run("scp", [
    "-o",
    "ControlPath=" + socket,
    "-r",
    root,
    "elf@192.168.2.192:/home/elf/moonrobo-neck/",
  ])
  |> ignore
  println(
    (
      {
        "physical_execution": false,
        "trial": Json(root),
        "remote_receipt": Json(
          "/home/elf/moonrobo-neck/" + intent_id + "/ready.json",
        ),
        "action": field(ready, "intent"),
      } : Json).stringify(indent=2),
  )
}
