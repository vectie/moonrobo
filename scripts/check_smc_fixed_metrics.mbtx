import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/process", "moonbitlang/async@0.20.2/fs" }
let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
async fn main {
  for (implementation,label) in [("native","fix-aligned-actor-gate-b"),("smc-eager","fix-smc-eager-actor-gate-b")] {
    println("Starting "+label)
    let code=@process.run("/home/wlc004s/moonrobo/toolchain/bin/moon",["run","--target","native",base+"/run_smc_fix_b.mbtx","--","actor",implementation,"off","1",label,"aligned"],
      stdout=@process.redirect_to_file(base+"/"+label+".stdout.log",create_mode=CreateNew),stderr=@process.redirect_to_file(base+"/"+label+".stderr.log",create_mode=CreateNew))
    @fs.write_file(base+"/"+label+".exit.json",({"exit_code":Json(code)}:Json).stringify(),create_mode=CreateNew)
    println("Completed "+label+" exit="+code.to_string())
    if implementation=="native" && code!=0 { fail("native gate failed") }
  }
}
