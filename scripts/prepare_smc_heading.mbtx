import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/fs", "moonbitlang/async@0.20.2/process" }
async fn run(cmd : String, args : Array[String]) -> Unit { guard @process.run(cmd,args) == 0 else { fail(cmd) } }
fn replace(s : String, a : String, b : String) -> String raise {
  guard s.contains(a) else { fail("missing " + a) }
  s.replace_all(old=a,new=b)
}
async fn main {
  let repo = "/Users/kq/Workspace/moonrobo"
  let prev = repo + "/output/spark-runtime-20261024/smc-source-fixes-20261027"
  let out = repo + "/output/spark-runtime-20261024/smc-heading-20261027"
  @fs.mkdir(out,recursive=true)
  let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host = "wlc004s@192.168.2.179"
  let socket = "/tmp/moonrobo-operator-179.sock"
  let mut fixture = @fs.read_file(prev+"/smc_fix_fixture_b.mbt").text()
  fixture = replace(fixture,"@env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"aligned\")","(@env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"aligned\") || @env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"heading\"))")
  fixture = replace(fixture,"      reuse_geometry: true,","      heading_mode: if @env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"heading\") { @geometry.SmcProjected } else { @geometry.StableFallback },\n      reuse_geometry: true,")
  fixture = replace(fixture,"rotation_error_mode: Some(learner.optimizations.rotation_error_mode)","rotation_error_mode: Some(learner.optimizations.rotation_error_mode), heading_mode: Some(learner.optimizations.heading_mode)")
  @fs.write_file(out+"/heading_fixture_a.mbt",fixture,create_mode=CreateNew)
  let mut builder = @fs.read_file(prev+"/build_smc_fix_b.mbtx").text()
  for (a,b) in [("smc-fix-b","smc-heading-a"),("smc-fix-gate-b","smc-heading-gate-a"),("smc-fix-tensor-b","smc-heading-tensor-a"),("smc-fix-runtime-b","smc-heading-runtime-a"),("smc-fix-tests-b","smc-heading-tests-a"),("smc-fix-rotation-cpu-b","smc-heading-geometry-cpu-a"),("smc-fix-config-cpu-b","smc-heading-config-cpu-a"),("smc-fix-resume-cpu-b","smc-heading-resume-cpu-a"),("smc-fix-inference-cpu-b","smc-heading-inference-cpu-a"),("rotation_error_wbtest.mbt:0-1","heading_wbtest.mbt:0-1")] { builder=replace(builder,a,b) }
  @fs.write_file(out+"/build_heading_a.mbtx",builder,create_mode=CreateNew)
  let mut driver = @fs.read_file(prev+"/run_smc_fix_b.mbtx").text()
  for (a,b) in [("smc-fix-gate-b","smc-heading-gate-a"),("run_smc_fix_b.mbtx","run_heading_a.mbtx"),("smc_fix_fixture_b.mbt","heading_fixture_a.mbt"),("build_smc_fix_b.mbtx","build_heading_a.mbtx"),("\"rotation\", \"linear\"","\"rotation\", \"linear\", \"heading\""),("hotspot-shared-fix-aligned-","hotspot-shared-heading-")] { driver=replace(driver,a,b) }
  // New candidate results get their own immutable baseline directory.
  driver=replace(driver,"+ phase + \"-gate-b\")","+ phase + \"-gate-a\")")
  @fs.write_file(out+"/run_heading_a.mbtx",driver,create_mode=CreateNew)
  let wrapper = replace(@fs.read_file(repo+"/scripts/run_smc_source_fixes.mbtx").text(),"run_smc_fix_a.mbtx","run_heading_a.mbtx")
  @fs.write_file(out+"/invoke_heading_a.mbtx",wrapper,create_mode=CreateNew)
  for file in ["heading_fixture_a.mbt","build_heading_a.mbtx","run_heading_a.mbtx","invoke_heading_a.mbtx"] {
    run("scp",["-o","ControlPath="+socket,out+"/"+file,host+":"+base+"/"+file])
  }
  run("ssh",["-S",socket,host,"test ! -e "+base+"/workspace/moonrobo-smc-heading-a"])
  run("ssh",["-S",socket,host,"cp -a --reflink=auto "+base+"/workspace/moonrobo-smc-fix-b "+base+"/workspace/moonrobo-smc-heading-a"])
  for path in ["execution_optimizations.mbt","checkpoint.mbt","audit.mbt","audit_wbtest.mbt","precision_wbtest.mbt","learning.mbt","microbatch.mbt","actor_microbatch.mbt","world_error_batched.mbt","geometry/rotations.mbt","geometry/state.mbt","geometry/context.mbt","geometry/heading_wbtest.mbt","cmd/optimizations.mbt","cmd/optimizations_wbtest.mbt","inference/actor_wbtest.mbt"] {
    run("scp",["-o","ControlPath="+socket,repo+"/src/learning_aligned_gpu/"+path,host+":"+base+"/workspace/moonrobo-smc-heading-a/src/learning_aligned_gpu/"+path])
  }
  run("ssh",["-S",socket,host,"cp "+base+"/heading_fixture_a.mbt "+base+"/workspace/moonrobo-smc-heading-a/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt"])
  for mode in ["gate-build-smc-heading-a","smc-heading-tests-a"] {
    run("ssh",["-S",socket,host,"env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native "+base+"/build_heading_a.mbtx -- "+mode])
  }
}
