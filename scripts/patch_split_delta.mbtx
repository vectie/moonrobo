import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/fs" }
async fn edit(path : String,changes : Array[(String,String)]) -> Unit {
  let p="/Users/kq/Workspace/moonrobo/"+path;let mut s=@fs.read_file(p).text()
  for (a,b) in changes {guard s.contains(a)else{fail(path+": "+a)};s=s.replace_all(old=a,new=b)}
  @fs.write_file(p,s)
}
async fn main {
  edit("src/learning_tensor/adapter.cpp",[("#include \"compact_heading.inc\"","#include \"compact_heading.inc\"\n#include \"split_sections.inc\"")])
  edit("src/learning_tensor/loader.c",[("#include \"compact_heading_loader.inc\"","#include \"compact_heading_loader.inc\"\n#include \"split_sections_loader.inc\"")])
  edit("src/learning_tensor/moon.pkg",[("    \"compact_heading.mbt\":","    \"split_sections.mbt\": [ \"native\" ],\n    \"split_sections_test.mbt\": [ \"native\" ],\n    \"compact_heading.mbt\":")])
  edit("src/learning_aligned_gpu/execution_optimizations.mbt",[("  compact_heading : Bool","  split_world_delta : Bool\n  compact_heading : Bool"),("    compact_heading: false,","    split_world_delta: false,\n    compact_heading: false,")])
  edit("src/learning_aligned_gpu/cmd/optimizations.mbt",[("    compact_heading: setting", "    split_world_delta: setting(config, \"split_world_delta\", false),\n    compact_heading: setting"),("  if s.optimizations.compact_heading {","  if s.optimizations.split_world_delta { values[\"execution_split_world_delta\"] = 33554432L }\n  if s.optimizations.compact_heading {")])
  edit("src/learning_aligned_gpu/geometry/state.mbt",[("  compact_skew~ : Bool = false,","  compact_skew~ : Bool = false,\n  split_delta~ : Bool = false,"),("  {\n    p: s.p.add(","  let sections = if split_delta { Some(delta.split_sections([3,3,3,3,29,29])) } else { None }\n  let part = (offset : Int, count : Int, i : Int) => {\n    match sections { Some(parts) => parts[i]; None => delta.narrow(1,offset,count) }\n  }\n  {\n    p: s.p.add("),("delta.narrow(1, 0, 3)","part(0,3,0)"),("delta.narrow(1, 3, 3)","part(3,3,1)"),("delta.narrow(1, 6, 3)","part(6,3,2)"),("delta.narrow(1, 9, 3)","part(9,3,3)"),("delta.narrow(1, 12, 29)","part(12,29,4)"),("delta.narrow(1, 41, 29)","part(41,29,5)")])
  for path in ["learning.mbt","actor_microbatch.mbt","microbatch.mbt"] {edit("src/learning_aligned_gpu/"+path,[("compact_skew=self.optimizations.compact_skew,","compact_skew=self.optimizations.compact_skew,\n        split_delta=self.optimizations.split_world_delta,")])}
  edit("src/learning_aligned_gpu/learning.mbt",[("  if optimizations.compact_skew {","  if optimizations.split_world_delta { guard backend.has_split_sections() else { fail(\"native split extension required\") } }\n  if optimizations.compact_skew {")])
  edit("src/learning_aligned_gpu/cmd/optimizations_wbtest.mbt",[("    { \"compact_heading\": \"true\" },","    { \"split_world_delta\": \"true\" },\n    { \"compact_heading\": \"true\" },")])
}
