///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/process",
}

///|
async fn main {
  let base = "/home/wlc004s/moonrobo/private/hotspot-optimization-20261025-b"
  let old = "/home/wlc004s/moonrobo/private/operator-diagnostic-20261025-a"
  async fn run(label : String, script : String, args : Array[String]) -> Unit {
    println("Starting " + label)
    guard @process.run("/home/wlc004s/moonrobo/toolchain/bin/moon", ["run", "--target", "native", script, "--", ..args],
      stdout=@process.redirect_to_file(base + "/pairs-20261026-a-" + label + ".stdout.log", create_mode=CreateNew),
      stderr=@process.redirect_to_file(base + "/pairs-20261026-a-" + label + ".stderr.log", create_mode=CreateNew)) == 0 else {
      fail(label + " failed; stop and retain evidence; no guard or tolerance change")
    }
    println("Completed " + label)
  }
  run("closed-build-pages", old + "/advise_hotspot_recent_cache_e.mbtx", ["--host-build", "cache-hotspot-before-candidate-pairs-build-20261026-a.json"])
  run("closed-image-pages", old + "/advise_closed_smc_image_pages_f.mbtx", ["--advise", "cache-hotspot-before-candidate-pairs-image-20261026-a.json"])
  for mode in ["layernorm", "cross", "reference_fk"] {
    run(mode + "-freeze", base + "/prepare_hotspot_candidates.mbtx", [mode, "bulk", "false"])
    run(mode + "-series", base + "/run_hotspot_candidate_series.mbtx", [mode, "20261026-a"])
    let root = "/home/wlc004s/moonrobo/runs/hotspot-" + mode + "-abba-20261026-a"
    run(mode + "-summary", base + "/summarize_hotspot_pairs.mbtx", [root, root + "/summary.json"])
  }
  println("All three numerical-gated candidate ABBA groups completed and independently summarized")
}
