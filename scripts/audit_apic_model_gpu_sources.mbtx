        "array.h",
        "f85ab644afcf70be5b9feb6097fd9ffe4dfe22d5f88948c511609dac60b2d07a",
        ["struct array_t", "inline size_t byte_offset(", "inline T& index("],
        "warp-array-byte-stride-abi",
      ),
      (
        "warp.h",
        "8dba30fadc4315eb7d08795888b822c2d7e30b4a0057861c5d41431310cf8c8b",
        [
          "wp_cuda_graph_begin_capture(", "wp_cuda_graph_insert_while(", "wp_cuda_load_module(",
