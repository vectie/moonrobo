      ),
    ] {
    let path = "warp/native/" + file
    sources.push({
      subsystem,
      project: "Warp",
      pin: "v1.17.0",
      path,
      cached: "warp-1.17.0/" + path,
      sha,
      symbols,
    })
  }
  for
    (file, path, sha, symbols) in [
