///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
}

///|
struct Source {
  subsystem : String
  project : String
  pin : String
  path : String
  cached : String
  sha : String
  symbols : Array[String]
}

///|
fn digest(bytes : Bytes) -> String {
  let mut result = ""
  for byte in @crypto.sha256(bytes) {
    result += byte.to_hex()
  }
  result
}

///|
/// Pure filesystem/text/crypto metadata only. No child process, SDK import,
/// native library, numerical algorithm, GPU or compiler entry is available.
async fn main {
  let args = @env.args()
  guard args.length() == 3 || (args.length() == 4 && args[3] == "--verify") else {
