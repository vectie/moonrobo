  }
  sources.push({
    subsystem: "independent-mujoco-c-rigid-position-prerequisites",
    project: "MuJoCo",
    pin: "3.3.7",
    path: "src/engine/engine_forward.c",
    cached: "moonrobo-mujoco-3.3.7-forward.c",
    sha: "9ee0dbe90e55a74f9a2de89ffe38666245c5d3f15c41f825cc05db21a971641d",
    symbols: [
      "void mj_fwdPosition(", "mj_kinematics(m, d);", "mj_comPos(m, d);", "mj_collision(m, d);",
    ],
  })
  let rows : Array[Json] = []
  for source in sources {
    let bytes = @fs.read_file(cache + "/" + source.cached).binary()
    guard digest(bytes) == source.sha else {
      fail("fixed source SHA changed: " + source.path)
    }
    let lines = @utf8.decode(bytes).split("\n").collect()
    let anchors : Array[Json] = []
    for symbol in source.symbols {
      guard lines.find_index(line => line.contains(symbol)) is Some(index) else {
        fail("source anchor missing: " + source.path + ":" + symbol)
      }
      anchors.push({ "symbol": symbol.to_json(), "line": (index + 1).to_json() })
    }
    let url = match source.project {
      "Newton" =>
        "https://raw.githubusercontent.com/newton-physics/newton/" +
        source.pin +
        "/" +
        source.path
      "IsaacLab" =>
        "https://raw.githubusercontent.com/isaac-sim/IsaacLab/" +
        source.pin +
        "/" +
        source.path
      "Warp" =>
        "https://raw.githubusercontent.com/NVIDIA/warp/v1.17.0/" + source.path
      "MuJoCo" =>
        "https://raw.githubusercontent.com/google-deepmind/mujoco/3.3.7/" +
        source.path
      _ =>
        "https://files.pythonhosted.org/packages/53/e1/409fb2d422e36496fd01d76f432b9f32969bfadd00ad0a5478735ed6f029/mujoco_warp-3.15.0.tar.gz"
    }
    rows.push({
      "subsystem": source.subsystem.to_json(),
      "project": source.project.to_json(),
      "pin": source.pin.to_json(),
      "source_path": source.path.to_json(),
      "cached_relative_path": source.cached.to_json(),
      "source_url": url.to_json(),
      "sha256": source.sha.to_json(),
      "bytes": bytes.length().to_json(),
      "anchors": anchors.to_json(),
    })
  }
  let prior = @fs.read_file(
    root + "/docs/APIC_FINALIZE_SOLVER_SOURCE_EVIDENCE.json",
  ).binary()
  let result : Json = {
    "format": "moonrobo.apic-model-gpu-source-evidence.v1",
    "scope": "Fixed primary source hashes and lexical anchors only; native infrastructure, independent MuJoCo 3.3.7 collision and actual MuJoCo-Warp 3.15 physics migration are distinct",
    "sources": rows.to_json(),
    "prior_finalize_evidence_sha256": digest(prior).to_json(),
    "mujoco_warp_archive_sha256": archive_sha.to_json(),
    "mujoco_c_api_version": "3.3.7 / header 337 / Double",
    "mujoco_c_api_is_mujoco_warp_3_15_port": false,
    "source_bytes_only": true,
    "child_processes_started": false,
    "upstream_code_executed": false,
    "numerical_algorithms_executed": false,
    "tests_executed": false,
    "sdk_initialized": false,
    "gpu_initialized": false,
    "model_compiled": false,
    "kernel_compiled": false,
    "apic_exported": false,
    "full_newton_model_closure_verified": false,
    "full_gpu_solver_closure_verified": false,
  }
  let output = root + "/docs/APIC_MODEL_GPU_SOURCE_EVIDENCE.json"
  if args.length() == 4 {
    guard @json.parse(@fs.read_file(output).text()) == result else {
      fail("model/GPU source evidence differs from fixed source identities")
    }
  } else {
    @fs.write_file(
      output,
      result.stringify(indent=2) + "\n",
      create_mode=CreateOrTruncate,
    )
  }
  println(
    "Verified " +
    rows.length().to_string() +
    " model/GPU primary source identities; metadata only",
  )
}
