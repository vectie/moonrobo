      ),
      (
        "apic.h",
        "2a82b6b4185a28279e2d1ce0937147d9ba59b9b89ad32c58b82ab6c1582899da",
        [
          "wp_apic_register_memory_region(", "wp_apic_register_module(", "wp_apic_register_kernel(",
          "wp_apic_state_save(",
