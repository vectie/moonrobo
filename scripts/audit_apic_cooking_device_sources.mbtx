///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
}

///|
struct Source {
  subsystem : String
  project : String
  path : String
  cached : String
  sha : String
  symbols : Array[String]
}

///|
fn digest(bytes : Bytes) -> String {
  let mut result = ""
  for byte in @crypto.sha256(bytes) {
    result += byte.to_hex()
  }
  result
}

///|
/// Reads pinned source bytes, lexical anchors and SHA256 only. No process,
/// native library, Python AST, compiler, numerical algorithm or GPU is used.
async fn main {
  let args = @env.args()
  guard args.length() == 3 || (args.length() == 4 && args[3] == "--verify") else {
    fail("usage: audit_apic_cooking_device_sources.mbtx REPO CACHE [--verify]")
  }
  let root = args[1]
  let cache = args[2]
  let previous_bytes = @fs.read_file(
    root + "/docs/APIC_MODEL_GPU_SOURCE_EVIDENCE.json",
  ).binary()
  let previous_sha = "6cf83cac12b61d8083c6f1073843723426ac62391f6c0f11b41329118a51aa9c"
  guard digest(previous_bytes) == previous_sha else {
    fail("previous 36-source evidence must remain byte-for-byte frozen")
  }
  guard @json.parse(@utf8.decode(previous_bytes))
    is { "sources": Array(previous), .. } else {
    fail("previous pinned model/GPU sources missing")
  }
  let archive_sha = "e87442ab4594d8132b7cf6e38b32aaa6130467b654bee260616e5817041e7045"
  guard digest(
      @fs.read_file(cache + "/apic-audit-mujoco_warp-3.15.0.tar.gz").binary(),
    ) ==
    archive_sha else {
    fail("official MuJoCo-Warp 3.15 source archive SHA differs")
  }
  let sources : Array[Source] = [
    {
      subsystem: "newton-cooking-vs-model-finalization",
      project: "Newton",
      path: "newton/_src/sim/builder.py",
      cached: "moonrobo-apic-source-review-20261023/builder.py",
      sha: "",
      symbols: [
        "def collapse_fixed_joints(", "def add_shape(", "def _finalize_impl(", "m._mesh_keep_alive = mesh_keep_alive",
      ],
    },
    {
      subsystem: "newton-host-mesh-cache-and-hull-boundary",
      project: "Newton",
      path: "newton/_src/geometry/types.py",
      cached: "moonrobo-pinned-newton-geometry-types.py",
      sha: "",
      symbols: [
        "class Mesh:", "def finalize(", "self._finalized_meshes[cache_key] = mesh",
        "def compute_convex_hull(",
      ],
    },
    {
      subsystem: "unported-newton-shape-and-mesh-inertia",
      project: "Newton",
      path: "newton/_src/geometry/inertia.py",
      cached: "moonrobo-cooking-newton-inertia.py",
      sha: "e2719f66e4e44702a7fc9123be599db26d736e81b7e3ff597e9c0369fea23f08",
      symbols: [
        "def compute_inertia_mesh(", "def compute_inertia_shape(", "def verify_and_correct_inertia(",
      ],
    },
    {
      subsystem: "schema-resolution-authored-default-and-first-use",
      project: "Newton",
      path: "newton/_src/usd/schema_resolver.py",
      cached: "moonrobo-pinned-schema-resolver.py",
      sha: "4c03ab8e8ab11691c2f3f253b0a771a18fe18e843a9dd12699c15437a3056b6c",
      symbols: [
        "class SchemaResolverManager:", "def _collect_on_first_use(", "def get_value_with_resolver(",
      ],
    },
    {
      subsystem: "builtin-newton-physx-mjc-mappings",
      project: "Newton",
      path: "newton/_src/usd/schemas.py",
      cached: "moonrobo-pinned-schemas.py",
      sha: "5673c092c7097323983caee1447a873d05356e9407294860b46c71d9d3ef28b0",
      symbols: [
        "def _physx_gap_from_prim(", "class SchemaResolverNewton(", "class SchemaResolverPhysx(",
        "def solref_to_stiffness_damping(", "class SchemaResolverMjc(",
      ],
    },
    {
      subsystem: "public-equality-helper-and-zero-quaternion-sentinel",
      project: "Newton",
      path: "newton/_src/solvers/mujoco/equality.py",
      cached: "moonrobo-pinned-equality.py",
      sha: "51a960d97d2019ba7fc1d64567d23bdc76bd77efdfa15d806bce8dec7de48dc3",
      symbols: [
        "def _register_equality_constraint_attributes(", "def _add_equality_constraint(",
        "def add_equality_connect(", "def add_equality_weld(", "def add_equality_joint(",
        "MuJoCo's zero-quaternion sentinel",
      ],
    },
    {
      subsystem: "newton-mujoco-equality-enums",
      project: "Newton",
      path: "newton/_src/solvers/mujoco/enums.py",
      cached: "moonrobo-pinned-mujoco-enums.py",
      sha: "4b5fa81a30fff67865070e13be4de7826561e72499d46737162dbdd8318585ed",
      symbols: ["class EqType("],
    },
    {
      subsystem: "usd-equality-before-collapse-and-mimic-remapping-boundary",
      project: "Newton",
      path: "newton/_src/utils/import_usd.py",
      cached: "apic-audit-newton-import_usd.py",
      sha: "",
      symbols: [
        "def parse_usd(", "def _resolve_newton_mimic(", "def _parse_mjc_equality_constraints(",
        "collapse_results = builder.collapse_fixed_joints",
      ],
    },
    {
      subsystem: "equality-to-mjspec-and-live-newton-model-boundary",
      project: "Newton",
      path: "newton/_src/solvers/mujoco/solver_mujoco.py",
      cached: "apic-audit-solver_mujoco.py",
      sha: "",
      symbols: ["def _convert_to_mjc(", "equality_constraint", "def step("],
    },
  ]
  for
    (file, sha, symbols, subsystem) in [
      (
        "warp.h",
        "",
        [
          "wp_mesh_create_host(", "wp_mesh_destroy_host(", "wp_mesh_create_device(",
          "wp_is_mathdx_enabled(", "wp_cuda_compile_solver(", "wp_cuda_compile_program(",
          "wp_cuda_graph_insert_while(",
        ],
        "real-c-abi-mesh-mathdx-link-and-device-conditionals",
      ),
      (
        "array.h",
        "",
        ["struct array_t", "inline size_t byte_offset("],
        "genuine-borrowed-array-abi",
      ),
      (
        "bvh.h",
        "749180aee9fae78ed3eec1182ccf5c34a70b7e504ef2a312ad3a826a470b87ad",
        [
          "#define BVH_CONSTRUCTOR_SAH (0)", "#define BVH_CONSTRUCTOR_MEDIAN (1)",
          "#define BVH_CONSTRUCTOR_CUBQL (-1)",
        ],
        "bvh-constructor-values-and-host-subset",
      ),
      (
        "mesh.cpp",
        "8768417acbfe0b8415d744d5aaf2f9ff66490a0c7ea19c7eeb0afe074e768ef2",
        [
          "uint64_t wp_mesh_create_host(", "void wp_mesh_destroy_host(", "void wp_mesh_refit_host(",
        ],
        "actual-host-mesh-bvh-and-borrowed-owner-lifetime",
      ),
      (
        "mesh.cu",
        "a3891a607e280ea2c954e85914524f988a51e11ee08067a8a23ad9501e6521d3",
        ["uint64_t wp_mesh_create_device(", "void wp_mesh_destroy_device("],
        "separate-unported-device-mesh-cooking",
      ),
      (
        "warp.cpp",
        "ba2fe6b785e5681e9cfda0887e1e0eff05d5377ebd872be147c81af0cf377d19",
        [
          "int wp_init(", "cuda_init();", "const char* wp_version(", "int wp_is_mathdx_enabled(",
        ],
        "native-version-vs-init-cuda-side-effect",
      ),
      (
        "warp.cu",
        "f8b9f4cef163b2c24fd45e8ded06d608c99d0392b8f89b45bef2931fa143c709",
        [
          "size_t wp_cuda_compile_program(", "bool wp_cuda_compile_solver(", "nvJitLinkAddData(handle, NVJITLINK_INPUT_LTOIR",
          "nvJitLinkComplete(handle)", "cusolverdxGetUniversalFATBIN(", "bool wp_cuda_graph_insert_while(",
        ],
        "actual-mathdx-generator-jitlink-and-runtime-loop-implementation",
      ),
      (
        "mathdx.cpp",
        "a8737e3144a800c88a6ac40d95d4422b134561524efdcaa8670cd1d8abc4e3a5",
        [
          "#if !WP_ENABLE_CUDA || !WP_ENABLE_MATHDX", "WP_API bool wp_cuda_compile_solver(",
          "return false;",
        ],
        "no-cuda-or-no-mathdx-false-stub",
      ),
      (
        "tile_cholesky.h",
        "",
        [
          "void scalar_cholesky_impl(", "void tile_cholesky_inplace_impl(", "fun_forward(A.data.ptr, info);",
        ],
        "upper-tile-factor-and-opposite-triangle-clear",
      ),
      (
        "tile_solve.h",
        "c0976c1b1072781ec7890ec7074fd964690f54ab8d84832f1f8b2c467112efbf",
        [
          "inline CUDA_CALLABLE void scalar_cholesky_solve(", "TileX& tile_cholesky_solve(",
          "fun_forward(",
        ],
        "real-mathdx-and-scalar-potrs-dispatch",
      ),
      (
        "apic.h",
        "",
        [
          "wp_apic_begin_branch(", "wp_apic_end_branch(", "wp_apic_record_conditional(",
        ],
        "apic-device-loop-branch-recording",
      ),
    ] {
    let path = "warp/native/" + file
    sources.push({
      subsystem,
      project: "Warp",
      path,
      cached: "warp-1.17.0/" + path,
      sha,
      symbols,
    })
  }
  for
    (file, sha, symbols, subsystem, cached) in [
      (
        "types.py",
        "64a233a69e8351d424afbf060688baca27bd90e001398aaba33631989c7b67f8",
        [
          "class Mesh:", "self.id = self.runtime.core.wp_mesh_create_host(", "self.id = self.runtime.core.wp_mesh_create_device(",
        ],
        "python-mesh-host-device-selection-and-owner-contract",
        "moonrobo-pinned-warp-types.py",
      ),
      (
        "build.py",
        "63d84f6814789a95366c9ef155fa2b35b566e53a5dae84ce316d650e16cd5513",
        [
          "def build_lto_solver(", "cusolverdx_arrangement_map", "builder.fatbins[\"cusolverdx\"] = universal_fatbin_code_data",
        ],
        "mathdx-lto-and-universal-fatbin-assembly",
        "warp-1.17.0/warp/_src/build.py",
      ),
      (
        "builtins.py",
        "24f5d991a21d480d43e26db91753528a4c2d9441dd9be9eb1aec380ea4ca6be6",
        [
          "cusolver_function_map =", "cusolver_type_map =", "cusolver_fill_mode_map =",
          "def _tile_cholesky_generic_lto_dispatch_func(", "def _tile_cholesky_solve_generic_lto_dispatch_func(",
        ],
        "mathdx-enums-parameter-declarations-and-tile-layout",
        "warp-1.17.0/warp/_src/builtins.py",
      ),
    ] {
    sources.push({
      subsystem,
      project: "Warp",
      path: "warp/_src/" + file,
      cached,
      sha,
      symbols,
    })
  }
  for
    (file, symbols, subsystem) in [
      (
        "collision_gjk.py",
        [
          "def support(", "def _S1D(", "def _S2D(", "def _S3D(", "def _gjk_support(",
          "def gjk(", "def gjk_phase(", "def epa_phase(", "def multicontact(",
        ],
        "convex-simplex-gjk-shallow-contact-and-remaining-epa-manifold",
      ),
      (
        "collision_convex.py",
        ["def ccd_kernel_builder(", "def convex_narrowphase("],
        "convex-candidate-contact-dispatch-boundary",
      ),
      (
        "collision_core.py",
        ["class Geom:", "def write_contact(", "def contact_material_params("],
        "convex-geometry-contact-and-material-bridge-boundary",
      ),
      (
        "solver.py",
        [
          "def _solve_beta_finalize_tiled(", "def _solve_done(", "def _solver_iteration(",
          "def _solve(", "wp.capture_while(nsolving",
        ],
        "actual-device-convergence-and-dynamic-solver-condition",
      ),
      (
        "types.py",
        ["class OverflowType", "ITERATIONS =", "class ContactType"],
        "solver-overflow-and-contact-enums",
      ),
      (
        "math.py",
        ["def safe_div(", "def normalize_with_norm("],
        "numerical-helper-and-minval-contract",
      ),
      (
        "smooth.py",
        [
          "def _tile_cholesky_factorize_block(", "def _factor_blocks(", "def factor_m(",
          "def _tile_cholesky_solve_block(",
        ],
        "independent-potrf-potrs-vs-full-mixed-physics-boundary",
      ),
      (
        "block_cholesky.py",
        [
          "def create_blocked_cholesky_factorize_solve_func(", "def _create_blocked_cholesky_augmented_factorize_solve_func(",
        ],
        "remaining-hessian-blocked-augmented-closure",
      ),
      (
        "constraint.py",
        ["def make_constraint(", "def _efc_contact_jac_sparse("],
        "remaining-live-constraint-row-and-jacobian-closure",
      ),
    ] {
    let path = "mujoco_warp/_src/" + file
    sources.push({
      subsystem,
      project: "MuJoCo-Warp",
      path,
      cached: "mujoco_warp-3.15.0/" + path,
      sha: "",
      symbols,
    })
  }
  let rows : Array[Json] = []
  for source in sources {
    let expected = if source.sha != "" {
      source.sha
    } else {
      guard previous.find_index(row => {
          row is { "source_path": String(path), .. } && path == source.path
        })
        is Some(index) &&
        previous[index] is { "sha256": String(sha), .. } else {
        fail("source missing from frozen primary evidence: " + source.path)
      }
      sha
    }
    let bytes = @fs.read_file(cache + "/" + source.cached).binary()
    guard digest(bytes) == expected else {
      fail("fixed primary source SHA changed: " + source.path)
    }
    let lines = @utf8.decode(bytes).split("\n").collect()
    let anchors : Array[Json] = []
    for symbol in source.symbols {
      guard lines.find_index(line => line.contains(symbol)) is Some(index) else {
        fail("source symbol missing: " + source.path + ":" + symbol)
      }
      anchors.push({ "symbol": Json(symbol), "line": Json(index + 1) })
    }
    let (pin, url) = match source.project {
      "Newton" =>
        (
          "71eeba16a717d4dcf0b9dd7056a7b6f863054dc3",
          "https://raw.githubusercontent.com/newton-physics/newton/71eeba16a717d4dcf0b9dd7056a7b6f863054dc3/" +
          source.path,
        )
      "Warp" =>
        (
          "v1.17.0",
          "https://raw.githubusercontent.com/NVIDIA/warp/v1.17.0/" + source.path,
        )
      _ =>
        (
          "official PyPI 3.15.0 sdist", "https://files.pythonhosted.org/packages/53/e1/409fb2d422e36496fd01d76f432b9f32969bfadd00ad0a5478735ed6f029/mujoco_warp-3.15.0.tar.gz",
        )
    }
    rows.push({
      "subsystem": Json(source.subsystem),
      "project": Json(source.project),
      "pin": Json(pin),
      "source_path": Json(source.path),
      "cached_relative_path": Json(source.cached),
      "source_url": Json(url),
      "sha256": Json(expected),
      "bytes": Json(bytes.length()),
      "anchors": Json(anchors),
    })
  }
  let report : Json = {
    "format": "moonrobo.apic-cooking-device-source-evidence.v1",
    "scope": "Passive fixed primary-source byte identities and lexical anchors; not an executed physics, compiler, CUDA or complete model-closure attestation",
    "sources": Json(rows),
    "previous_36_source_evidence_sha256": Json(previous_sha),
    "previous_report_modified": false,
    "mujoco_warp_archive_sha256": Json(archive_sha),
    "source_bytes_only": true,
    "child_processes_started": false,
    "upstream_code_executed": false,
    "numerical_algorithms_executed": false,
    "tests_executed": false,
    "sdk_initialized": false,
    "gpu_initialized": false,
    "model_compiled": false,
    "kernel_compiled": false,
    "mathdx_lto_compiled": false,
    "apic_exported": false,
    "full_newton_cooking_closure_verified": false,
    "full_gpu_convex_closure_verified": false,
    "full_device_solver_closure_verified": false,
  }
  let output = root + "/docs/APIC_COOKING_DEVICE_SOURCE_EVIDENCE.json"
  if args.length() == 4 {
    guard @json.parse(@fs.read_file(output).text()) == report else {
      fail(
        "cooking/device evidence differs; inspect fixed sources without refreshing prior report",
      )
    }
  } else {
    @fs.write_file(
      output,
      report.stringify(indent=2) + "\n",
      create_mode=CreateOrTruncate,
    )
  }
  println(
    "Verified " +
    rows.length().to_string() +
    " cooking/device primary source identities; filesystem/text/crypto only",
  )
}
