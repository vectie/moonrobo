///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args() is [_, mode] && ["prepare", "native", "smc"].contains(mode) else {
    fail("prepare/native/smc")
  }
  let out = "output/spark-runtime-20261024/actor-backward-boundaries-20261029-a"
  let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host = "wlc004s@192.168.2.179"
  if mode == "prepare" {
    let code = @fs.read_file(out + "/run_actor_boundary_a.mbtx")
      .text()
      .replace_all(
        old="run_actor_boundary_a.mbtx",
        new="run_actor_boundary_b.mbtx",
      )
      .replace_all(
        old="hotspot-shared-actor-boundary-native-a",
        new="hotspot-shared-actor-boundary-native-b",
      )
    @fs.write_file(
      out + "/run_actor_boundary_b.mbtx",
      code,
      create_mode=CreateNew,
    )
    assert_eq(
      @process.run("scp", [
        "-q",
        "-o",
        "ControlPath=/tmp/moonrobo-operator-179.sock",
        out + "/run_actor_boundary_b.mbtx",
        host + ":" + base + "/run_actor_boundary_b.mbtx",
      ]),
      0,
    )
    return
  }
  let folder = out + "/" + mode + "-b"
  @fs.mkdir(folder)
  let code = @process.run(
    "ssh",
    [
      "-S",
      "/tmp/moonrobo-operator-179.sock",
      host,
      "env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native " +
      base +
      "/run_actor_boundary_b.mbtx -- actor " +
      mode +
      " off 1 actor-boundary-" +
      mode +
      "-b bf16-full",
    ],
    stdout=@process.redirect_to_file(
      folder + "/controller.stdout.log",
      create_mode=CreateNew,
    ),
    stderr=@process.redirect_to_file(
      folder + "/controller.stderr.log",
      create_mode=CreateNew,
    ),
  )
  for
    name in [
      "result.json", "boundaries.json", "completion.json", "training-guard.json",
      "training-docker-final.json", "training.stdout.log", "training.stderr.log",
      "protocol.json", "compilation-snapshot.json", "compilation-audit.json",
    ] {
    ignore(
      @process.run("scp", [
        "-q",
        "-o",
        "ControlPath=/tmp/moonrobo-operator-179.sock",
        host +
        ":/home/wlc004s/moonrobo/runs/hotspot-shared-actor-boundary-" +
        mode +
        "-b/" +
        name,
        folder + "/" + name,
      ]),
    )
  }
  assert_eq(code, 0)
}
