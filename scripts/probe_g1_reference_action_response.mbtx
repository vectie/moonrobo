///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let args = @env.args()
  assert_true(
    args.length() == 4 || args.length() == 5,
    msg="usage: probe_g1_reference_action_response.mbtx REPO LAST_CYCLE_STUDY OUTPUT [CONFIG_JSON]",
  )
  let root = args[1]
  let output = args[3]
  assert_false(@fs.exists(output))
  @fs.mkdir(output + "/provider-sources", recursive=true)
  for
    name in [
      "reference_action_response.py", "reference_learning.py", "reference_actor.py",
      "reference_task.py", "balance_features.py", "cpu_physics.py", "full_body_reference.py",
      "policy.py", "dynamics.py",
    ] {
    @fs.write_file(
      output + "/provider-sources/" + name,
      @fs.read_file(root + "/providers/motion_learning/" + name).binary(),
      create_mode=CreateOrTruncate,
    )
  }
  @fs.write_file(
    output + "/config.json",
    @fs.read_file(
      if args.length() == 5 {
        args[4]
      } else {
        root + "/examples/learning/g1-reference-action-response.json"
      },
    ).binary(),
    create_mode=CreateOrTruncate,
  )
  @fs.write_file(
    output + "/charter.json",
    (
      {
        "config": @json.parse(@fs.read_file(output + "/config.json").text()),
        "source_study": Json(args[2]),
        "physical_execution_allowed": false,
      } : Json).stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  assert_eq(
    @process.run(
      "moon",
      native_command(root, [
        output + "/provider-sources/reference_action_response.py",
        "--source",
        args[2],
        "--scene",
        root + "/target/mujoco_menagerie/unitree_g1/scene_mjx.xml",
        "--output",
        output,
      ]),
      stdout=@process.redirect_to_file(
        output + "/train.log",
        create_mode=CreateOrTruncate,
      ),
      stderr=@process.redirect_to_file(
        output + "/stderr.log",
        create_mode=CreateOrTruncate,
      ),
    ),
    0,
  )
  guard @json.parse(@fs.read_file(output + "/report.json").text())
    is {
      "format": "moonrobo.g1-reference-action-response.v1",
      "conditions": Array(conditions),
      "missing_conditions": Array(missing),
      "physical_records": Array(records),
      "physical_execution_allowed": False,
      ..
    } else {
    fail("action-response study did not complete")
  }
  assert_eq(conditions.length() + missing.length(), 36)
  assert_eq(records.length(), conditions.length() * 9)
  println(
    "Measured \{conditions.length()} physical states; \{missing.length()} unavailable; \{records.length()} baseline/branch records.",
  )
}

///|
fn native_command(root : String, original : Array[String]) -> Array[String] {
  let command = [
    "-C", root, "run", "--quiet", "--warn-list", "-a", "--target", "native", "cmd/reference_scripts",
    "--", root,
  ]
  command.append(original)
  command
}
