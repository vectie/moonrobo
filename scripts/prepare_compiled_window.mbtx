///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
}

///|
async fn main {
  let dir = "output/spark-runtime-20261024/compiled-mlp-20261028-a"
  let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let export_runner = @fs.read_file(dir + "/run_compiled_export_b.mbtx")
    .text()
    .replace_all(
      old="run_compiled_export_b.mbtx",
      new="run_compiled_window_export_a.mbtx",
    )
    .replace_all(
      old="export_compiled_mlp_a.py",
      new="export_compiled_world_a.py",
    )
  @fs.write_file(
    dir + "/run_compiled_window_export_a.mbtx",
    export_runner,
    create_mode=CreateNew,
  )
  let parent = @fs.read_file(dir + "/build_compiled_mlp_a.mbtx").text()
  let prefix = parent[:parent.find("async fn main {").unwrap()].to_owned()
  let compiler_start = parent
    .find("  container(\"aoti-plugin-build-a\"")
    .unwrap()
  let compiler_end = parent.find("  container(\"aoti-native-build-a\"").unwrap()
  let compiler = parent[compiler_start:compiler_end]
    .to_owned()
    .replace_all(old="aoti-plugin-build-a", new="aoti-window-plugin-build-a")
    .replace_all(
      old="moonrobo-compiled-mlp-a",
      new="moonrobo-compiled-window-a",
    )
    .replace_all(
      old="libmoonrobo_compiled_mlp_a.so",
      new="libmoonrobo_compiled_window_a.so",
    )
  let builder = prefix +
    (
      #|async fn main {
      #|  require_idle()
      #|  let ws=base+"/workspace/moonrobo-compiled-window-a"
      #|  guard !@fs.exists(ws) else {fail("fresh compiled window workspace")}
      #|  run("aoti-window-copy-a","cp",["-a","--reflink=auto",base+"/workspace/moonrobo-compiled-world-a",ws])
      #|  run("aoti-window-overlay-a","tar",["-xzf",base+"/compiled-window-overlay-a.tar.gz","-C",ws])
      #|  run("aoti-window-fixture-a","cp",[base+"/compiled_window_fixture_a.mbt",ws+"/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt"])
    ) +
    "\n" +
    compiler +
    (
      #|  container("aoti-window-native-build-a","/toolchain/bin/moon",["test","--build-only","--release","--target","native","-j","2","--frozen","src/learning_aligned_gpu/cmd"],workdir="/workspace/moonrobo-compiled-window-a")
      #|  run("aoti-window-binary-a","cp",[ws+"/_build/native/release/test/vectie/moonrobo/src/learning_aligned_gpu/cmd/cmd.whitebox_test.exe",base+"/compiled-window-gate-a"])
      #|}
    )
  @fs.write_file(
    dir + "/build_compiled_window_a.mbtx",
    builder,
    create_mode=CreateNew,
  )
  let fixture = @fs.read_file(dir + "/compiled_world_fixture_a.mbt")
    .text()
    .replace_all(
      old="learner.world.compiled_fitting_mlp=Some(backend.load_compiled_block(path,cuda_device=0))",
      new="learner.world.compiled_fitting_window=Some((backend.load_compiled_block(path+\"/rollout\",cuda_device=0),backend.load_compiled_block(path+\"/error\",cuda_device=0)))",
    )
  @fs.write_file(
    dir + "/compiled_window_fixture_a.mbt",
    fixture,
    create_mode=CreateNew,
  )
  let runner = @fs.read_file(dir + "/run_compiled_world_c.mbtx")
    .text()
    .replace_all(
      old="run_compiled_world_c.mbtx",
      new="run_compiled_window_a.mbtx",
    )
    .replace_all(old="compiled-world-gate-a", new="compiled-window-gate-a")
    .replace_all(
      old="libmoonrobo_compiled_mlp_a.so",
      new="libmoonrobo_compiled_window_a.so",
    )
    .replace_all(
      old="/workspace/moonrobo/runs/hotspot-mlp-aoti-export-\"+amp+(if amp==\"none\" {\"-c\"}else{\"-b\"})",
      new="/workspace/moonrobo/runs/hotspot-mlp-aoti-window-export-\"+amp+\"-a\"",
    )
    .replace_all(
      old="hotspot-shared-aoti-world-native-",
      new="hotspot-shared-aoti-window-native-",
    )
    .replace_all(
      old="  let pack=\"/home/wlc004s/moonrobo/runs/hotspot-mlp-aoti-export-\"+amp+(if amp==\"none\" {\"-c\"}else{\"-b\"})",
      new="  let pack=\"/home/wlc004s/moonrobo/runs/hotspot-mlp-aoti-window-export-\"+amp+\"-a\"",
    )
    .replace_all(
      old="  for name in @fs.readdir(pack) {if name.has_suffix(\".so\") || name.has_suffix(\".cubin\") || name==\"native.spec\" {pins[pack+\"/\"+name]=Json(hash_file(pack+\"/\"+name))}}",
      new="  for kind in [\"rollout\",\"error\"] {for name in @fs.readdir(pack+\"/\"+kind) {if name.has_suffix(\".so\") || name.has_suffix(\".cubin\") || name==\"native.spec\" {pins[pack+\"/\"+kind+\"/\"+name]=Json(hash_file(pack+\"/\"+kind+\"/\"+name))}}}",
    )
  @fs.write_file(
    dir + "/run_compiled_window_a.mbtx",
    runner,
    create_mode=CreateNew,
  )
  assert_eq(
    @process.run("tar", [
      "--disable-copyfile",
      "-czf",
      dir + "/compiled-window-overlay-a.tar.gz",
      "src/learning_tensor/compiled_block.inc",
      "src/learning_aligned_gpu/networks.mbt",
      "src/learning_aligned_gpu/learning.mbt",
      "src/learning_aligned_gpu/compiled_world.mbt",
      "src/learning_aligned_gpu/moon.pkg",
    ]),
    0,
  )
  for
    name in [
      "run_compiled_window_export_a.mbtx", "build_compiled_window_a.mbtx", "compiled_window_fixture_a.mbt",
      "run_compiled_window_a.mbtx", "compiled-window-overlay-a.tar.gz",
    ] {
    assert_eq(
      @process.run("scp", [
        "-q",
        "-o",
        "ControlPath=/tmp/moonrobo-operator-179.sock",
        dir + "/" + name,
        "wlc004s@192.168.2.179:" + base + "/" + name,
      ]),
      0,
    )
  }
  assert_eq(
    @process.run("scp", [
      "-q",
      "-o",
      "ControlPath=/tmp/moonrobo-operator-179.sock",
      "providers/motion_learning/export_compiled_world.py",
      "wlc004s@192.168.2.179:" + base + "/export_compiled_world_a.py",
    ]),
    0,
  )
}
