    #|    for row in files {let hash=field(row,"sha256");assert_eq(Json(hash_file(text(field(row,"source")))),hash);assert_eq(Json(hash_file(text(field(row,"target")))),hash);known[text(field(row,"target"))]=hash}
    #|    for name in ["inductor-cache","triton-cache"] {audit_benchmark_cache(root+"/"+name,known,added)}
