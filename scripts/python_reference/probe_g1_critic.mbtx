///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
}

///|
async fn main {
  let args = @env.args()
  assert_true(
    args.length() == 4 || args.length() == 5,
    msg="usage: probe_g1_critic.mbtx REPO POLICY_DIRECTORY OUTPUT [CONFIG]",
  )
  let root = args[1]
  @fs.mkdir(args[3], recursive=true)
  @fs.write_file(
    args[3] + "/critic_probe.py",
    @fs.read_file(root + "/providers/motion_learning/critic_probe.py").binary(),
    create_mode=CreateOrTruncate,
  )
  let (code, stdout, stderr) = @process.collect_output(
    root + "/target/learning-venv/bin/python",
    [
      root + "/providers/motion_learning/critic_probe.py",
      "--policies",
      args[2],
      "--scene",
      root + "/target/mujoco_menagerie/unitree_g1/scene_mjx.xml",
      "--config",
      if args.length() == 5 {
        args[4]
      } else {
        root + "/examples/learning/g1-critic-probe.json"
      },
      "--experiment",
      root + "/examples/learning/g1-long-experiment.json",
      "--output",
      args[3],
    ],
  )
  @fs.write_file(
    args[3] + "/probe.log",
    stdout.text() + stderr.text(),
    create_mode=CreateOrTruncate,
  )
  assert_eq(code, 0, msg=stderr.text())
  println(stdout.text())
}
