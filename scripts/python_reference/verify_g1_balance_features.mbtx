///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let args = @env.args()
  assert_eq(
    args.length(),
    6,
    msg="usage: verify_g1_balance_features.mbtx REPO INTERVENTION DISTURBANCE_STUDY TEMPORAL_STUDY OUTPUT",
  )
  let root = args[1]
  let output = args[5]
  assert_false(@fs.exists(output), msg="choose a fresh feature study directory")
  @fs.mkdir(output + "/provider-sources", recursive=true)
  for
    name in [
      "balance_features.py", "balance_feature_study.py", "balance_intervention.py",
      "temporal_actor.py", "temporal_training.py", "policy.py", "dynamics.py", "cpu_physics.py",
    ] {
    @fs.write_file(
      output + "/provider-sources/" + name,
      @fs.read_file(root + "/providers/motion_learning/" + name).binary(),
      create_mode=CreateOrTruncate,
    )
  }
  @fs.write_file(
    output + "/provider-sources/teacher_feedback.py",
    @fs.read_file(args[4] + "/provider-sources/teacher_feedback.py").binary(),
    create_mode=CreateOrTruncate,
  )
  for name in ["teacher.json", "experiment.json"] {
    @fs.write_file(
      output + "/" + name,
      @fs.read_file(args[4] + "/" + name).binary(),
      create_mode=CreateOrTruncate,
    )
  }
  let config = @json.parse(
    @fs.read_file(root + "/examples/learning/g1-balance-features.json").text(),
  )
  @fs.write_file(
    output + "/config.json",
    config.stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  @fs.write_file(
    output + "/charter.json",
    (
      {
        "format": "moonrobo.g1-balance-features-charter.v1",
        "config": config,
        "source_intervention": Json(args[2]),
        "incoming_policies": Json(args[3] + "/disturbed/policy"),
        "teacher_study": Json(args[4]),
        "physical_execution_allowed": false,
      } : Json).stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  assert_eq(
    @process.run(
      root + "/target/learning-venv/bin/python",
      [
        output + "/provider-sources/balance_feature_study.py",
        "--config",
        output + "/config.json",
        "--teacher",
        output + "/teacher.json",
        "--intervention",
        args[2],
        "--experiment",
        output + "/experiment.json",
        "--policies",
        args[3] + "/disturbed/policy",
        "--scene",
        root + "/target/mujoco_menagerie/unitree_g1/scene_mjx.xml",
        "--output",
        output,
      ],
      stdout=@process.redirect_to_file(
        output + "/train.log",
        create_mode=CreateOrTruncate,
      ),
      stderr=@process.redirect_to_file(
        output + "/stderr.log",
        create_mode=CreateOrTruncate,
      ),
    ),
    0,
  )
  let report = @json.parse(@fs.read_file(output + "/report.json").text())
  guard report
    is {
      "control": Array(rows),
      "verified_episodes": 90,
      "learned_policy_qualified": false,
      ..
    } else {
    fail("missing feature verification report")
  }
  assert_eq(rows.length(), 9)
  println(
    "Verified observation geometry/velocity and nine fixed-feedback control cells.",
  )
}
