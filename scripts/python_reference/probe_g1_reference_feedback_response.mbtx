///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let args = @env.args()
  assert_eq(
    args.length(),
    4,
    msg="usage: probe_g1_reference_feedback_response.mbtx REPO ACTION_STUDY OUTPUT",
  )
  let root = args[1]
  let output = args[3]
  assert_false(@fs.exists(output))
  @fs.mkdir(output + "/provider-sources", recursive=true)
  for
    name in [
      "reference_feedback_response.py", "reference_action_response.py", "reference_learning.py",
      "reference_actor.py", "reference_task.py", "balance_features.py", "cpu_physics.py",
      "full_body_reference.py", "policy.py", "dynamics.py",
    ] {
    @fs.write_file(
      output + "/provider-sources/" + name,
      @fs.read_file(root + "/providers/motion_learning/" + name).binary(),
      create_mode=CreateOrTruncate,
    )
  }
  @fs.write_file(
    output + "/config.json",
    @fs.read_file(
      root + "/examples/learning/g1-reference-feedback-response.json",
    ).binary(),
    create_mode=CreateOrTruncate,
  )
  @fs.write_file(
    output + "/charter.json",
    (
      {
        "config": @json.parse(@fs.read_file(output + "/config.json").text()),
        "source_study": Json(args[2]),
        "physical_execution_allowed": false,
      } : Json).stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  assert_eq(
    @process.run(
      root + "/target/learning-venv/bin/python",
      [
        output + "/provider-sources/reference_feedback_response.py",
        "--source",
        args[2],
        "--scene",
        root + "/target/mujoco_menagerie/unitree_g1/scene_mjx.xml",
        "--output",
        output,
      ],
      stdout=@process.redirect_to_file(
        output + "/train.log",
        create_mode=CreateOrTruncate,
      ),
      stderr=@process.redirect_to_file(
        output + "/stderr.log",
        create_mode=CreateOrTruncate,
      ),
    ),
    0,
  )
  guard @json.parse(@fs.read_file(output + "/report.json").text())
    is {
      "format": "moonrobo.g1-reference-feedback-response.v1",
      "conditions": Array(conditions),
      "physical_records": Array(records),
      "physical_execution_allowed": False,
      ..
    } else {
    fail("feedback-response study did not complete")
  }
  assert_eq(conditions.length(), 36)
  assert_eq(records.length(), 648)
  println(
    "Completed the crossed control-tape/feedback response at all 36 frozen states.",
  )
}
