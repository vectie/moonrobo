///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn field(value : Json, key : String) -> Json raise {
  guard value is Object(fields) && fields.get(key) is Some(value) else {
    fail("missing field: " + key)
  }
  value
}

///|
fn array(value : Json) -> Array[Json] raise {
  guard value is Array(values) else { fail("expected array") }
  values
}

///|
async fn run(exe : String, args : Array[String]) -> String {
  let (code, stdout, stderr) = @process.collect_output(exe, args)
  assert_eq(code, 0, msg=stderr.text())
  stdout.text()
}

///|
async fn main {
  let args = @env.args()
  assert_eq(
    args.length(),
    3,
    msg="usage: verify_g1_physics.mbtx ABSOLUTE_REPO ABSOLUTE_OUTPUT",
  )
  let root = args[1]
  let output = args[2]
  let python = root + "/target/learning-venv/bin/python"
  let experiment = root + "/examples/learning/g1-cpu-experiment.json"
  let provider = root + "/providers/motion_learning/cpu_physics.py"
  let scene = root + "/target/mujoco_menagerie/unitree_g1/scene_mjx.xml"
  for name in ["first", "repeat"] {
    ignore(
      run(python, [
        provider,
        "--scene",
        scene,
        "--experiment",
        experiment,
        "--output",
        output + "/" + name,
      ]),
    )
  }
  let first = @fs.read_file(output + "/first/dataset.json").text()
  let repeat = @fs.read_file(output + "/repeat/dataset.json").text()
  assert_eq(
    first,
    repeat,
    msg="seeded physics transitions must repeat exactly on this environment",
  )
  let dataset = @json.parse(first)
  let episodes = array(field(dataset, "episodes"))
  assert_eq(episodes.length(), 18)
  assert_eq(array(field(dataset, "state_axes")).length(), 71)
  assert_eq(array(field(dataset, "observation_axes")).length(), 93)
  assert_eq(array(field(dataset, "action_axes")).length(), 29)
  for episode in episodes {
    let steps = array(field(episode, "steps"))
    assert_true(steps.length() > 8)
    for i in 1..<steps.length() {
      assert_eq(field(steps[i - 1], "next_state"), field(steps[i], "state"))
    }
    let last = steps[steps.length() - 1]
    assert_true(
      field(last, "terminated") == true.to_json() ||
      field(last, "truncated") == true.to_json(),
    )
  }
  let report = @json.parse(@fs.read_file(output + "/first/report.json").text())
  assert_eq(field(report, "evidence_class"), "physics-simulation".to_json())
  let trials = array(field(report, "trials"))
  assert_eq(trials.length(), episodes.length())
  for i, trial in trials {
    let steps = array(field(episodes[i], "steps"))
    assert_eq(field(trial, "episode_id"), field(episodes[i], "id"))
    assert_eq(field(trial, "steps"), steps.length().to_json())
    assert_eq(
      field(trial, "failed"),
      field(steps[steps.length() - 1], "terminated"),
    )
  }
  let executable = root +
    "/_build/native/debug/build/cmd/motion_dataset/motion_dataset.exe"
  for split in ["train", "validation", "test"] {
    let batch_text = run(executable, [
      output + "/first/dataset.json",
      split,
      "8",
    ])
    @fs.write_file(
      output + "/" + split + "-batch.json",
      batch_text,
      create_mode=CreateOrTruncate,
    )
    let batch = @json.parse(batch_text)
    let windows = array(field(batch, "windows"))
    assert_true(windows.length() > 0)
    assert_eq(array(field(batch, "state")).length(), windows.length() * 8 * 71)
    assert_eq(
      array(field(batch, "applied_action")).length(),
      windows.length() * 8 * 29,
    )
    assert_eq(array(field(batch, "context")).length(), windows.length() * 2)
    println("\{split}: \{windows.length()} windows accepted by MoonBit reader")
  }
  // Time-limit and physical terminal labels must be independently exercised.
  let config = @json.parse(@fs.read_file(experiment).text())
  guard config is Object(fields) else { fail("expected experiment") }
  fields["duration_s"] = 0.02.to_json()
  fields["controllers"] = ["position"].to_json()
  let short_config = output + "/short.json"
  @fs.write_file(short_config, config.stringify(), create_mode=CreateOrTruncate)
  ignore(
    run(python, [
      provider,
      "--scene",
      scene,
      "--experiment",
      short_config,
      "--output",
      output + "/short",
    ]),
  )
  let short = @json.parse(@fs.read_file(output + "/short/dataset.json").text())
  for episode in array(field(short, "episodes")) {
    let steps = array(field(episode, "steps"))
    assert_eq(steps.length(), 1)
    assert_eq(field(steps[0], "terminated"), false.to_json())
    assert_eq(field(steps[0], "truncated"), true.to_json())
  }
  fields["action_noise_std_rad"] = 0.05.to_json()
  @fs.write_file(short_config, config.stringify(), create_mode=CreateOrTruncate)
  ignore(
    run(python, [
      provider,
      "--scene",
      scene,
      "--experiment",
      short_config,
      "--output",
      output + "/exploration",
    ]),
  )
  let exploration = @json.parse(
    @fs.read_file(output + "/exploration/dataset.json").text(),
  )
  for episode in array(field(exploration, "episodes")) {
    let first = array(field(episode, "steps"))[0]
    assert_true(
      field(first, "applied_action") != field(first, "goal"),
      msg="exploration must log applied noisy controls",
    )
  }
  println(
    "Verified G1 CPU physics: repeated transitions, state continuity, report bindings and truncation labels.",
  )
  println(field(report, "summaries").stringify(indent=2))
}
