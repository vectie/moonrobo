///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let args = @env.args()
  assert_eq(
    args.length(),
    5,
    msg="usage: fit_g1_sustained_balance.mbtx REPO ORIGINAL_BALANCE_STUDY TEACHER_STUDY OUTPUT",
  )
  let root = args[1]
  let output = args[4]
  assert_false(@fs.exists(output))
  @fs.mkdir(output + "/provider-sources", recursive=true)
  for
    name in [
      "sustained_balance.py", "sustained_balance_study.py", "sustained_balance_verify.py",
      "learned_balance.py", "learned_balance_study.py", "balance_features.py", "balance_feature_study.py",
      "balance_intervention.py", "temporal_actor.py", "temporal_training.py", "policy.py",
      "dynamics.py", "cpu_physics.py",
    ] {
    @fs.write_file(
      output + "/provider-sources/" + name,
      @fs.read_file(root + "/providers/motion_learning/" + name).binary(),
      create_mode=CreateOrTruncate,
    )
  }
  @fs.write_file(
    output + "/provider-sources/teacher_feedback.py",
    @fs.read_file(args[3] + "/provider-sources/teacher_feedback.py").binary(),
    create_mode=CreateOrTruncate,
  )
  let config = @json.parse(
    @fs.read_file(root + "/examples/learning/g1-sustained-balance.json").text(),
  )
  @fs.write_file(
    output + "/config.json",
    config.stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  @fs.write_file(
    output + "/charter.json",
    (
      {
        "format": "moonrobo.g1-sustained-balance-charter.v1",
        "config": config,
        "original_balance_study": Json(args[2]),
        "teacher_study": Json(args[3]),
        "physical_execution_allowed": false,
      } : Json).stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  assert_eq(
    @process.run(
      root + "/target/learning-venv/bin/python",
      [
        output + "/provider-sources/sustained_balance_study.py",
        "--config",
        output + "/config.json",
        "--study",
        args[2],
        "--teacher-study",
        args[3],
        "--scene",
        root + "/target/mujoco_menagerie/unitree_g1/scene_mjx.xml",
        "--output",
        output,
      ],
      stdout=@process.redirect_to_file(
        output + "/train.log",
        create_mode=CreateOrTruncate,
      ),
      stderr=@process.redirect_to_file(
        output + "/stderr.log",
        create_mode=CreateOrTruncate,
      ),
    ),
    0,
  )
  guard @json.parse(@fs.read_file(output + "/report.json").text())
    is {
      "format": "moonrobo.g1-sustained-balance-study.v1",
      "selection": Array(selection),
      "final": Array(evaluations),
      "release_qualified": false,
      "physical_execution_allowed": false,
      ..
    } else {
    fail("missing sustained distillation report")
  }
  assert_eq(selection.length(), 15)
  assert_eq(evaluations.length(), 10)
  println(
    "Completed two shared fits, five train-selected variants and separate final physics evaluations.",
  )
}
