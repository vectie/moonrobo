///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let args = @env.args()
  assert_true(
    args.length() == 5 || args.length() == 6,
    msg="usage: fit_g1_reference_initialization.mbtx REPO REFERENCES FEEDBACK_CHECKPOINT OUTPUT [CONFIG_JSON]",
  )
  let root = args[1]
  let output = args[4]
  assert_false(@fs.exists(output))
  @fs.mkdir(output + "/provider-sources", recursive=true)
  for
    name in [
      "reference_actor.py", "reference_initialization.py", "full_body_reference.py",
      "cpu_physics.py", "balance_features.py",
    ] {
    @fs.write_file(
      output + "/provider-sources/" + name,
      @fs.read_file(root + "/providers/motion_learning/" + name).binary(),
      create_mode=CreateOrTruncate,
    )
  }
  for
    (source, name) in [
      (
        if args.length() == 6 {
          args[5]
        } else {
          root + "/examples/learning/g1-reference-initialization.json"
        },
        "config.json",
      ),
      (
        root + "/examples/learning/g1-full-body-reference-quality.json",
        "quality.json",
      ),
    ] {
    @fs.write_file(
      output + "/" + name,
      @fs.read_file(source).binary(),
      create_mode=CreateOrTruncate,
    )
  }
  @fs.write_file(
    output + "/charter.json",
    (
      {
        "format": "moonrobo.g1-reference-initialization-charter.v1",
        "config": @json.parse(@fs.read_file(output + "/config.json").text()),
        "quality": @json.parse(@fs.read_file(output + "/quality.json").text()),
        "references": Json(args[2]),
        "feedback_checkpoint": Json(args[3]),
        "physical_execution_allowed": false,
      } : Json).stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  assert_eq(
    @process.run(
      root + "/target/learning-venv/bin/python",
      [
        output + "/provider-sources/reference_initialization.py",
        "--config",
        output + "/config.json",
        "--quality",
        output + "/quality.json",
        "--references",
        args[2],
        "--feedback",
        args[3],
        "--scene",
        root + "/target/mujoco_menagerie/unitree_g1/scene_mjx.xml",
        "--output",
        output,
      ],
      stdout=@process.redirect_to_file(
        output + "/train.log",
        create_mode=CreateOrTruncate,
      ),
      stderr=@process.redirect_to_file(
        output + "/stderr.log",
        create_mode=CreateOrTruncate,
      ),
    ),
    0,
  )
  guard @json.parse(@fs.read_file(output + "/report.json").text())
    is {
      "format": "moonrobo.g1-reference-initialization.v1",
      "fits": Array(fits),
      "evaluations": Array(evaluations),
      "physical_execution_allowed": false,
      ..
    } else {
    fail("reference initialization did not complete")
  }
  assert_eq(fits.length(), 3)
  assert_eq(evaluations.length(), 3)
  println(
    "Completed three fixed-budget full-reference initializers and their physical coverage checks.",
  )
}
