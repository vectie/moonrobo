///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn field(value : Json, key : String) -> Json raise {
  guard value is Object(fields) && fields.get(key) is Some(value) else {
    fail("missing field: " + key)
  }
  value
}

///|
async fn read(path : String) -> Json {
  @json.parse(@fs.read_file(path).text())
}

///|
async fn run(exe : String, args : Array[String]) -> String {
  let (code, out, err) = @process.collect_output(exe, args)
  assert_eq(code, 0, msg=err.text() + out.text())
  out.text()
}

///|
async fn main {
  let args = @env.args()
  assert_eq(
    args.length(),
    5,
    msg="usage: fit_g1_short_cycle.mbtx REPO DATA_RUN WARM_POLICY OUTPUT",
  )
  let root = args[1]
  let source = args[2]
  let output = args[4]
  assert_true(!@fs.exists(output), msg="choose a fresh study directory")
  @fs.mkdir(output + "/provider-sources", recursive=true)
  for
    name in ["policy.py", "dynamics.py", "cpu_physics.py", "online_dynamics.py"] {
    @fs.write_file(
      output + "/provider-sources/" + name,
      @fs.read_file(root + "/providers/motion_learning/" + name).binary(),
      create_mode=CreateOrTruncate,
    )
  }
  let collection = read(root + "/examples/learning/g1-goal-collection.json")
  guard collection is Object(collection_fields) else {
    fail("expected collection config")
  }
  collection_fields.set("duration_s", 10)
  collection_fields.set("action_noise_std_rad", 0)
  @fs.write_file(
    output + "/collection-experiment.json",
    collection.stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  let configs : Array[Json] = []
  for id in ["cycle-fixed", "cycle-adaptive"] {
    let cell = output + "/" + id
    @fs.mkdir(cell, recursive=true)
    let config = read(root + "/examples/learning/g1-policy-long-fit.json")
    guard config is Object(fields) else { fail("expected policy config") }
    fields.set("test_seeds", [8100, 8101, 8102])
    fields.set("actor_critic_bootstrap", true)
    fields.set("critic_horizontal_translation_invariant", true)
    fields.set("critic_training_source", "physics-returns")
    fields.set(
      "critic_collection_experiment",
      (output + "/collection-experiment.json").to_json(),
    )
    fields.set("critic_collect_seed_base", 1600)
    fields.set("critic_physics_refresh_every", 5)
    fields.set("critic_physics_fit_steps", 40)
    fields.set("critic_physics_minibatch_size", 512)
    fields.set("evaluation_updates", [1, 5, 10, 20])
    fields.set(
      "online_model_updates",
      if id == "cycle-adaptive" {
        (20 : Json)
      } else {
        (0 : Json)
      },
    )
    fields.set("online_model_learning_rate", 0.0003)
    fields.set("online_sampling_seed", 1900)
    fields.set("online_replay_windows", 8192)
    fields.set("online_dynamics_output", (cell + "/fit").to_json())
    fields.set(
      "model_validation_batch",
      (source + "/validation-batch.json").to_json(),
    )
    fields.set("model_test_batch", (source + "/test-batch.json").to_json())
    fields.set(
      "study", "Refresh actual training physics and calibrate critic every five actor updates in both cells. Only adaptive cell fits dynamics: 20 eight-step updates, half initial/half recent windows, frozen normalization. 200 actor and 1600 critic updates per seed; model optimizer adds cost. Actor starts stay in initial replay. No efficiency claim.",
    )
    fields.set(
      "physical_qualification", "All nine fresh ten-second canonical physics trials must have zero falls and mean joint RMSE at most 0.15 rad. Simulation-only, weight-only warm start; no exact restart or hardware authority.",
    )
    @fs.write_file(
      cell + "/config.json",
      config.stringify(indent=2),
      create_mode=CreateOrTruncate,
    )
    configs.push({ "id": id.to_json(), "config": config })
  }
  @fs.write_file(
    output + "/charter.json",
    (
      {
        "format": "moonrobo.g1-short-cycle-charter.v1",
        "cells": configs.to_json(),
        "data_run": source.to_json(),
        "warm_policy": args[3].to_json(),
        "selection": "Validation seeds 30-32 at updates 0/1/5/10/20/50/100/150/200 select actor/critic/model together. Final seeds 8100-8102 and held-out model batches never select weights.",
        "physical_execution_allowed": false,
      } : Json).stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  let cells : Array[Json] = []
  for entry in configs {
    guard field(entry, "id") is String(id) else { fail("missing cell id") }
    let cell = output + "/" + id
    @fs.mkdir(cell + "/collection", recursive=true)
    @fs.mkdir(cell + "/fit", recursive=true)
    ignore(
      run("/bin/cp", [
        source + "/collection/dataset.json",
        cell + "/collection/dataset.json",
      ]),
    )
    if id == "cycle-fixed" {
      for
        name in [
          "report.json", "dynamics-seed-0.pt", "dynamics-seed-1.pt", "dynamics-seed-2.pt",
        ] {
        ignore(run("/bin/cp", [source + "/fit/" + name, cell + "/fit/" + name]))
      }
    }
    @fs.write_file(
      cell + "/policy.log",
      run(root + "/target/learning-venv/bin/python", [
        output + "/provider-sources/policy.py",
        "fit",
        "--train",
        source + "/train-batch.json",
        "--dynamics",
        source + "/fit/dynamics-seed-0.pt",
        "--scene",
        root + "/target/mujoco_menagerie/unitree_g1/scene_mjx.xml",
        "--config",
        cell + "/config.json",
        "--experiment",
        root + "/examples/learning/g1-long-experiment.json",
        "--warm-start-policy",
        args[3],
        "--output",
        cell + "/policy",
      ]),
      create_mode=CreateOrTruncate,
    )
    let report = read(cell + "/policy/report.json")
    guard field(report, "runs") is Array(runs) else { fail("missing runs") }
    let rows : Array[Json] = []
    for result in runs {
      assert_eq(
        field(result, "dynamics_unchanged"),
        (id == "cycle-fixed").to_json(),
      )
      assert_eq(
        field(result, "world_model_frozen_within_actor_updates"),
        true.to_json(),
      )
      assert_eq(field(result, "reload_matches"), true.to_json())
      rows.push({
        "seed": field(result, "seed"),
        "selected_update": field(result, "selected_update"),
        "training_seconds": field(result, "training_seconds"),
        "candidate": field(result, "candidate"),
        "qualifies": field(result, "qualifies"),
        "online_dynamics": field(result, "online_dynamics"),
      })
    }
    cells.push({ "id": id.to_json(), "runs": rows.to_json() })
    println(id + ": " + rows.to_json().stringify())
  }
  @fs.write_file(
    output + "/summary.json",
    (
      {
        "format": "moonrobo.g1-short-cycle-study.v1",
        "cells": cells.to_json(),
        "physical_execution_allowed": false,
      } : Json).stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
}
