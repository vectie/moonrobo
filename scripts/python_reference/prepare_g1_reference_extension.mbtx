///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let args = @env.args()
  assert_eq(
    args.length(),
    3,
    msg="usage: prepare_g1_reference_extension.mbtx REPO OUTPUT_CONFIG",
  )
  let root = args[1]
  assert_false(@fs.exists(args[2]))
  let config = @json.parse(
    @fs.read_file(root + "/examples/learning/g1-reference-state-origin.json").text(),
  )
  guard config is Object(fields) else {
    fail("expected frozen origin-study configuration")
  }
  fields["format"] = "moonrobo.g1-reference-extended-training-charter.v1"
  fields["methods"] = ["replay-prefix", "replay-prefix-extended"]
  fields["cycles"] = 6
  fields["baseline_cycles"] = 3
  fields["reused_baseline_method"] = "replay-prefix"
  fields["collection_origins_per_cycle_s"] = [
    [0, 10, 20],
    [0, 10, 20],
    [0, 10, 20],
    [0, 10, 20],
    [0, 10, 20],
    [0, 10, 20],
  ]
  fields["expected_physical_records"] = 684
  fields["expected_reused_physical_records"] = 360
  fields["expected_new_physical_records"] = 324
  fields["reused_source_report_sha256"] = "c9713dd0cdc6118d83c598a05120fbda15f7e29e946c57387704217d34c95387"
  fields["data_access"] = "Reuse the verified trajectory-state study's initial/common/diagnostic records, all three trajectory training runs and their fixed final evaluations. Reconstruct the first three cycles from original float32 archives with the original optimizer and RNG sequences. Check actor/model/value tensors at every reconstructed cycle against the original checkpoints before collecting new data. Only cycles 4-6 and the extended final evaluations are new physics. Reference-source controls remain commands/setup, never RL fitting labels."
  fields["critic"] = "Keep the original physical-return critic and 128 fitting steps each cycle. Neither actor objective uses its critic; it is reconstructed, fitted and stored without changing the training recipe."
  fields["actor_objective"] = "Continue the existing no-tail H32 discounted-reward objective with uniform current-cycle physical-transition origins, exact causal H10 history/EMA and planned reference phase. Keep the 12 Adam steps/cycle, learning rate and 0.005 local logit RMS cap. Longer surviving episodes receive more origin weight."
  fields["budget_and_selection"] = "Three seeds, six total cycles versus the frozen three-cycle trajectory baseline. Deterministically rebuild cycles 1-3, retaining actor/model/value optimizer moments, replay and RNG by replaying the original fitting operations. Then run exactly three further cycles with 27 fresh episodes, 900 model, 128 value and 12 actor updates per cycle. Evaluate all three final actors on the unchanged 27-cell suite; no intermediate qualification, early stopping, checkpoint/seed selection or threshold changes."
  fields["costs"] = "This intentionally increases training budget, not a matched-efficiency study. Separate 360 inherited records from 324 new records (243 collection +81 final evaluation). Newly incurred CPU time includes reconstruction fitting; original collection timings remain in standalone learner accounting. Do not claim reused physics is new collection or a learning speedup."
  fields["scope"] = "Sustained trajectory-state learning on the same known training references after all three seed means improved at three cycles. Six total cycles is fixed before running; no broad-motion, hardware, exact-restart product or full phase acceptance claim."
  fields["protocol_revision_reason"] = "Test whether the observed trajectory-origin improvement survives three additional unchanged collection/model/actor cycles. The intended intervention is training duration; compare final three-cycle and six-cycle policies without new initialization, supervision or algorithm changes."
  @fs.write_file(
    args[2],
    config.stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  println("Frozen three-versus-six-cycle reference learning charter.")
}
