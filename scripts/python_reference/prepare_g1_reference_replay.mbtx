///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let args = @env.args()
  assert_eq(
    args.length(),
    3,
    msg="usage: prepare_g1_reference_replay.mbtx REPO OUTPUT_CONFIG",
  )
  assert_false(@fs.exists(args[2]))
  let config = @json.parse(
    @fs.read_file(
      args[1] + "/examples/learning/g1-reference-extended-training.json",
    ).text(),
  )
  guard config is Object(fields) else { fail("expected six-cycle charter") }
  fields["format"] = "moonrobo.g1-reference-replay-anchor-charter.v1"
  fields["methods"] = ["replay-prefix-extended", "replay-prefix-anchor"]
  fields["baseline_cycles"] = 6
  fields["reconstruction_cycles"] = 3
  fields["reused_baseline_method"] = "replay-prefix-extended"
  fields["model_initial_anchor_after_cycle"] = 3
  fields["expected_physical_records"] = 927
  fields["expected_reused_physical_records"] = 603
  fields["expected_new_physical_records"] = 324
  fields["reused_source_report_sha256"] = "15fea5c25740ef2d68703301f489502d067dee90bb53c7c27098bbecb2c26200"
  fields["data_access"] = "Reuse the independently verified six-cycle recent-FIFO baseline, its initial/common/diagnostic data and final evaluations. Rebuild only cycles 1-3 from archived physical batches, checking actor/model/value weights against the corresponding baseline checkpoints at every cycle. All later anchor-arm collection and final evaluations are new. No source-control fitting labels or diagnostic-window fitting."
  fields["model_replay"] = "Both arms fit at most 20,000 eight-step windows. Baseline keeps the newest windows. New arm behaves identically for cycles 1-3, then retains every window from its shared first collection as a permanent initial anchor. Remaining capacity keeps the newest windows from collections 2 onward; anchor windows cannot also enter that recent pool. Uniform fitting draws over the combined pool keep original minibatch/update budgets and model normalization. Full first-collection window count varies by seed. No anchor-ratio search, extra model updates, actor-history replay or change to the current-cycle actor-origin pool."
  fields["budget_and_selection"] = "Three seeds and six cycles in both arms, 27 collection episodes/cycle, 900 model/128 value fitting updates and 12 H32 no-tail actor steps/cycle, with the same 0.005 local logit RMS cap. Reuse the complete frozen FIFO results; train only the anchor arm. Reconstruct original first-three-cycle optimizer/replay/RNG state by repeating fitting operations, then intervene only in model replay composition from cycle 4. Evaluate all final actors against the unchanged 27-cell gate with no intermediate quality checks, early stopping, checkpoint or seed selection."
  fields["costs"] = "603 physical records are inherited, 324 new (243 later collection +81 evaluation). New local CPU wall time includes reconstruction fitting. Standalone costs retain original collection timings. Episode/update budgets match but survival can change actual transition counts. This isolates a replay recipe within the MBRL learner; it is not a successful matched model/PPO efficiency result or GPU speedup."
  fields["scope"] = "Controlled model-replay retention comparison after six-cycle training regressed in one seed. Known reference coverage only; no generalization, skill release, hardware or complete phase acceptance claim."
  fields["protocol_revision_reason"] = "Keep the six-cycle recipe fixed and test one response to increasing held-out model error: preserve initial training windows rather than dropping them under recent FIFO. The intervention changes model fitting distribution, not actor-origin sampling, reward, supervision, update budget or qualification limits."
  @fs.write_file(
    args[2],
    config.stringify(indent=2),
    create_mode=CreateOrTruncate,
  )
  println("Frozen six-cycle FIFO versus initial-anchor model replay charter.")
}
