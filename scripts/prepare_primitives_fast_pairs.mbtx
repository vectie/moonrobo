import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/fs", "moonbitlang/async@0.20.2/process", "moonbitlang/core/env" }
fn replace(s : String,a : String,b : String) -> String raise {guard s.contains(a) else {fail(a)};s.replace_all(old=a,new=b)}
async fn run(cmd : String,args : Array[String]) -> Unit {guard @process.run(cmd,args)==0 else {fail(cmd)}}
async fn main {
  let dir="/Users/kq/Workspace/moonrobo/output/spark-runtime-20261024/smc-primitives-20261028"
  let base="/home/wlc004s/moonrobo/private/shared-compute-20261026-a";let host="wlc004s@192.168.2.179";let socket="/tmp/moonrobo-operator-179.sock"
  guard @env.args() is [_,mode] else {fail("prepare|stage")}
  if mode=="prepare" {
    let mut fixture=@fs.read_file(dir+"/primitives_fixture_c.mbt").text()
    fixture=replace(fixture,"  for iteration in 0..<repetitions {",
      #|  let variant = @env.get_env_var("MOONROBO_TOP3_VARIANT").unwrap_or("baseline")
      #|  let abba = variant.has_prefix("abba-")
      #|  guard !abba || (repetitions == 13 && observer == "off") else { fail("ABBA requires thirteen repeats per unprofiled block") }
      #|  let factor = variant.replace_all(old="abba-",new="")
      #|  for iteration in 0..<(if abba { repetitions * 4 } else { repetitions }) {
      #|    let block = if abba { iteration / repetitions } else { 0 }
      #|    let enabled = block == 1 || block == 2
      #|    let learner : @gpu.Learner = if abba {
      #|      let preserve = enabled && (factor == "preserve" || factor == "safe")
      #|      { ..learner,
      #|        optimizations: { ..learner.optimizations,
      #|          native_cross: false,
      #|          native_cross_preserve_forward: preserve,
      #|          world_norm_snapshot: enabled && (factor == "snapshot" || factor == "safe"),
      #|          detached_rotation_constants: enabled && (factor == "constants" || factor == "safe"),
      #|        },
      #|        context: learner.context.with_native_cross(false).with_cross_preserve_forward(preserve),
      #|      }
      #|    } else { learner }
    )
    fixture=replace(fixture,"\"steady\": Json(iteration >= 3),","\"steady\": Json(iteration % repetitions >= 3),\n      \"abba_block\": Json(block),\n      \"abba_candidate\": Json(abba && enabled),\n      \"execution\": Json(learner.optimizations),")
    @fs.write_file(dir+"/primitives_fixture_d.mbt",fixture,create_mode=CreateNew)
    let mut builder=@fs.read_file(dir+"/build_primitives_c.mbtx").text()
    for (a,b) in [("moonrobo-smc-primitives-c","moonrobo-smc-primitives-d"),("smc-primitives-gate-c","smc-primitives-gate-d"),("smc-primitives-tensor-c","smc-primitives-tensor-d"),("smc-primitives-runtime-c","smc-primitives-runtime-d")] {builder=replace(builder,a,b)}
    @fs.write_file(dir+"/build_primitives_d.mbtx",builder,create_mode=CreateNew)
    let mut driver=@fs.read_file(dir+"/run_primitives_c.mbtx").text()
    for (a,b) in [("smc-primitives-gate-c","smc-primitives-gate-d"),("run_primitives_c.mbtx","run_primitives_d.mbtx"),("build_primitives_c.mbtx","build_primitives_d.mbtx"),("primitives_fixture_c.mbt","primitives_fixture_d.mbt"),("\"preserve\", \"safe\"","\"preserve\", \"safe\", \"abba-preserve\", \"abba-snapshot\", \"abba-constants\", \"abba-safe\"")] {driver=replace(driver,a,b)}
    driver=replace(driver,"\"repetitions\": Json(repetitions)","\"repetitions_per_block\": Json(repetitions), \"blocks\": Json(if variant.has_prefix(\"abba-\") { 4 } else { 1 })")
    @fs.write_file(dir+"/run_primitives_d.mbtx",driver,create_mode=CreateNew)
    @fs.write_file(dir+"/invoke_primitives_d.mbtx",replace(@fs.read_file(dir+"/invoke_primitives_c.mbtx").text(),"run_primitives_c.mbtx","run_primitives_d.mbtx"),create_mode=CreateNew)
    return
  }
  guard mode=="stage" else {fail("mode")}
  for file in ["primitives_fixture_d.mbt","build_primitives_d.mbtx","run_primitives_d.mbtx","invoke_primitives_d.mbtx"] {run("scp",["-o","ControlPath="+socket,dir+"/"+file,host+":"+base+"/"+file])}
  run("ssh",["-S",socket,host,"test ! -e "+base+"/workspace/moonrobo-smc-primitives-d"])
  run("ssh",["-S",socket,host,"cp -a --reflink=auto "+base+"/workspace/moonrobo-smc-primitives-c "+base+"/workspace/moonrobo-smc-primitives-d"])
  run("ssh",["-S",socket,host,"cp "+base+"/primitives_fixture_d.mbt "+base+"/workspace/moonrobo-smc-primitives-d/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt"])
  run("ssh",["-S",socket,host,"env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native "+base+"/build_primitives_d.mbtx -- gate-build-smc-primitives-d"])
