import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
}

///|
async fn main {
  let repo = "/Users/kq/Workspace/moonrobo"
  let path = repo +
    "/output/spark-runtime-20261024/world-ln-fk-20261026/retry_followup_world_c.mbtx"
  let additional =
    #|"/home/wlc004s/moonrobo/private/operator-diagnostic-20261025-a/cache-followup-combo-traces-20261026-a.json",
    #|    "/home/wlc004s/moonrobo/private/operator-diagnostic-20261025-a/cache-followup-combo-build-20261026-a.json",
    #|    "/home/wlc004s/moonrobo/private/operator-diagnostic-20261025-a/cache-followup-combo-checkpoints-20261026-a.json",
    #|    "/home/wlc004s/moonrobo/private/operator-diagnostic-20261025-a/cache-followup-combo-private-20261026-a.json",
    #|    "/home/wlc004s/moonrobo/private/operator-diagnostic-20261025-a/cache-followup-smc-cuda-20261026-a.json",
    #|    "/home/wlc004s/moonrobo/private/operator-diagnostic-20261025-a/cache-numeric-followup-20261026-a.json",
    #|    "/home/wlc004s/moonrobo/private/operator-diagnostic-20261025-a/advise_followup_owned_image.mbtx",
  let source = @fs.read_file(repo + "/scripts/retry_followup_world.mbtx")
    .text()
    .replace_all(old="retry-b-", new="retry-c-")
    .replace_all(old="spec-pair-b.json", new="spec-pair-c.json")
    .replace_all(
      old="hotspot-world-packed-abba-20261026-b",
      new="hotspot-world-packed-abba-20261026-c",
    )
    .replace_all(old="world-packed-b-", new="world-packed-c-")
    .replace_all(
      old="retry_followup_world.mbtx",
      new="retry_followup_world_c.mbtx",
    )
    .replace_all(old="for path in [", new="for path in [" + additional)
    .replace_all(
      old="Only verified closed image pages advised.",
      new="Only verified closed task build, checkpoint, diagnostic and private CUDA cache pages advised. Previous groups A and B rejected before training and are excluded.",
    )
    .replace_all(
      old="/home/wlc004s/moonrobo/private/hotspot-smc4096-20261026-a/advise_closed_smc_small_image_pages.mbtx",
      new="/home/wlc004s/moonrobo/private/operator-diagnostic-20261025-a/advise_followup_owned_image.mbtx",
    )
  @fs.write_file(path, source, create_mode=CreateNew)
  guard @process.run("scp", [
      "-o", "ControlPath=/tmp/moonrobo-operator-179.sock", path, "wlc004s@192.168.2.179:/home/wlc004s/moonrobo/private/hotspot-followup-world-20261026-a/retry_followup_world_c.mbtx",
    ]) ==
    0 else {
    fail("copy")
  }
