///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
let dir = "output/spark-runtime-20261024/precision-scaling-20261028-a"

///|
let base = "/home/wlc004s/moonrobo/private/shared-compute-20261026-a"

///|
let host = "wlc004s@192.168.2.179"

///|
let socket = "/tmp/moonrobo-operator-179.sock"

///|
async fn main {
  guard @env.args() is [_, mode] else { fail("main|controls|off") }
  let cases = match mode {
    "main" =>
      [
        ("native", "none"),
        ("compiled", "none"),
        ("compiled", "bf16"),
        ("native", "bf16"),
      ]
    "controls" => [("smc", "bf16"), ("per-linear", "bf16"), ("nocache", "bf16")]
    "off" => [("compiled", "bf16"), ("native", "bf16")]
    _ => fail("mode")
  }
  let observer = if mode == "off" { "off" } else { "events" }
  for (implementation, amp) in cases {
    let label = "pscale-mlp-" +
      implementation +
      "-" +
      amp +
      "-" +
      observer +
      "-b"
    let folder = dir + "/" + label
    guard !@fs.exists(folder) else { fail("fresh output") }
    @fs.mkdir(folder)
    println("START " + label)
    let code = @process.run(
      "ssh",
      [
        "-S",
        socket,
        host,
        "env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native " +
        base +
        "/run_precision_mlp_a.mbtx -- world " +
        implementation +
        " " +
        observer +
        " " +
        label +
        " " +
        amp,
      ],
      stdout=@process.redirect_to_file(
        folder + "/controller.stdout.log",
        create_mode=CreateNew,
      ),
      stderr=@process.redirect_to_file(
        folder + "/controller.stderr.log",
        create_mode=CreateNew,
      ),
    )
    for
      name in [
        "result.json", "protocol.json", "completion.json", "training-guard.json",
        "training-docker-final.json", "training.stdout.log", "training.stderr.log",
      ] {
      assert_eq(
        @process.run("scp", [
          "-q",
          "-o",
          "ControlPath=" + socket,
          host +
          ":/home/wlc004s/moonrobo/runs/hotspot-mlp-" +
          label +
          "/" +
          name,
          folder + "/" + name,
        ]),
        0,
      )
    }
    assert_eq(code, 0)
    guard @json.parse(@fs.read_file(folder + "/training-guard.json").text())
      is { "reason": "completed", "error": Null, .. } else {
      fail("guard")
    }
    guard @json.parse(
        @fs.read_file(folder + "/training-docker-final.json").text(),
      )
      is [
        { "State": { "OOMKilled": False, "Running": False, "Pid": 0, .. }, .. },
      ] else {
      fail("closed container")
    }
    println("DONE " + label)
  }
}
