import { "moonbitlang/async@0.20.2", "moonbitlang/async@0.20.2/fs", "moonbitlang/async@0.20.2/process", "moonbitlang/core/env" }
fn replace(s : String,a : String,b : String) -> String raise {guard s.contains(a) else {fail(a)};s.replace_all(old=a,new=b)}
async fn run(cmd : String,args : Array[String]) -> Unit {guard @process.run(cmd,args)==0 else {fail(cmd)}}
async fn main {
  let repo="/Users/kq/Workspace/moonrobo"
  let out=repo+"/output/spark-runtime-20261024/smc-primitives-20261028"
  let base="/home/wlc004s/moonrobo/private/shared-compute-20261026-a"
  let host="wlc004s@192.168.2.179";let socket="/tmp/moonrobo-operator-179.sock"
  guard @env.args() is [_,mode] else {fail("prepare|stage")}
  if mode=="prepare" {
    let t=@fs.read_file(repo+"/src/learning_tensor/native_cross_test.mbt").text()
    let t=replace(replace(replace(replace(t,"cross3","cross_preserve_expected3"),"native cross strided","forward preserving cross strided"),".has_native_cross()",".has_cross_preserve_forward()"),".native_cross(",".cross_preserve_forward(")
    @fs.write_file(repo+"/src/learning_tensor/cross_preserve_test.mbt",t,create_mode=CreateNew)
    let t=@fs.read_file(repo+"/src/learning_aligned_gpu/geometry/native_cross_test.mbt").text()
    @fs.write_file(repo+"/src/learning_aligned_gpu/geometry/cross_preserve_test.mbt",replace(replace(t,"native cross FK","forward preserving cross FK"),".with_native_cross(",".with_cross_preserve_forward("),create_mode=CreateNew)
    let mut fixture=@fs.read_file(out+"/primitives_fixture_b.mbt").text()
    fixture=replace(fixture,"      reuse_geometry: true,","      native_cross_preserve_forward: @env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"preserve\") || @env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"safe\"),\n      reuse_geometry: true,")
    fixture=fixture.split("\n").map(l=>if l.trim().has_prefix("world_norm_snapshot:") || l.trim().has_prefix("detached_rotation_constants:") {l.replace_all(old="Some(\"both\"),",new="Some(\"both\") || @env.get_env_var(\"MOONROBO_TOP3_VARIANT\") == Some(\"safe\"),")} else {l.to_owned()}).collect().join("\n")
    @fs.write_file(out+"/primitives_fixture_c.mbt",fixture,create_mode=CreateNew)
    let mut builder=@fs.read_file(out+"/build_primitives_b.mbtx").text()
    for (a,b) in [("moonrobo-smc-primitives-b","moonrobo-smc-primitives-c"),("smc-primitives-gate-b","smc-primitives-gate-c"),("smc-primitives-tensor-b","smc-primitives-tensor-c"),("smc-primitives-runtime-b","smc-primitives-runtime-c"),("smc-primitives-tests-b","smc-primitives-tests-c"),("-cpu-b","-cpu-c"),("libmoonrobo_smc_primitives_a.so","libmoonrobo_smc_primitives_c.so"),("smc-primitives-plugin-a","smc-primitives-plugin-c"),("native_cross_test.mbt:0-1","cross_preserve_test.mbt:0-1")] {builder=replace(builder,a,b)}
    @fs.write_file(out+"/build_primitives_c.mbtx",builder,create_mode=CreateNew)
    let mut driver=@fs.read_file(out+"/run_primitives_b.mbtx").text()
    for (a,b) in [("smc-primitives-gate-b","smc-primitives-gate-c"),("run_primitives_b.mbtx","run_primitives_c.mbtx"),("build_primitives_b.mbtx","build_primitives_c.mbtx"),("primitives_fixture_b.mbt","primitives_fixture_c.mbt"),("libmoonrobo_smc_primitives_a.so","libmoonrobo_smc_primitives_c.so"),("\"cross\", \"snapshot\", \"constants\", \"both\"","\"cross\", \"snapshot\", \"constants\", \"both\", \"preserve\", \"safe\"")] {driver=replace(driver,a,b)}
    @fs.write_file(out+"/run_primitives_c.mbtx",driver,create_mode=CreateNew)
    @fs.write_file(out+"/invoke_primitives_c.mbtx",replace(@fs.read_file(out+"/invoke_primitives_b.mbtx").text(),"run_primitives_b.mbtx","run_primitives_c.mbtx"),create_mode=CreateNew)
    return
  }
  guard mode=="stage" else {fail("mode")}
  for file in ["primitives_fixture_c.mbt","build_primitives_c.mbtx","run_primitives_c.mbtx","invoke_primitives_c.mbtx"] {run("scp",["-o","ControlPath="+socket,out+"/"+file,host+":"+base+"/"+file])}
  run("ssh",["-S",socket,host,"test ! -e "+base+"/workspace/moonrobo-smc-primitives-c"])
  run("ssh",["-S",socket,host,"cp -a --reflink=auto "+base+"/workspace/moonrobo-smc-primitives-b "+base+"/workspace/moonrobo-smc-primitives-c"])
  for path in ["execution_optimizations.mbt","learning.mbt","geometry/context.mbt","geometry/cross_preserve_test.mbt","geometry/moon.pkg","cmd/optimizations.mbt","cmd/optimizations_wbtest.mbt"] {run("scp",["-o","ControlPath="+socket,repo+"/src/learning_aligned_gpu/"+path,host+":"+base+"/workspace/moonrobo-smc-primitives-c/src/learning_aligned_gpu/"+path])}
  for path in ["native_cross.inc","native_cross_loader.inc","native_cross.mbt","cross_preserve_test.mbt","moon.pkg"] {run("scp",["-o","ControlPath="+socket,repo+"/src/learning_tensor/"+path,host+":"+base+"/workspace/moonrobo-smc-primitives-c/src/learning_tensor/"+path])}
  run("ssh",["-S",socket,host,"cp "+base+"/primitives_fixture_c.mbt "+base+"/workspace/moonrobo-smc-primitives-c/src/learning_aligned_gpu/cmd/shared_fixture_wbtest.mbt"])
  for mode in ["plugin","gate-build-smc-primitives-c","smc-primitives-tests-c"] {run("ssh",["-S",socket,host,"env PATH=/home/wlc004s/moonrobo/toolchain/bin:/usr/bin:/bin MOON_HOME=/home/wlc004s/moonrobo/toolchain /home/wlc004s/moonrobo/toolchain/bin/moon run --target native "+base+"/build_primitives_c.mbtx -- "+mode])}
}
