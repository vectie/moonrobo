import {
  "vectie/moonrobo/src/learning_linux_memory" @linuxmem,
  "vectie/moonrobo/src/learning_aligned_gpu" @gpu,
  "vectie/moonrobo/src/learning_aligned_gpu/inference",
  "vectie/moonrobo/src/learning_aligned_gpu/geometry",
  "vectie/moonrobo/src/learning_aligned_gpu/runtime" @runner,
  "vectie/moonrobo/src/learning_aligned" @aligned,
  "vectie/moonrobo/src/learning_aligned/physics" @tracking,
  "vectie/moonrobo/src/learning_aligned/gpu_native",
  "vectie/moonrobo/src/learning_aligned/gpu_protocol",
  "vectie/moonrobo/src/learning_tensor" @tensor,
  "vectie/moonrobo/src/learning_physics" @sim,
  "vectie/moonrobo/src/learning_checkpoint_stream" @stream,
  "vectie/moonrobo/src/learning_native_capacity" @capacity,
  "vectie/moonrobo/src/learning_native_admission" @admission,
  "moonbitlang/async/fs",
  "moonbitlang/async",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/crypto",
}

import {
  "vectie/moonrobo/src/learning_numeric" @numeric,
} for "wbtest"

pkgtype(kind: "executable")

options(
  "native-stub": [
    "rendezvous_clock.c",
    "telemetry_host.c",
    "disk_capacity.c",
    "compiled_allocator_stub.c",
  ],
  targets: {
    "main.mbt": [ "native" ],
    "bf16_bundle.mbt": [ "native" ],
    "bf16_bundle_wbtest.mbt": [ "native" ],
    "inference.mbt": [ "native" ],
    "inference_checkpoint.mbt": [ "native" ],
    "inference_wbtest.mbt": [ "native" ],
    "evaluation_environment.mbt": [ "native" ],
    "configuration.mbt": [ "native" ],
    "operator_diagnostics.mbt": [ "native" ],
    "operator_diagnostics_wbtest.mbt": [ "native" ],
    "optimizations.mbt": [ "native" ],
    "optimizations_wbtest.mbt": [ "native" ],
    "hotspot_numeric_wbtest.mbt": [ "native" ],
    "shared_fixture_wbtest.mbt": [ "native" ],
    "mlp_comparison_wbtest.mbt": [ "native" ],
    "compiled_mlp_wbtest.mbt": [ "native" ],
    "capacity_integration_wbtest.mbt": [ "native" ],
    "fp32.mbt": [ "native" ],
    "fp32_wbtest.mbt": [ "native" ],
    "memory.mbt": [ "native" ],
    "motion_sampler_cap.mbt": [ "native" ],
    "motion_sampler_cap_wbtest.mbt": [ "native" ],
    "noise_staging.mbt": [ "native" ],
    "noise_staging_wbtest.mbt": [ "native" ],
    "physics_preflight.mbt": [ "native" ],
    "checkpoint.mbt": [ "native" ],
    "checkpoint_stream.mbt": [ "native" ],
    "checkpoint_stream_wbtest.mbt": [ "native" ],
    "runtime_bridge.mbt": [ "native" ],
    "distributed.mbt": [ "native" ],
    "data_ready.mbt": [ "native" ],
    "data_ready_wbtest.mbt": [ "native" ],
    "preflight_wbtest.mbt": [ "native" ],
    "serial_save_workspace_wbtest.mbt": [ "native" ],
    "telemetry.mbt": [ "native" ],
    "telemetry_host.mbt": [ "native" ],
    "telemetry_wbtest.mbt": [ "native" ],
    "disk_capacity.mbt": [ "native" ],
    "disk_capacity_wbtest.mbt": [ "native" ],
  },
)
