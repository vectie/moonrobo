///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
}

///|
// Pure source-text translation of two literal integer tables, not Python
// evaluation or marching-cubes execution. Refuses any other pinned bytes.
async fn main {
  let args = @env.args()
  guard args.length() == 3 else {
    fail("usage: import_mc_tables.mbtx PINNED_SOURCE OUTPUT")
  }
  let bytes = @fs.read_file(args[1]).binary()
  let digest = @crypto.sha256(bytes).map(b => b.to_hex()).join("")
  guard digest ==
    "a4223c064131b71ec9897a8665f0226da5ad17f51bd67f916d773e3dbedc8d36" else {
    fail("Warp1.17 source SHA differs")
  }
  let lines = @utf8.decode(bytes).split("\n").map(s => s.to_owned())
  let mut output = "// Literal tables translated from NVIDIA Warp v1.17.0 warp/_src/marching_cubes.py.\n// SPDX-FileCopyrightText: Copyright (c) 2025 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\n// SPDX-License-Identifier: Apache-2.0\n// Source SHA256: " +
    digest +
    "\n"
  for
    (source_name, target_name, count) in [
      ("MC_CASE_TO_TRI_RANGE:", "mc_ranges", 257),
      ("MC_TRI_LOCAL_INDICES:", "mc_triangles", 2460),
    ] {
    let mut collecting = false
    let mut done = false
    let mut body = ""
    for line in lines {
      if line.has_prefix(source_name) {
        collecting = true
        continue
      }
      if collecting {
        let text = line.trim().to_owned()
        if text == ")" {
          done = true
          break
        }
        guard text
          .to_array()
          .all(c => (c >= '0' && c <= '9') || c == ',' || c == ' ') else {
          fail("unexpected nonliteral table text")
        }
        body += "  " + text + "\n"
      }
    }
    guard done &&
      body.split(",").filter(s => !s.trim().is_empty()).count() == count else {
      fail("table schema differs")
    }
    output += "\n///|\nfn " +
      target_name +
      "() -> Array[Int] {\n  [\n" +
      body +
      "  ]\n}\n"
  }
  @fs.write_file(args[2], output, create_mode=CreateNew)
}
