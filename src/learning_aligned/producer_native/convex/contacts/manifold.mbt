    #| if(nf1<0||nf1>MR_POLY_MAX||nf2<0||nf2>MR_POLY_MAX){out.failure=7;return out;}if(edge1){out=mr_clip(face2,nf2,face1,nf1,n2[j],wp::neg(n2[j]));for(int k=0;k<out.count;k++){wp::vec3f tmp=out.w1[k];out.w1[k]=out.w2[k];out.w2[k]=tmp;}return out;}if(edge2)return mr_clip(face1,nf1,face2,nf2,n1[j],wp::neg(n1[j]));return mr_clip(face1,nf1,face2,nf2,n1[i],n2[j]);
