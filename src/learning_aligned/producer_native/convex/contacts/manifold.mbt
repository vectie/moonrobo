    #|static __device__ int mr_cylinder_face(mr_geom g,int idx,wp::vec3f* out){float sign=idx!=0?-1.0f:1.0f;wp::vec3f center=wp::add(wp::mul(mr_column(g.rot,2),sign*g.size[1]),g.pos),col0=wp::mul(mr_column(g.rot,0),g.size[0]),col1=wp::mul(mr_column(g.rot,1),g.size[0]*sign);for(int i=0;i<16;i++){double angle=(double(i)*double(3.141592653589793))/double(8.0);float c=float(wp::cos(angle)),s=float(wp::sin(angle));out[i]=wp::add(wp::sub(wp::mul(col0,c),wp::mul(col1,s)),center);}return 16;}
    #|static __device__ int mr_normals(mr_geom g,mr_feature f,wp::vec3f dir,wp::vec3f* n,int* index){if(g.type==6)return mr_box_normals(g,f,dir,n,index);if(g.type==7)return mr_mesh_normals(g,f,n,index);if(g.type==5)return mr_cylinder_normals(g,f,n,index);return 0;}
    #|static __device__ int mr_edges(mr_geom g,mr_feature f,wp::vec3f* n,wp::vec3f* end){if(g.type==6)return mr_box_edges(g,f,n,end);if(g.type==7)return mr_mesh_edges(g,f,n,end);if(g.type==5)return mr_cylinder_edges(g,f,n,end);return 0;}
    #|static __device__ int mr_recover_face(mr_geom g,int idx,wp::vec3f* out){if(g.type==6)return mr_box_face(g,idx,out);if(g.type==7)return mr_mesh_face(g,idx,out);if(g.type==5)return mr_cylinder_face(g,idx,out);return 0;}
    #|static __device__ bool mr_align_faces(wp::vec3f* a,int an,wp::vec3f* b,int bn,int& i,int& j){float tol=float(wp::cos(double(0.0889)));for(int x=0;x<an;x++)for(int y=0;y<bn;y++)if(wp::dot(a[x],b[y])< -tol){i=x;j=y;return true;}return false;}
