    #|static __device__ wp::vec3f mr_column(wp::mat33f r,int i){return wp::vec3f(r.data[0][i],r.data[1][i],r.data[2][i]);}
    #|static __device__ int mr_box_normals2(mr_geom g,wp::vec3f dir,wp::vec3f* normals,int* indices){wp::vec3f local=wp::normalize(wp::mul(wp::transpose(g.rot),dir));float tol=float(wp::cos(double(0.0889)));for(int i=0;i<6;i++){float s=i%2?-1.0f:1.0f;if(local[i/2]*s>tol){normals[0]=wp::mul(mr_column(g.rot,i/2),s);indices[0]=i;return 1;}}return 0;}
