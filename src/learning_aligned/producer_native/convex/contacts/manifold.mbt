    #|}
    #|static __device__ mr_manifold_result mr_multicontact(mr_polytope& p,int face_idx,wp::vec3f x1,wp::vec3f x2,mr_geom a,mr_geom b){
    #| mr_manifold_result out;out.count=1;out.failure=0;for(int i=0;i<4;i++){out.w1[i]=wp::vec3f(0.0f);out.w2[i]=wp::vec3f(0.0f);out.dists[i]=0.0f;}out.w1[0]=x1;out.w2[0]=x2;
