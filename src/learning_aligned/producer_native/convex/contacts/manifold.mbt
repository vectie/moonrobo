    #| if(f.dim==2){for(int axis=0;axis<3;axis++)if(xyz[axis]!=0.0f){normals[c]=wp::mul(mr_column(g.rot,axis),xyz[axis]);indices[c++]=2*axis+(xyz[axis]>0.0f?0:1);}if(c==1||c==2)return c;return mr_box_normals2(g,dir,normals,indices);}
    #| if(f.dim==1){for(int axis=0;axis<3;axis++){normals[axis]=wp::mul(mr_column(g.rot,axis),xyz[axis]);indices[axis]=2*axis+(xyz[axis]>0.0f?0:1);}return 3;}return 0;
