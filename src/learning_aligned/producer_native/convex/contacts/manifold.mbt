    #|struct mr_feature {int dim;wp::vec3i index;wp::vec3f vertex[3];};
    #|static __device__ mr_feature mr_feature_dim(mr_polytope& p,wp::vec3i face,int offset){mr_feature f;for(int i=0;i<3;i++){f.index[i]=wp::index(p.vert_index,2*face[i]+offset);f.vertex[i]=wp::index(p.vert,2*face[i]+offset);}if(f.index[0]!=f.index[1])f.dim=(f.index[2]==f.index[0]||f.index[2]==f.index[1])?2:3;else{f.index[1]=f.index[2];f.vertex[1]=f.vertex[2];f.dim=f.index[0]!=f.index[2]?2:1;}return f;}
    #|static __device__ int mr_intersect1(wp::array_t<int> a,wp::array_t<int> b,int a0,int b0,int an,int bn,wp::vec2i& out){int n=0;for(int i=0;i<an;i++)for(int j=0;j<bn;j++)if(wp::index(a,a0+i)==wp::index(b,b0+j)){out[n++]=wp::index(a,a0+i);if(n==2)return n;}return n;}
