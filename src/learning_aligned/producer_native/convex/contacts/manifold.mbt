    #|static __device__ wp::vec4i mr_polygon_quad(wp::vec3f* p,int n){int b=1,c=2,d=3;wp::vec4i result(0,b,c,d);float m=mr_area4(p[0],p[b],p[c],p[d]);if(!mr_finite(m))return wp::vec4i(-1);for(int a=0;a<n;a++){while(true){float next=mr_area4(p[a],p[b],p[c],p[(d+1)%n]);if(!mr_finite(next))return wp::vec4i(-1);if(next<=m)break;m=next;d=(d+1)%n;result=wp::vec4i(a,b,c,d);while(true){next=mr_area4(p[a],p[b],p[(c+1)%n],p[d]);if(!mr_finite(next))return wp::vec4i(-1);if(next<=m)break;m=next;c=(c+1)%n;result=wp::vec4i(a,b,c,d);}while(true){next=mr_area4(p[a],p[(b+1)%n],p[c],p[d]);if(!mr_finite(next))return wp::vec4i(-1);if(next<=m)break;m=next;b=(b+1)%n;result=wp::vec4i(a,b,c,d);}}if(b==a){b=(b+1)%n;if(c==b){c=(c+1)%n;if(d==c)d=(d+1)%n;}}}return result;}
    #|struct mr_manifold_result {int count,failure;wp::vec3f w1[4],w2[4];float dists[4];};
    #|static __device__ void mr_witness_face(mr_manifold_result& o,int i,wp::vec3f v,wp::vec3f p,wp::vec3f n,wp::vec3f dir){float dist=wp::dot(wp::sub(v,p),n);o.w1[i]=wp::sub(v,wp::mul(dir,wp::abs(dist)));o.w2[i]=v;o.dists[i]=dist;}
