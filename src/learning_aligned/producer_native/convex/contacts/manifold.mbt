    #|static __device__ int mr_mesh_face(mr_geom g,int idx,wp::vec3f* out){int a=wp::index(g.polyvertadr,g.polyadr+idx),n=wp::index(g.polyvertnum,g.polyadr+idx);for(int i=0;i<n;i++)out[i]=wp::add(wp::mul(g.rot,wp::index(g.vert,g.vertadr+wp::index(g.polyvert,a+n-1-i))),g.pos);return n;}
