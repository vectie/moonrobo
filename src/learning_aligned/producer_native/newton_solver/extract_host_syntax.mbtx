///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
}

///|
/// Text-only extraction. No solver package is imported and no lowerer,
/// numeric algorithm, compiler API, CUDA API or tests are called.
fn section(source : String, name : String) -> String raise {
  let lines = source.split("\n").map(s => s.to_owned()).collect()
  let result = []
  let mut active = false
  for line in lines {
    if line.has_prefix("fn " + name + "(") ||
      line.has_prefix("pub fn " + name + "(") {
      active = true
    } else if active && line == "///|" {
      break
    }
    if active {
      result.push(line)
    }
  }
  guard !result.is_empty() else { fail("missing source section " + name) }
  result.join("\n")
}

///|
fn literal_fragments(source : String) -> Array[String] raise {
  let bytes = @utf8.encode(source)
  let result = []
  let mut i = 0
  while i < bytes.length() {
    if bytes[i] != 34 {
      i += 1
      continue
    }
    let start = i
    i += 1
    let mut escaped = false
    while i < bytes.length() {
      let byte = bytes[i]
      if !escaped && byte == 34 {
        break
      }
      if !escaped && byte == 92 {
        escaped = true
      } else {
        escaped = false
      }
      i += 1
    }
    guard i < bytes.length() else { fail("unclosed literal in source probe") }
    let encoded = @utf8.decode(bytes[start:i + 1].to_owned())
      .replace_all(old="\\{r.nv}", new="3")
      .replace_all(old="\\{r.nworld}", new="2")
      .replace_all(old="\\{r.njmax}", new="8")
      .replace_all(old="\\{r.ncon}", new="2")
      .replace_all(old="\\{r.mass_nnz}", new="6")
      .replace_all(old="\\{r.jacobian_capacity}", new="24")
      .replace_all(old="\\{r.ls_iterations}", new="4")
      .replace_all(old="\\{request.nv}", new="3")
      .replace_all(old="\\{request.iterations}", new="4")
    let decoded : String = @json.from_json(@json.parse(encoded)) catch {
      _ => fail("source text literal parse failed: " + encoded)
    }
    result.push(decoded)
    i += 1
  }
  result
}

///|
fn one(parts : Array[String], prefix : String) -> String raise {
  let selected = parts.filter(s => s.has_prefix(prefix))
  guard selected.length() == 1 else {
    fail("syntax extraction marker changed/ambiguous: " + prefix)
  }
  selected[0]
}

///|
fn raw(source : String) -> String {
  source
  .split("\n")
  .filter_map(fn(line) {
    let s = line.trim().to_owned()
    if s.has_prefix("#|") {
      Some(s[2:].to_owned() + "\n")
    } else {
      None
    }
  })
  .collect()
  .join("")
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 3 else {
    fail("usage: extract_host_syntax.mbtx NEWTON_PACKAGE FRESH_CPP")
  }
  guard !@fs.exists(args[2]) else {
    fail("fresh syntax source output required")
  }
  let root = args[1]
  let equations = raw(@fs.read_file(root + "/equations.mbt").text())
  let model = literal_fragments(
    section(@fs.read_file(root + "/model.mbt").text(), "model_source"),
  )
  let kernels = @fs.read_file(root + "/kernels.mbt").text()
  let initialize = literal_fragments(section(kernels, "initialize_body"))
  let gradient = literal_fragments(section(kernels, "gradient_body"))
  let factor = literal_fragments(section(kernels, "factor_body"))
  let blocks = [
    "#include \"builtin.h\"\nusing mr_vec5f=wp::vec_t<5,float>;\nconstexpr int MR_NV=3,MR_LS_ITERATIONS=4;\nstruct MRState{\n",
  ]
  for
    name in [
      "ne", "nf", "nefc", "nacon", "contact_dim", "contact_worldid", "nsolving",
      "solver_niter", "M_rowadr", "M_rownnz", "M_colind", "efc_type", "efc_id", "contact_efc_address",
      "efc_J_rownnz", "efc_J_rowadr", "efc_J_colind", "status", "ls_overflow", "overflow",
      "efc_state",
    ] {
    blocks.push("wp::array_t<wp::int32> " + name + ";\n")
  }
  for
    name in [
      "M_dense_in", "M_csr", "efc_J", "efc_D", "efc_frictionloss", "efc_aref", "qacc_warmstart",
      "qacc_smooth", "qfrc_smooth", "contact_dist", "contact_includemargin", "opt_tolerance",
      "opt_ls_tolerance", "stat_meaninertia", "opt_impratio_invsqrt", "added_metric",
      "preconditioner_dense", "mass_dense", "hessian", "factor", "qacc", "ctx_Ma",
      "qfrc_constraint", "ctx_grad", "ctx_Mgrad", "ctx_search", "ctx_prev_grad",
      "ctx_prev_Mgrad", "ctx_mv", "ctx_Jaref", "efc_force", "ctx_jv", "ctx_grad_dot",
      "ctx_newton_decrement", "ctx_search_dot", "ctx_alpha", "ctx_improvement", "objective_cost",
    ] {
    blocks.push("wp::array_t<float> " + name + ";\n")
  }
  blocks.push(
    "wp::array_t<bool> ctx_done;wp::array_t<bool> ctx_ls_exhausted;wp::array_t<mr_vec5f> contact_friction;};\n",
  )
  blocks.push(equations)
  blocks.push(
    "static float mr_J(const MRState& s,int w,int row,int col){" +
    one(model, "float value=0.0f;int start=") +
    "}\n",
  )
  blocks.push(
    "static float mr_J_dense(const MRState& s,int w,int row,int col){" +
    one(model, "return wp::index(s.efc_J,") +
    "}\n",
  )
  blocks.push(
    "static float mr_mass(const MRState& s,int w,int i,int j){" +
    one(model, "int row=wp::max(i,j)") +
    "}\n",
  )
  blocks.push(
    "static float mr_mass_dense(const MRState& s,int w,int i,int j){" +
    one(model, "return wp::index(s.M_dense_in,") +
    "}\n",
  )
  let validation = [
    one(model, "static __device__ bool mr_validate"),
    one(model, "int prefix=0;for(int i="),
    one(model, "for(int i=0;i<MR_NV;i++)for(int j="),
    one(model, "for(int i=0;i<3;i++){if(!mr_finite"),
    one(model, "float tol=wp::index"),
    one(model, "for(int e=0;e<count;e++)"),
    one(model, "int adr=wp::index(s.efc_J_rowadr,w,e)"),
    one(model, "if(type==7){"),
    one(model, "}\nreturn true;}"),
  ].join("")
  blocks.push(validation)
  // Dense model validation fragments have the same signature/scope; checking
  // them separately prevents unused source-layout branches escaping syntax QA.
  blocks.push(
    "static bool validate_dense_parts(const MRState&s,int w,int e){" +
    one(model, "for(int i=0;i<3;i++)for(int j=") +
    one(model, "for(int c=0;c<3;c++)") +
    "return true;}\n",
  )
  blocks.push(raw(section(kernels, "constraint_source")))
  blocks.push(
    "static void mr_fail(const MRState&s,int w,int bit){wp::index(s.status,w)|=bit;wp::index(s.ctx_alpha,w)=0.0f;}\n",
  )
  let line = @fs.read_file(root + "/line_search.mbt").text()
  blocks.push(raw(section(line, "line_helper_source")))
  let init = [
    one(initialize, "for(int i=0;i<MR_NV;i++){wp::index(s.qacc,w,i)="),
    one(initialize, "wp::index(s.nefc,w)>0?"),
    one(initialize, ";for(int j=0;j<MR_NV;j++)"),
    one(initialize, "if(wp::index(s.status,w))continue;for(int i="),
    one(initialize, "for(int row=0;row<wp::index"),
    one(initialize, "wp::index(s.ctx_grad_dot,w)=0.0f"),
  ].join("")
  blocks.push(
    "static void initialize_probe(MRState s,int w){for(;;){" +
    init +
    "break;}}\n",
  )
  let grad = [
    one(gradient, "int count=wp::index(s.nefc,w)"),
    one(gradient, "float norm=0.0f;for(int i="),
    one(gradient, "wp::index(s.ctx_grad_dot,w)=norm"),
    one(gradient, "for(int i=0;i<MR_NV;i++)for(int j=i;"),
    one(gradient, "for(int row=wp::index(s.ne,w)"),
    one(gradient, "if(!mr_finite(h))"),
  ].join("")
  blocks.push(
    "static void gradient_probe(MRState s,int w){for(;;){" + grad + "break;}}\n",
  )
  let solve = [
    one(factor, "for(int i=0;i<MR_NV;i++){for(int j="),
    "s.hessian",
    one(factor, ",w,i,j);for(int k=0;k<j;"),
    one(factor, "for(int i=0;i<MR_NV;i++){float x="),
    one(factor, "for(int i=MR_NV-1;"),
    one(factor, "float norm=0.0f,dec=0.0f;"),
  ].join("")
  blocks.push(
    "static void factor_probe(MRState s,int w){for(;;){" + solve + "break;}}\n",
  )
  blocks.push(
    "static void line_probe(MRState s,int w){for(;;){" +
    raw(section(line, "line_body")) +
    "break;}}\n",
  )
  let incremental_line = literal_fragments(section(line, "line_body"))
  blocks.push(
    "static void incremental_line_probe(MRState s,int w){for(;;){" +
    raw(section(line, "line_body")) +
    one(incremental_line, "float noise_floor=") +
    "break;}}\n",
  )
  blocks.push(
    "static void cg_init_probe(MRState s,int w){for(;;){" +
    raw(section(kernels, "cg_init_body")) +
    "break;}}\n",
  )
  let entries = literal_fragments(section(kernels, "lower"))
  blocks.push(
    "static void controls_probe(wp::array_t<bool>ctx_done,wp::array_t<int>solver_niter,wp::array_t<int>nsolving,wp::array_t<float>ctx_search_dot,int w){for(;;){" +
    one(entries, "wp::index(ctx_done,w)=false;") +
    "break;}}\n",
  )
  blocks.push(
    "static void unconstrained_probe(wp::array_t<float>qacc_smooth,wp::array_t<float>qacc,wp::array_t<float>qfrc_constraint,wp::array_t<int>solver_niter,wp::array_t<int>status,int w){for(;;){" +
    one(entries, "if(wp::index(status,w))continue;for(int i=") +
    "break;}}\n",
  )
  let result = blocks.join("").replace_all(old="__device__", new="")
  guard !result.contains("\\{") && !result.contains("{r.") else {
    fail("unexpanded source placeholder in syntax probe")
  }
  @fs.write_file(args[2], result, create_mode=CreateNew)
}
