///|
pub suberror SkillError {
  InvalidSkill(String)
  Rejected(String)
} derive(Debug)

///|
pub extend SkillError with @debug.Debug::{to_repr}

///|
pub(all) struct Parameter {
  name : String
  minimum : Double
  maximum : Double
  default_value : Double
} derive(ToJson, FromJson)

///|
pub extend Parameter with ToJson::{to_json}

///|
pub extend Parameter with @json.FromJson::{from_json}

///|
/// A qualified numerical reference, not a free-text behavior generated by an LLM.
pub(all) struct Skill {
  id : String
  description : String
  reference_id : String
  maximum_duration_ms : Int32
  parameters : Array[Parameter]
} derive(ToJson, FromJson)

///|
pub extend Skill with ToJson::{to_json}

///|
pub extend Skill with @json.FromJson::{from_json}

///|
pub(all) struct Catalog {
  catalog_id : String
  context_version : Int64
  last_sequence : Int64
  skills : Array[Skill]
} derive(ToJson, FromJson)

///|
pub extend Catalog with ToJson::{to_json}

///|
pub extend Catalog with @json.FromJson::{from_json}

///|
/// Generated by the LLM; envelope metadata is added by the task coordinator.
pub(all) struct Proposal {
  skill_id : String
  parameters : Map[String, Double]
} derive(ToJson, FromJson, Eq)

///|
pub extend Proposal with Eq::{equal, not_equal}

///|
pub extend Proposal with ToJson::{to_json}

///|
pub extend Proposal with @json.FromJson::{from_json}

///|
/// Expiry uses the MoonRobo host's advertised time domain. context_version
/// identifies a skill/control context, not the continuously changing sensor tick.
pub(all) struct Request {
  request_id : String
  sequence : Int64
  catalog_id : String
  context_version : Int64
  expires_at_ms : Int64
  proposal : Proposal
} derive(ToJson, FromJson, Eq)

///|
pub extend Request with Eq::{equal, not_equal}

///|
pub extend Request with ToJson::{to_json}

///|
pub extend Request with @json.FromJson::{from_json}

///|
pub(all) enum State {
  Accepted
  Running
  Completed
  Failed
  Interrupted
} derive(ToJson, FromJson, Debug)

///|
pub extend State with ToJson::{to_json}

///|
pub extend State with @json.FromJson::{from_json}

///|
pub extend State with @debug.Debug::{to_repr}

///|
pub(all) struct Execution {
  request_id : String
  sequence : Int64
  skill_id : String
  reference_id : String
  parameters : Map[String, Double]
  state : State
  accepted_at_ms : Int64
  deadline_ms : Int64
  detail : String
} derive(ToJson, FromJson)

///|
pub extend Execution with ToJson::{to_json}

///|
pub extend Execution with @json.FromJson::{from_json}
