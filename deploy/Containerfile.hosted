# syntax=docker/dockerfile:1.7
FROM debian:bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gcc libc6-dev git && rm -rf /var/lib/apt/lists/*
ENV PATH="/root/.moon/bin:${PATH}"
RUN curl -fsSL https://cli.moonbitlang.com/install/unix.sh | bash -s 0.1.20260920
WORKDIR /src
COPY . .
RUN moon update && moon build cmd/main --target native --release --warn-list -all

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 1000 -m moonrobo
COPY --from=build /src/_build/native/release/build/cmd/main/main.exe /usr/local/bin/moonrobo
COPY ui/rabbita-cockpit/dist/ /opt/moonrobo/ui/
RUN chmod 0755 /usr/local/bin/moonrobo
USER 1000:1000
EXPOSE 5290
ENTRYPOINT ["/usr/local/bin/moonrobo"]
