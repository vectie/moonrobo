///|
import {
  "moonbitlang/core/env",
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
}

///|
fn required(name : String) -> String raise {
  guard @env.get_env_var(name) is Some(value) && value != "" else {
    fail("missing deployment setting: " + name)
  }
  value
}

///|
async fn main {
  guard @env.args()[1:] is [kind, stage, preflight, directory, handback] &&
    (kind == "shadow" || kind == "live") &&
    (stage == "hold" || stage == "actor-elbows" || stage == "supported-elbow") else {
    fail(
      "usage: shadow|live hold|actor-elbows PREFLIGHT NEW_RUN HANDBACK_OR_DASH",
    )
  }
  guard kind == "shadow" ||
    @env.get_env_var("MOONROBO_E1_REPORTED_EFFORT_SHADOW") != Some("1") else {
    fail("reported-effort hypothesis cannot create live command publishers")
  }
  if @env.get_env_var("MOONROBO_E1_POSITION_HOLD_SHADOW") is Some(_) {
    guard kind == "shadow" && stage == "hold" else {
      fail(
        "position-feedback experiment cannot create live command publishers or actor stages",
      )
    }
  }
  if @env.get_env_var("MOONROBO_E1_POSITION_HOLD_TRIAL") is Some(path) {
    guard stage == "hold" &&
      @env.get_env_var("MOONROBO_E1_POSITION_HOLD_SHADOW") is None &&
      @env.get_env_var("MOONROBO_E1_REPORTED_EFFORT_SHADOW") != Some("1") &&
      @fs.exists(path) &&
      @fs.exists(required("MOONROBO_E1_POSITION_HOLD_SHADOW_AUDIT")) else {
      fail(
        "finite position-hold trial requires separate evidence and hold-only admission",
      )
    }
  }
  let deploy = required("MOONROBO_E1_DEPLOY_DIR")
  if @env.get_env_var("MOONROBO_E1_ACTOR_HOLD_PROFILE") is Some(path) {
    guard stage == "actor-elbows" &&
      @fs.exists(path) &&
      @env.get_env_var("MOONROBO_E1_POSITION_HOLD_TRIAL") is None &&
      @env.get_env_var("MOONROBO_E1_REPORTED_EFFORT_SHADOW") != Some("1") else {
      fail("supported actor feedback requires its explicit actor-only path")
    }
    if kind == "live" {
      guard @fs.exists(required("MOONROBO_E1_ACTOR_HOLD_SHADOW_AUDIT")) else {
        fail("supported actor shadow audit missing")
      }
    }
  }
  guard @env.get_env_var("MOONROBO_E1_SUPPORTED_ELBOW_PROFILE") is None ||
    stage == "supported-elbow" else {
    fail("supported-elbow profile cannot select another stage")
  }
  if stage == "supported-elbow" {
    guard @fs.exists(required("MOONROBO_E1_SUPPORTED_ELBOW_PROFILE")) else {
      fail("supported elbow profile missing")
    }
    if kind == "live" {
      guard @fs.exists(required("MOONROBO_E1_SUPPORTED_ELBOW_SHADOW_AUDIT")) else {
        fail("supported elbow shadow proof missing")
      }
    }
  }
  let coordinator = required("MOONROBO_E1_COORDINATOR")
  let controller = required(
    if stage != "actor-elbows" {
      "MOONROBO_E1_HOLD_CONTROLLER"
    } else {
      "MOONROBO_E1_ACTOR_CONTROLLER"
    },
  )
  let decoder = required("MOONROBO_E1_DECODER_LIBRARY")
  for path in [coordinator, controller, decoder, deploy + "/preflight.py"] {
    guard @fs.exists(path) else { fail("deployment file unavailable: " + path) }
  }
  if stage == "actor-elbows" {
    for
      name in [
        "MOONROBO_E1_ACTOR_CONFIG", "MOONROBO_E1_ACTOR_BUNDLE", "MOONROBO_E1_ACTOR_MODEL",
        "MOONROBO_E1_ACTOR_REFERENCE", "MOONROBO_E1_CANN_LIBRARY",
      ] {
      guard @fs.exists(required(name)) else {
        fail("actor artifact unavailable: " + name)
      }
    }
  }
  // Credential input belongs to sudo's terminal, never an argument or archive.
  guard @process.run("/usr/bin/sudo", ["-v"]) == 0 else {
    fail("capture privilege unavailable")
  }
  let status = @process.run(
    coordinator,
    [
      kind,
      stage,
      preflight,
      directory,
      handback,
      controller,
      decoder,
      @env.get_env_var("MOONROBO_E1_MIRROR_DIR").unwrap_or("-"),
    ],
    cwd=deploy,
  )
  guard status == 0 else { fail("stage stopped; inspect owned run receipts") }
}
